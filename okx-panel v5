  if (pms.value !== priceMode) pms.value = priceMode;

  const errPart = data.scan_errors ? ` · Hata:${data.scan_errors}` : "";
  const scanInfo = data.scanning ? ` · Taranıyor (${data.scan_ok}/${data.scan_total}${errPart})` : (data.last_scan ? ` · Tarama ${data.last_scan} (${data.scan_ok}/${data.scan_total}${errPart})` : "");
  setText(document.getElementById("metaTxt"), `${data.ws_status || "-"}${scanInfo}`);
  const dh = data.data_health || {};
  const mu = data.market_universe || {};
  const universeLabel = mu.using_fallback
    ? `YEDEK LİSTE (${dh.tracked_pairs ?? 0})`
    : `AKTİF SWAP ${mu.eligible ?? dh.tracked_pairs ?? 0}`;
  setText(document.getElementById("dataHealth"),
    `WS: ${dh.ws_connected ? "BAĞLI" : "BAĞLI DEĞİL"} · Evren: ${universeLabel} · Bayat LAST: ${dh.stale_last_prices ?? 0}/${dh.tracked_pairs ?? 0} · WS reconnect: ${dh.ws_reconnects ?? 0}`);

  const sel = data.selected_item;
  const sigs = data.signals || [];

  const curIds = new Set(sigs.map(s => s.id));
  let newestSig = null;
  if (knownSignalIds === null) {
    knownSignalIds = curIds;
  } else {
    sigs.forEach(s => { if (!knownSignalIds.has(s.id) && !newestSig) newestSig = s; });
    knownSignalIds = curIds;
    if (newestSig) {
      selectedPair = newestSig.pair;
      playLoudBell();
    }
  }

  renderPairList();

  if (sel) {
    setText(document.getElementById("chartTitle"), `${sel.pair} · ${currentTf} · ${sel.price_label}`);
    setText(document.getElementById("chartPrice"), fmt(sel.price));
    setText(document.getElementById("chartMeta"), `Gecikme: ${Math.round((sel.age_ms || 0) / 1000)}sn | Kaynak: ${sel.provider}${sel.price_fresh ? "" : " | ⚠ gecikmeli veri"}`);
    setText(document.getElementById("lastVal"), fmt(sel.last_price));
    setText(document.getElementById("markVal"), fmt(sel.mark_price));
    setText(document.getElementById("indexVal"), fmt(sel.index_price));
  }
  renderChart(sel, currentTf, sigs);

  setText(document.getElementById("sigCnt"), String(sigs.length));
  const minScTxt = (data.learning || {}).min_score ?? 80;
  const minGrpTxt = data.min_groups ?? 1;
  renderSignals(sigs, minScTxt, minGrpTxt);
  if (newestSig) flashSignal(newestSig.id);

  renderFaz3(data);
  renderClosedTrades(data.closed_trades);
}

