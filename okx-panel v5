def _group0_bias(candles):
    """Group 0 higher-timeframe direction: EMA200 location plus DI confirmation."""
    if len(candles) < 205:
        return "NEUTRAL"
    closes = [float(c["close"]) for c in candles]
    ema200 = calc_ema(closes, 200)
    adx_res = calc_adx(candles, 14)
    if ema200 is None or adx_res is None:
        return "NEUTRAL"
    _adx, pdi, mdi = adx_res
    px = closes[-1]
    if px > ema200 and pdi > mdi:
        return "BULL"
    if px < ema200 and mdi > pdi:
        return "BEAR"
    return "NEUTRAL"


def _atr_expansion_ratio(candles, period=14, baseline=40):
    """ATR14 / onceki ATR14 degerlerinin ortalamasi; yalnizca mevcut ve eski mumlari kullanir."""
    if len(candles) < period + baseline + 2:
        return None
    trs = []
    for i in range(1, len(candles)):
        h, lo, pc = float(candles[i]["high"]), float(candles[i]["low"]), float(candles[i-1]["close"])
        trs.append(max(h-lo, abs(h-pc), abs(lo-pc)))
    if len(trs) < period + baseline:
        return None
    cur = sum(trs[:period]) / float(period)
    vals = [cur]
    for tr in trs[period:]:
        cur = (cur * (period - 1) + tr) / float(period)
        vals.append(cur)
    ref = vals[-baseline-1:-1]
    avg = sum(ref) / len(ref) if ref else 0.0
    return vals[-1] / avg if avg > 0 else None


def _equal_liquidity_ahead(candles, atr, is_long, price, max_distance_atr=2.0):
    """Breakout yonunde yakinda tuketilmemis EQH/EQL havuzu var mi?"""
    seg = candles[-100:]
    highs, lows = find_swings(seg, 2, 2)
    levels = highs if is_long else lows
    tol = max(0.05 * atr, 1e-12)
    for a in range(len(levels) - 1, 0, -1):
        for b in range(a - 1, max(-1, a - 7), -1):
            if abs(levels[a][1] - levels[b][1]) > 0.25 * atr:
                continue
            level = (levels[a][1] + levels[b][1]) / 2.0
            gap = level - price if is_long else price - level
            if tol < gap <= max_distance_atr * atr:
                return True
    return False


def _bos_volume_sequence(candles, bos_idx, atr):
    """V5.1: BOS hacmi ve retest hacmi kalite teyididir; küçük toleranslı."""
    last_idx = len(candles) - 1
    if bos_idx is None or bos_idx >= last_idx - 1:
        return False, None, None
    bos_rvol = _candle_rvol_at(candles, bos_idx, 20)
    entry_rvol = _candle_rvol_at(candles, last_idx, 20)
    pullback = candles[bos_idx + 1:last_idx]
    if not pullback or bos_rvol is None or entry_rvol is None:
        return False, bos_rvol, entry_rvol
    bos_vol = max(float(candles[bos_idx].get("vol", 0.0) or 0.0), 1e-12)
    pull_avg = sum(float(c.get("vol", 0.0) or 0.0) for c in pullback) / len(pullback)
    ok = (bos_rvol >= G2_BOS_MIN_RVOL and pull_avg <= bos_vol * 1.10
          and entry_rvol >= G2_ENTRY_MIN_RVOL)
    return bool(ok), bos_rvol, entry_rvol

def _evaluate_signal_groups(meta, tf, closed_map, live_price, btc_bias, learn, news=None, mode=None, diag=None):
    """V5.1: Grup 0 rejim/yön kapısı; 1-5/7 gevşetilmiş ama yapısal motorlar; 6 confluence."""
    params = (learn or {}).get("_param_overrides", {}) or {}
    prim = closed_map.get(tf) or []
    if len(prim) < 205 or not live_price or live_price <= 0:
        _note(diag, tf, None, "ANA_TF_VERISI_EKSIK", int((prim or [{}])[-1].get("ts", 0)))
        return None

    atr = calc_atr(prim, 14)
    if atr <= 0:
        _note(diag, tf, None, "ATR_VERISI_EKSIK", int(prim[-1].get("ts", 0)))
        return None
    last = prim[-1]
    lts = int(last.get("ts", 0))
    closes = [float(c["close"]) for c in prim]
    e20, e50, e200 = calc_ema(closes, 20), calc_ema(closes, 50), calc_ema(closes, 200)
    adx_res = calc_adx(prim, 14, with_prev=True)
    if None in (e20, e50, e200) or adx_res is None:
        _note(diag, tf, None, "INDIKATOR_VERISI_EKSIK", lts)
        return None
    adx, pdi, mdi, adx_prev = adx_res
    slope20 = _ema_slope_atr(closes, 20, atr, 3)
    atr_ratio = _atr_expansion_ratio(prim, 14, 40)
    if atr_ratio is None:
        _note(diag, tf, None, "ATR_ORANI_VERISI_EKSIK", lts)
        return None

    # ---------------- GRUP 0: REJIM + YON KAPISI ----------------
    high_vol = atr_ratio >= float(params.get("high_vol_ratio", 1.45))
    dead_vol = atr_ratio < float(params.get("dead_vol_ratio", 0.65))
    trend_regime = adx >= 20.0
    sideways_regime = adx < 18.0
    transition_regime = 18.0 <= adx < 20.0
    if high_vol and trend_regime:
        regime = "TREND + YÜKSEK VOLATİLİTE"
    elif high_vol:
        regime = "YÜKSEK VOLATİLİTE"
    elif trend_regime:
        regime = "TREND"
    elif sideways_regime:
        regime = "YATAY"
    else:
        regime = "GEÇİŞ"

    if live_price > e200 and pdi > mdi:
        gate_direction = "LONG"
    elif live_price < e200 and mdi > pdi:
        gate_direction = "SHORT"
    else:
        gate_direction = None

    if dead_vol:
        _note(diag, tf, None, "GRUP0_DUSUK_VOL", lts,
              extra={"atr_ratio": round(atr_ratio, 3), "adx": round(adx, 1), "threshold": 0.65})
        return None

    ctx_tfs = CONTEXT_TFS.get(tf, ())
    ctx_biases = {}
    htf_short_tfs = []
    for ctx_tf in ctx_tfs:
        ctx = closed_map.get(ctx_tf) or []
        if len(ctx) < 205:
            # Ana TF EMA200 motoru korunur; kısa HTF geçmişi tüm sinyali kilitlemez.
            # Bu HTF nötr kabul edilir ve puanlamada aşağıda güven puanı düşürülür.
            ctx_biases[ctx_tf] = "NEUTRAL"
            htf_short_tfs.append(ctx_tf)
        else:
            ctx_biases[ctx_tf] = _group0_bias(ctx)
    prim_bias = _group0_bias(prim)

    c_data = detect_concepts(prim, atr)
    trig = detect_triggers(prim, atr)
    rsi = calc_rsi(closes, 14)
    rv3 = recent_rvol(prim, 3)
    rvol_now = _candle_rvol_at(prim, len(prim) - 1, 20)
    if rsi is None:
        _note(diag, tf, None, "RSI_VERISI_EKSIK", lts)
        return None
    if rv3 is None:
        rv3 = 0.0
    if rvol_now is None:
        rvol_now = 0.0

    news_risk, news_label = news if news is not None else check_news_window()
    min_score = int(params.get("min_score", MIN_SCORE))
    min_score = max(70, min(95, min_score))
    g4_min_rvol = float(params.get("g4_min_rvol", G4_MIN_RVOL))
    g5_min_rvol = float(params.get("g5_min_rvol", G5_MIN_RVOL))
    choch_atr_min = float(params.get("choch_atr_min", G_CHOCH_ATR_MIN))
    g3_min_rvol = float(params.get("g3_min_rvol", G3_MIN_RVOL))
    g3_body_min = float(params.get("g3_body_min_atr", G3_MIN_BODY_ATR))
    high_vol_allowed = high_vol or sideways_regime or transition_regime
    chase_blocked = abs(float(live_price) - float(last["close"])) > MAX_CHASE_ATR * atr
    if chase_blocked:
        _note(diag, tf, None, "KOVALAMA", lts,
              extra={"distance_atr": round(abs(float(live_price)-float(last["close"])) / atr, 3),
                     "max_distance_atr": MAX_CHASE_ATR})

    sh_main, sl_main = find_swings(prim[-160:], 2, 2)
    obstacle_highs = [p for _, p in sh_main]
    obstacle_lows = [p for _, p in sl_main]
    if ctx_tfs:
        htf_seg = (closed_map.get(ctx_tfs[0]) or [])[-160:]
        sh_ctx, sl_ctx = find_swings(htf_seg, 2, 2)
        obstacle_highs += [p for _, p in sh_ctx]
        obstacle_lows += [p for _, p in sl_ctx]

    rng_hi = max(float(c["high"]) for c in prim[-60:])
    rng_lo = min(float(c["low"]) for c in prim[-60:])
    position = (float(live_price) - rng_lo) / max(rng_hi - rng_lo, 1e-12)
    last_idx = len(prim) - 1
    reaction_long = _reaction_candle(prim, last_idx, True)
    reaction_short = _reaction_candle(prim, last_idx, False)
    cs_long = _close_strength_ok(last, True, G3_MIN_CLOSE_STRENGTH)
    cs_short = _close_strength_ok(last, False, G3_MIN_CLOSE_STRENGTH)
    body_atr = abs(float(last["close"]) - float(last["open"])) / max(atr, 1e-12)
    atr_expanding = atr_ratio >= float(params.get("g3_atr_ratio", G_ATR_EXP))
    adx_rising = adx > adx_prev
    slope_min = float(params.get("slope_min", G_SLOPE_MIN))
    ema_long = e20 > e50 and slope20 is not None and slope20 >= slope_min
    ema_short = e20 < e50 and slope20 is not None and slope20 <= -slope_min

    candidates = []
    missing_by_group = {}
    group_status_by_group = {}
    for side in ("LONG", "SHORT"):
        is_long = side == "LONG"
        want = "BULL" if is_long else "BEAR"
        opposite = "BEAR" if is_long else "BULL"
        primary_htf = ctx_biases.get(ctx_tfs[0]) if ctx_tfs else prim_bias
        secondary_opposed = any(v == opposite for k, v in ctx_biases.items() if not ctx_tfs or k != ctx_tfs[0])
        primary_opposed = primary_htf == opposite
        htf_full = bool(ctx_biases) and all(v == want for v in ctx_biases.values())
        htf_primary_aligned = primary_htf == want
        htf_neutral_ok = primary_htf == "NEUTRAL" and not secondary_opposed
        # Ana HTF karşı yöndeyse trend motorunu durdur; nötrse puanla ve devam et.
        htf_ok = (htf_primary_aligned or htf_neutral_ok) and not primary_opposed and not secondary_opposed
        htf_opposed = primary_opposed or secondary_opposed
        if not ctx_tfs:
            htf_primary_aligned = prim_bias == want
            htf_neutral_ok = prim_bias == "NEUTRAL"
            htf_full = prim_bias == want
            htf_opposed = prim_bias == opposite
            htf_ok = htf_primary_aligned or htf_neutral_ok
        trend_aligned = gate_direction == side and htf_ok

        active_zones = _active_zones(_collect_zones(c_data, side), prim, atr, live_price, side)
        first_ob_zones = []
        for z in active_zones:
            if z[0] == "Order Block":
                visits = _zone_prior_visits(prim, z[1], z[2], z[3])
                if visits <= ZONE_MAX_PRIOR_VISITS:
                    first_ob_zones.append(z)
        first_fvg_zones = [z for z in active_zones if z[0] == "FVG"]
        ob_touched = any(
            any((c["low"] <= z[2] + 0.25 * atr and c["close"] >= z[1] - 0.20 * atr) if is_long
                else (c["high"] >= z[1] - 0.25 * atr and c["close"] <= z[2] + 0.20 * atr)
                for c in prim[-5:]) for z in first_ob_zones
        )
        fvg_touched = any(
            any(c["low"] <= z[2] + 0.25 * atr and c["high"] >= z[1] - 0.25 * atr
                for c in prim[-5:]) for z in first_fvg_zones
        )
        impulse_event = _impulse_pullback_reaction(prim, is_long, atr)
        bos_brk = _fresh_bos_level(prim, atr, is_long)
        bos_retest = _bos_retest_reaction(prim, atr, is_long, bos_brk) if bos_brk else None
        bos_now = bool(bos_brk and bos_brk[1] == last_idx)
        volume_sequence, bos_rvol, entry_rvol = (
            _bos_volume_sequence(prim, bos_brk[1], atr) if bos_retest and bos_brk
            else (False, None, rvol_now)
        )
        eq_event = _equal_sweep_event(prim, atr, is_long, min_rvol=g5_min_rvol)
        sweep_confirm = _sweep_reclaim_confirm(prim, atr, is_long)
        choch_event = _strong_choch_event(prim, is_long, choch_atr_min)
        ce_ok = _ce_ok(prim, atr, live_price, is_long)
        pd_ok = position <= 0.55 if is_long else position >= 0.45
        no_eq_ahead = not _equal_liquidity_ahead(prim, atr, is_long, live_price)
        eq_rvol = float(eq_event.get("rvol", 0.0)) if eq_event else 0.0
        sweep_rvol = eq_rvol if eq_event else None
        if sweep_confirm:
            sr = _candle_rvol_at(prim, int(sweep_confirm["sweep_idx"]), 20)
            if sr is not None:
                sweep_rvol = max(sweep_rvol or 0.0, sr)
        current_rvol_ok = rvol_now >= G_MIN_RVOL
        ema_aligned = ema_long if is_long else ema_short
        reaction = reaction_long if is_long else reaction_short
        close_strength = cs_long if is_long else cs_short
        trend_env = adx >= G_MIN_ADX and gate_direction == side
        reversal_env = high_vol_allowed and (gate_direction != side or htf_opposed or prim_bias == opposite)

        # Grup 1: OB retest çekirdeği; impulse yalnız kalite teyididir.
        g1_checks = {
            "EMA20/50+slope": bool(ema_aligned), "Group0 yön": gate_direction == side,
            "HTF uyumu veya nötr": bool(htf_ok), "ADX>=18": adx >= G_MIN_ADX,
            "aktif ilk OB": bool(first_ob_zones), "OB retest": bool(ob_touched),
            "reaction": bool(reaction),
        }
        g1 = all(g1_checks.values())

        # Grup 2: BOS retest + FVG + reaction çekirdek; CE/P-D/hacim sırası puan getirir.
        g2_checks = {
            "EMA20/50+slope": bool(ema_aligned), "Group0 yön": gate_direction == side,
            "HTF uyumu veya nötr": bool(htf_ok), "ADX>=18": adx >= G_MIN_ADX,
            "BOS retest": bool(bos_retest), "FVG retest": bool(fvg_touched),
            "reaction": bool(reaction),
        }
        g2 = all(g2_checks.values())

        # Grup 3: BOS kapanışı çekirdek; momentum onaylarından en az biri yeterli.
        close3 = _close_strength_ok(last, is_long, G3_MIN_CLOSE_STRENGTH)
        g3_checks = {
            "trend yön kapısı": bool(trend_env), "HTF uyumu veya nötr": bool(htf_ok),
            "BOS kapanışı": bool(bos_now), f"RVOL>={g3_min_rvol:.2f}": rvol_now >= g3_min_rvol,
            "ADX yükseliyor veya ATR genişliyor": bool(adx_rising or atr_expanding),
            "gövde>=0.55 ATR": body_atr >= g3_body_min, "kapanış gücü": bool(close3),
        }
        g3 = all(g3_checks.values())

        # Grup 4: sweep + güçlü CHoCH + reversal ortamı; RVOL 1.60 yeterli.
        g4_checks = {
            "yatay/geçiş/yüksek-vol reversal": bool(reversal_env), "EQH/EQL sweep": bool(eq_event),
            "güçlü CHoCH": bool(choch_event), f"sweep RVOL>={g4_min_rvol:.2f}": sweep_rvol is not None and sweep_rvol >= g4_min_rvol,
            "reaction": bool(reaction),
        }
        g4 = all(g4_checks.values())

        # Grup 5: EQ sweep + reclaim + yönlü yapı teyidi.
        g5_checks = {
            "trend yön kapısı": bool(trend_env), "HTF uyumu veya nötr": bool(htf_ok),
            "EQH/EQL sweep": bool(eq_event), "sweep reclaim": bool(sweep_confirm),
            "BOS/CHoCH": bool(bos_brk or choch_event), f"sweep RVOL>={g5_min_rvol:.2f}": eq_rvol >= g5_min_rvol,
            "reaction": bool(reaction),
        }
        g5 = all(g5_checks.values())

        # Grup 6: bağımsız motor değil, eşlik eden confluence.
        ob_fvg_overlap = any(
            _z_overlap(ob, fvg, atr * 0.15)
            for ob in active_zones if ob[0] == "Order Block"
            for fvg in active_zones if fvg[0] == "FVG"
        )
        first_overlap_test = _ob_fvg_first_test(prim, active_zones, is_long)
        g6_layer = bool(gate_direction == side and ob_fvg_overlap and first_overlap_test
                        and reaction and (pd_ok or ce_ok))

        # Grup 7: momentum devamı; RSI ve hacim eşikleri nefes alır.
        rsi_side_ok = (rsi >= 48.0) if is_long else (rsi <= 52.0)
        g7_checks = {
            "trend yön kapısı": bool(trend_env), "HTF uyumu veya nötr": bool(htf_ok),
            "EMA20/50+slope": bool(ema_aligned), "ADX>=18": adx >= G_MIN_ADX,
            "RSI yönü": bool(rsi_side_ok), "RVOL>=0.90": current_rvol_ok,
            "3-5 itki / 2-4 geri çekilme": bool(impulse_event), "reaction": bool(reaction),
        }
        g7 = all(g7_checks.values())

        checks_by_group = {"1": g1_checks, "2": g2_checks, "3": g3_checks,
                           "4": g4_checks, "5": g5_checks, "7": g7_checks}
        ok_by_group = {"1": g1, "2": g2, "3": g3, "4": g4, "5": g5, "7": g7}
        passed = []
        for code in GROUP_SIGNAL_CODES:
            ok = bool(ok_by_group.get(code))
            group_status_by_group[f"{side}:{code}"] = ok
            if ok:
                passed.append(code)
            else:
                failed_checks = [name for name, condition in checks_by_group[code].items() if not condition]
                missing_by_group[f"{side}:{code}"] = failed_checks

        if g6_layer and passed:
            passed.append("6")
        passed.sort(key=lambda code: GROUP_CODES.index(code))
        if not passed or all(c == "6" for c in passed):
            continue
        if chase_blocked:
            _note(diag, tf, side, "KOVALAMA", lts, blocks=["KOVALAMA"], stage="hard")
            continue

        # Stop: yapısal seviye + tanımlı ATR tamponu; min stop uygulandıktan sonra max kontrol.
        best_z = min(active_zones, key=lambda z: abs(float(live_price) - (z[1] + z[2]) / 2.0)) if active_zones else None
        if best_z:
            zone_lo, zone_hi = float(best_z[1]), float(best_z[2])
            zone_fresh = best_z in first_ob_zones or best_z in first_fvg_zones
        else:
            zone_lo = min(float(c["low"]) for c in prim[-5:])
            zone_hi = max(float(c["high"]) for c in prim[-5:])
            zone_fresh = False
        entry = float(live_price)
        stop_buffer = float(params.get("stop_buffer_atr", STOP_BUFFER_ATR)) * atr
        min_stop_dist = float(params.get("min_stop_atr", MIN_STOP_ATR)) * atr
        max_stop_dist = float(params.get("max_stop_atr", MAX_STOP_ATR)) * atr
        if is_long:
            sl_raw = min(zone_lo, min(float(c["low"]) for c in prim[-5:])) - stop_buffer
            structural_risk = entry - sl_raw
        else:
            sl_raw = max(zone_hi, max(float(c["high"]) for c in prim[-5:])) + stop_buffer
            structural_risk = sl_raw - entry
        if structural_risk <= 0:
            _note(diag, tf, side, "STOP_GEÇERSİZ", lts, stage="hard")
            continue
        risk = max(structural_risk, min_stop_dist)
        if risk > max_stop_dist:
            shadow_sl = entry - risk if is_long else entry + risk
            sh = _risk_filter_shadow_candidate(meta, tf, side, entry, shadow_sl, atr, last, "STOP_GENİŞ")
            _note(diag, tf, side, "STOP_GENİŞ", lts, blocks=["STOP_GENİŞ"], cand=sh, stage="setup")
            continue
        sl = entry - risk if is_long else entry + risk
        if sl <= 0:
            continue
        risk_pct = risk / entry * 100.0
        if risk_pct > MAX_STOP_PCT.get(tf, 5.5):
            _note(diag, tf, side, "STOP_YÜZDE", lts, blocks=["STOP_YÜZDE"], stage="hard",
                  extra={"risk_pct": round(risk_pct, 3), "max_pct": MAX_STOP_PCT.get(tf, 5.5)})
            continue

        # ROOM: Grup 2/3 için sıkı yapısal alan, diğer gruplar için taban alan.
        if is_long:
            ahead = [float(p) for p in obstacle_highs if float(p) > entry + 0.05 * atr]
            room_price = min(ahead) if ahead else None
            room_r = (room_price - entry) / risk if room_price is not None else None
        else:
            ahead = [float(p) for p in obstacle_lows if float(p) < entry - 0.05 * atr]
            room_price = max(ahead) if ahead else None
            room_r = (entry - room_price) / risk if room_price is not None else None
        sign = 1.0 if is_long else -1.0
        tp1, tp2, tp3 = (entry + sign * risk * m for m in TP_R)
        tp3_pct = abs(tp3 - entry) / max(entry, 1e-12) * 100.0
        room_pct = (abs(room_price - entry) / entry * 100.0) if room_price is not None else None
        pot_pct = min(room_pct, tp3_pct) if room_pct is not None else None

        strict_room_groups = set(passed) & {"2", "3"}
        base_room_groups = set(passed) - {"2", "3", "6"}
        if strict_room_groups and (room_r is None or room_r < float(params.get("min_room_r", G_MIN_ROOM_R))
                                   or pot_pct is None or pot_pct < float(params.get("min_pot_pct", G_MIN_POT_PCT))):
            for code in list(strict_room_groups):
                passed.remove(code)
                missing_by_group[f"{side}:{code}" ] = missing_by_group.get(f"{side}:{code}", []) + [f"ROOM>={float(params.get('min_room_r', G_MIN_ROOM_R)):.2f}R"]
                group_status_by_group[f"{side}:{code}"] = False
        if base_room_groups and (room_r is None or room_r < float(params.get("base_room_r", G_BASE_ROOM_R))
                                 or pot_pct is None or pot_pct < float(params.get("base_pot_pct", G_BASE_POT_PCT))):
            blocks = ["ALAN(ROOM)"]
        elif strict_room_groups and not any(c in passed for c in ("2", "3")) and not base_room_groups:
            blocks = ["ALAN(ROOM)"]
        else:
            blocks = []
        if not any(c != "6" for c in passed):
            if blocks:
                sh = _risk_filter_shadow_candidate(meta, tf, side, entry, sl, atr, last, "ALAN(ROOM)")
                if sh:
                    sh.update({"room_r": round(room_r, 2) if room_r is not None else None,
                               "pot_pct": round(pot_pct, 2) if pot_pct is not None else None,
                               "room_price": rp(room_price) if room_price is not None else None,
                               "grp_matched": list(passed), "grp_ver": 3})
                _note(diag, tf, side, "SOFT", lts, blocks=blocks, cand=sh, stage="setup")
            continue

        # İşlem maliyeti raporlanır; V5.1'de maliyet/spread sinyal kapısı değildir.
        cost_r = roundtrip_cost_pct(tf) / max(risk_pct, 1e-9)
        strong_reversal = "4" in passed and bool(eq_event and choch_event and sweep_rvol is not None and sweep_rvol >= g4_min_rvol)

        # 100 puan kalite skoru: ana strateji şartları grupta zorunlu, ikincil teyitler puanlanır.
        if htf_full:
            htf_points = 15
        elif htf_primary_aligned:
            htf_points = 13
        elif htf_neutral_ok:
            htf_points = 8
        else:
            htf_points = 4 if "4" in passed else 0
        adx_points = 15 if adx >= 25 else 13 if adx >= 22 else 11 if adx >= 20 else 9 if adx >= 18 else 0
        score_rvol = max(rvol_now, float(sweep_rvol or 0.0))
        rvol_points = 15 if score_rvol >= 1.50 else 13 if score_rvol >= 1.20 else 11 if score_rvol >= 1.00 else 8 if score_rvol >= 0.90 else 3
        if is_long:
            rsi_points = 10 if 48 <= rsi <= 70 else 7 if 44 <= rsi <= 74 else 3
        else:
            rsi_points = 10 if 30 <= rsi <= 52 else 7 if 26 <= rsi <= 56 else 3
        if ema_aligned:
            ema_points = 10 if abs(slope20 or 0.0) >= 0.10 else 8
        else:
            ema_points = 6 if "4" in passed and choch_event else 2
