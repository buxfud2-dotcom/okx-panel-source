function trackPos(s, v) {
  let p = s.side === "LONG" ? (v - s.sl) / (s.tp3 - s.sl) : (s.sl - v) / (s.sl - s.tp3);
  if (!isFinite(p)) p = 0;
  return Math.max(0, Math.min(1, p)) * 100;
}

function buildSigCard(s) {
  const rrl = s.rr_levels || {};
  const sigTime = s.date_time || s.time || "-";
  const abcdCode = s.abcd_code ? ` · Grup ${s.abcd_code}` : "";
  const expText = s.expected_net_r_est === null || s.expected_net_r_est === undefined
    ? "Geçmiş grup beklentisi: örneklem yetersiz"
    : `Tahmini geçmiş net beklenti: ${Number(s.expected_net_r_est).toFixed(3)}R/işlem · en küçük grup örneklemi ${s.expected_net_r_sample ?? 0}`;
  const ticks = [s.entry, s.tp1, s.tp2, s.tp3].map(v => `<i class="tk" style="left:${trackPos(s, v)}%"></i>`).join("");
  return `
    <div class="sig-card" data-id="${esc(s.id)}" data-pair="${esc(s.pair)}">
      <div class="sig-top">
        <div><strong>${esc(s.pair)}</strong> <span class="muted">(${esc(s.tf)}${esc(abcdCode)} · Skor ${s.score}/100)</span></div>
        <span class="side-pill ${s.side === 'LONG' ? 'long' : 'short'}">${s.side}</span>
      </div>
      <div class="time-note">Sinyal Geldi: ${esc(sigTime)} · En Uygun TF: ${esc(s.tf)}</div>
      <div class="live-row"><span class="live-px js-cur">-</span><span class="live-r js-r">-</span></div>
      <div class="track" title="SL → GİRİŞ → TP1 → TP2 → TP3">${ticks}<b class="tk-now js-now" style="left:0%"></b></div>
      <div class="muted js-stage" style="font-size:11px;"></div>
      <div class="muted" style="font-size:11px;">R:R ${rrl.tp1 ?? "-"}/${rrl.tp2 ?? s.rr}/${rrl.tp3 ?? "-"} · Stop mesafesi %${s.risk_pct ?? "-"} · Önerilen katsayı x${s.risk_multiplier ?? 1}</div>
      <div class="muted" style="font-size:10px;">${esc(expText)}</div>
      <div class="muted js-quote-meta" style="font-size:10px;">Sinyal fiyatı LAST · veri yaşı ${s.last_price_age_ms == null ? "?" : Math.round(s.last_price_age_ms / 1000) + " sn"} · ${s.last_price_fresh ? "güncel" : "bayat/bekleniyor"}</div>
      <div class="muted" style="font-size:10px;">Sinyal kontrolünde spread/hacim eşiği kullanılmaz · Grup ${esc((s.grp_matched || []).join("+") || "-")}</div>
      <div class="lv-grid">
        <div class="lv-cell"><span>Giriş</span><strong>${fmt(s.entry)}</strong></div>
        <div class="lv-cell"><span class="js-sl-lbl">Stop Loss</span><strong class="js-sl">${fmt(s.sl)}</strong></div>
        <div class="lv-cell"><span>TP1 (%50)</span><strong>${fmt(s.tp1)}</strong></div>
        <div class="lv-cell"><span>TP2 (%30)</span><strong>${fmt(s.tp2)}</strong></div>
        <div class="lv-cell"><span>TP3 (%20)</span><strong>${fmt(s.tp3)}</strong></div>
        <div class="lv-cell"><span>Alan / Pot.</span><strong>${s.room_r ?? "-"}R · %${s.pot_pct ?? "-"}</strong></div>
      </div>
      <div class="chips">${(s.concepts || []).map(c => `<span class="chip">${esc(c)}</span>`).join("")}</div>
      <div class="ai-note">${esc(s.ai_reason || "")}</div>
      <div class="inv-note">${esc(s.invalidation || "")}</div>
    </div>`;
}

function updateSigCard(el, s) {
  const stage = s.stage || 0;
  const hasFreshCur = s.current_price !== undefined && s.current_price !== null && s.last_price_fresh;
  const cur = hasFreshCur ? s.current_price : null;
  const rNow = hasFreshCur ? (s.r_now || 0) : 0;
  const dist = hasFreshCur ? (s.dist_pct || 0) : 0;
  el.classList.toggle("focused", s.pair === selectedPair);
  el.classList.toggle("late", !!s.late);
  setText(el.querySelector(".js-cur"), hasFreshCur ? fmt(cur) : "LAST fiyatı bekleniyor");
  setText(el.querySelector(".js-r"), hasFreshCur ? `${rNow >= 0 ? "▲ +" : "▼ "}${rNow.toFixed(2)}R · ${dist >= 0 ? "+" : ""}${dist}%` : "Anlık R: veri bekleniyor");
  const now = el.querySelector(".js-now");
  if (now && hasFreshCur) now.style.left = `${trackPos(s, cur)}%`;
  let st = "Giriş bölgesinde · TP1 (%50) bekleniyor";
  if (stage >= 2) st = "TP1+TP2 alındı · Stop TP1'de (kâr kilitli) · TP3 bekleniyor";
  else if (stage) st = "TP1 (%50) alındı · Stop BE seviyesinde · TP2 bekleniyor";
  else if (s.late) st = "Fiyat yarım R uzaklaştı · girişi kovalama";
  setText(el.querySelector(".js-stage"), st);
  setText(el.querySelector(".js-sl-lbl"), stage >= 2 ? "Trail Stop" : (stage ? "BE Stop" : "Stop Loss"));
  setText(el.querySelector(".js-sl"), fmt(s.sl));
  const quoteMeta = el.querySelector(".js-quote-meta");
  if (quoteMeta) {
    const age = s.last_price_age_ms == null ? "?" : `${Math.round(s.last_price_age_ms / 1000)} sn`;
    quoteMeta.textContent = `Sinyal fiyatı ${s.signal_price_source || "LAST (OKX SWAP)"} · veri yaşı ${age} · ${s.last_price_fresh ? "güncel" : "bayat/bekleniyor"}`;
  }
}

let sigListKey = "";
function renderSignals(sigs, minScTxt, minGrpTxt) {
  const list = document.getElementById("sigList");
  const key = sigs.map(s => s.id).join("|");
  if (key !== sigListKey) {
    const st = list.scrollTop;
    sigListKey = key;
    list.innerHTML = sigs.length
      ? sigs.map(buildSigCard).join("")
      : `<div class="sig-card muted" style="cursor:default;">${minScTxt}+ skor; 1H/4H/1D genelinde 1–7 gruplarından tek bir kaliteli kurulum veya birden fazla uyumlu grup aranıyor. Bayat fiyatla sinyal üretilmez.</div>`;
    list.scrollTop = st;
  }
  const cards = list.children;
  sigs.forEach((s, i) => { if (cards[i] && cards[i].dataset && cards[i].dataset.id) updateSigCard(cards[i], s); });
}

