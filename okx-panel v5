def _risk_filter_shadow_candidate(meta, tf, side, entry, sl, atr, last, reason):
    """Yalnız filtre araştırması içindir; canlı sinyal olarak yayınlanmaz."""
    risk = abs(float(entry) - float(sl))
    if risk <= 0 or entry <= 0:
        return None
    is_long = side == "LONG"
    sign = 1.0 if is_long else -1.0
    cost_pct = roundtrip_cost_pct(tf)
    risk_pct = risk / float(entry) * 100.0
    return {
        "id": f"{meta['id']}-{tf}-{last['ts']}-{side}-SHADOW-{reason}",
        "symbol": meta["id"], "pair": meta["pair"], "tf": tf, "side": side,
        "entry": rp(entry), "sl": rp(sl), "sl_orig": rp(sl),
        "tp1": rp(entry + sign * risk * TP_R[0]),
        "tp2": rp(entry + sign * risk * TP_R[1]),
        "tp3": rp(entry + sign * risk * TP_R[2]),
        "rr": TP_R[1], "rr1": TP_R[0], "rr2": TP_R[1],
        "rr_levels": {"tp1": TP_R[0], "tp2": TP_R[1], "tp3": TP_R[2]},
        "risk_pct": round(risk_pct, 3), "cost_r": round(cost_pct / max(risk_pct, 1e-9), 3),
        "room_r": None, "pot_pct": None, "room_price": None, "atr_value": rp(atr),
        "score": 0, "grp_matched": [], "grp_ver": 2, "abcd_groups": {}, "abcd_code": "",
        "concepts": ["Sanal filtre denemesi", str(reason)], "shadow_only": True,
        "shadow_reason": str(reason), "validity_status": "CANLI İŞLEM DEĞİL · SANAL FİLTRE TESTİ",
        "created_ts_ms": now_ms(), "candle_ts": last["ts"],
        "last_processed_candle_ts": last["ts"], "status": "BEKLIYOR", "stage": 0, "pnl_r": 0.0,
        "mode": "shadow-filter",
    }


def _evaluate_signal_classic(meta, tf, closed_map, live_price, btc_bias, learn, news=None, mode=None, diag=None):
    """Tum pariteler BTC'den bagimsiz analiz edilir. btc_bias parametresi geriye donuk uyumluluk icin tutulur."""
    mode = mode or STRATEGY_MODE
    v3 = mode != "legacy"
    # Classic/legacy motorunda Grup 0-7'nin missing_by_group haritasi bulunmaz.
    # Engelleme kaydinda bu alanin kullanilmasi legacy A/B testinde NameError olusturmasin.
    missing_by_group = {}
    prim = closed_map.get(tf) or []
    if len(prim) < 80 or not live_price or live_price <= 0:
        return None
    atr = calc_atr(prim, 14)
    if atr <= 0:
        return None
    last = prim[-1]
    lts = last["ts"]
    regime = detect_regime(prim, atr, live_price)
    if regime == "YÜKSEK VOLATİLİTE":
        _note(diag, tf, None, "REJİM_VOLATİL", lts)
        return None
    classic_chase = LEGACY_MAX_CHASE_ATR if mode == "legacy" else MAX_CHASE_ATR
    if abs(live_price - last["close"]) > classic_chase * atr:
        _note(diag, tf, None, "KOVALAMA", lts)
        return None

    adx_res = calc_adx(prim, 14, with_prev=True)
    if adx_res is None:
        return None
    adx, pdi, mdi, adx_prev = adx_res
    adx_rising = (adx - adx_prev) >= ADX_RISING_MIN_DELTA
    if not v3 and adx < MIN_ADX:
        return None

    ctx_tfs = CONTEXT_TFS[tf]
    for t in ctx_tfs:
        if len(closed_map.get(t) or []) < 60:
            return None
    biases = {t: tf_bias(closed_map[t]) for t in ctx_tfs}
    prim_bias = tf_bias(prim)

    c_data = detect_concepts(prim, atr)
    trig = detect_triggers(prim, atr)
    closes = [c["close"] for c in prim]
    rsi = calc_rsi(closes, 14)
    e20, e50 = calc_ema(closes, 20), calc_ema(closes, 50)
    rv3 = recent_rvol(prim, 3)
    if rsi is None or rv3 is None:
        return None
    if rv3 < MIN_RVOL:
        _note(diag, tf, None, "HACİM", lts)
        return None
    eff_rv3 = rv3

    news_risk, news_label = news if news is not None else check_news_window()
    concept_mults = (learn or {}).get("concept_mults", {}) or {}
    if mode == "legacy":
        min_score = max(LEGACY_MIN_SCORE, int((learn or {}).get("min_score", LEGACY_MIN_SCORE)))
    else:
        min_score = max(MIN_SCORE, int((learn or {}).get("min_score", MIN_SCORE)))

    rng_hi = max(c["high"] for c in prim[-60:])
    rng_lo = min(c["low"] for c in prim[-60:])
    rng_span = max(rng_hi - rng_lo, 1e-12)
    pos = (live_price - rng_lo) / rng_span

    sh_main, sl_main = find_swings(prim[-130:], 4, 4)
    obst_highs = [p for _, p in sh_main]
    obst_lows = [p for _, p in sl_main]
    if ctx_tfs:
        sh_c, sl_c = find_swings(closed_map[ctx_tfs[0]][-130:], 4, 4)
        obst_highs += [p for _, p in sh_c]
        obst_lows += [p for _, p in sl_c]

    best = None
    for side in ("LONG", "SHORT"):
        is_long = side == "LONG"
        want = "BULL" if is_long else "BEAR"
        opp = "BEAR" if is_long else "BULL"

        # --- Ust zaman dilimi yonu ZORUNLU (BTC bagimsiz) ---
        if ctx_tfs:
            if biases[ctx_tfs[0]] != want or any(biases[t] == opp for t in ctx_tfs[1:]):
                _note(diag, tf, side, "ÜST_TF_YÖN", lts)
                continue
            htf_full = all(biases[t] == want for t in ctx_tfs)
        else:
            if prim_bias != want or (e50 and ((is_long and live_price < e50) or ((not is_long) and live_price > e50))):
                _note(diag, tf, side, "ÜST_TF_YÖN", lts)
                continue
            htf_full = True

        # --- ICT tetikleyici ZORUNLU ---
        ict_items = []
        if is_long:
            if trig["choch_bull"]:
                ict_items.append(("ICT · CHoCH", 3))
            if trig["bos_bull"]:
                ict_items.append(("ICT · BOS", 2))
            if trig["sweep_low"]:
                ict_items.append(("ICT · Liquidity Sweep", 3))
            opp_break = (trig["choch_bear"] or trig["bos_bear"]) and not (trig["choch_bull"] or trig["sweep_low"])
        else:
            if trig["choch_bear"]:
                ict_items.append(("ICT · CHoCH", 3))
            if trig["bos_bear"]:
                ict_items.append(("ICT · BOS", 2))
            if trig["sweep_high"]:
                ict_items.append(("ICT · Liquidity Sweep", 3))
            opp_break = (trig["choch_bull"] or trig["bos_bull"]) and not (trig["choch_bear"] or trig["sweep_high"])
        if opp_break or not ict_items:
            _note(diag, tf, side, "TETİK_YOK", lts)
            continue
        has_sweep = any("Sweep" in n for n, _ in ict_items)
        has_bos = any("BOS" in n for n, _ in ict_items)
        if regime == "YATAY" and not has_sweep:
            _note(diag, tf, side, "YATAY_REJİM", lts)
            continue

        # --- Bolgeler: gecerli + bozulmamis + (v3) tuketilmemis ---
        zones = _collect_zones(c_data, side)
        act = _active_zones(zones, prim, atr, live_price, side)
        if not act:
            _note(diag, tf, side, "BÖLGE_YOK", lts)
            continue
        zone_visits = {}
        if v3:
            kept = []
            for z in act:
                vv = _zone_prior_visits(prim, z[1], z[2], z[3])
                if vv <= ZONE_MAX_PRIOR_VISITS:
                    kept.append(z)
                    zone_visits[z] = vv
            if not kept:
                _note(diag, tf, side, "BÖLGE_TÜKENMİŞ", lts)
                continue
            act = kept
        tolz = atr * 0.15
        best_z, best_grp, best_key = None, set(), None
        for z in act:
            grp = {z2[0] for z2 in act if _z_overlap(z, z2, tolz)}
            key = (len(grp), -abs(live_price - (z[1] + z[2]) / 2.0))
            if best_key is None or key > best_key:
                best_z, best_grp, best_key = z, grp, key
        group_zs = [z2 for z2 in act if _z_overlap(best_z, z2, tolz)]
        zlo = min(z2[1] for z2 in group_zs)
        zhi = max(z2[2] for z2 in group_zs)
        zmid = (zlo + zhi) / 2.0
        zone_fresh = bool(v3 and any(zone_visits.get(z2, 1) == 0 for z2 in group_zs))

        # --- Onay mumu ---
        if is_long:
            react = last["close"] > last["open"] and (trig["rej_bull"] or live_price >= zmid)
        else:
            react = last["close"] < last["open"] and (trig["rej_bear"] or live_price <= zmid)
        if not react:
            _note(diag, tf, side, "ONAY_MUMU", lts)
            continue

        di_ok = (pdi > mdi) if is_long else (mdi > pdi)
        ema_al = bool(e20 and e50 and ((is_long and live_price > e50 and e20 > e50)
                                       or ((not is_long) and live_price < e50 and e20 < e50)))
        strong_trend = bool(v3 and htf_full and prim_bias == want and adx >= ADX_STRONG and di_ok and ema_al)

        if v3:
            scen_label, scen_bonus, confirms = _scenario_label_v3(
                ict_items, best_grp, rsi, eff_rv3, is_long, adx, strong_trend)
        else:
            scen_label, scen_bonus, confirms = _aligned_scenario_label(
                ict_items, best_grp, rsi, eff_rv3, is_long, adx)
        if not scen_label:
            _note(diag, tf, side, "SENARYO", lts)
            continue

        groups = set(best_grp) | {"ICT"}
        if len(groups) < MIN_INDEPENDENT_GROUPS:
            _note(diag, tf, side, "SENARYO", lts)
            continue

        # ============ Buraya kadar KURULUM var. Asagidaki filtreler 'yumusak' (izlenir) ============
        blocks = []
        relaxed = []

        if adx >= MIN_ADX:
            pass
        elif v3 and adx >= ADX_HARD_MIN and adx_rising and di_ok:
            relaxed.append("ADX 18-20 ↑")
        else:
            blocks.append("ADX_18-20" if adx >= ADX_HARD_MIN else "ADX<18")

        lo_r, hi_r = RSI_LONG if is_long else RSI_SHORT
        rsi_ext = False
        if not (lo_r <= rsi <= hi_r):
            if v3 and strong_trend and ((is_long and hi_r < rsi <= RSI_STRONG_LONG_MAX)
                                        or ((not is_long) and RSI_STRONG_SHORT_MIN <= rsi < lo_r)):
                rsi_ext = True
                relaxed.append("RSI uzama")
            else:
                blocks.append("RSI")

        pd_fail = (is_long and pos > PD_LONG_MAX) or ((not is_long) and pos < PD_SHORT_MIN)
        pd_ext = False
        if pd_fail:
            if v3 and (strong_trend or htf_full) and (has_bos or has_sweep) and (
                (is_long and pos <= PD_STRONG_LONG_MAX) or ((not is_long) and pos >= PD_STRONG_SHORT_MIN)
            ):
                pd_ext = True
                relaxed.append("P/D uzama")
            else:
                blocks.append("PREMIUM_DISCOUNT")

        entry = live_price
        if is_long:
            stop_buffer_legacy = LEGACY_STOP_BUFFER_ATR if mode == "legacy" else STOP_BUFFER_ATR
            min_stop_legacy = LEGACY_MIN_STOP_ATR if mode == "legacy" else MIN_STOP_ATR
            sl_raw = min(zlo, min(c["low"] for c in prim[-5:])) - stop_buffer_legacy * atr
            risk = entry - sl_raw
        else:
            stop_buffer_legacy = LEGACY_STOP_BUFFER_ATR if mode == "legacy" else STOP_BUFFER_ATR
            min_stop_legacy = LEGACY_MIN_STOP_ATR if mode == "legacy" else MIN_STOP_ATR
            sl_raw = max(zhi, max(c["high"] for c in prim[-5:])) + stop_buffer_legacy * atr
            risk = sl_raw - entry
        if risk <= 0:
            _note(diag, tf, side, "STOP_GEÇERSİZ", lts)
            continue
        if risk > MAX_STOP_ATR * atr:
            sh = _risk_filter_shadow_candidate(meta, tf, side, entry, sl_raw, atr, last, "STOP_GENİŞ")
            _note(diag, tf, side, "STOP_GENİŞ", lts, blocks=["STOP_GENİŞ"] + blocks,
                  cand=sh, stage="setup")
            continue
        risk = max(risk, min_stop_legacy * atr)
        if risk > MAX_STOP_ATR * atr:
            _note(diag, tf, side, "STOP_GENİŞ", lts, blocks=["STOP_GENİŞ"], stage="hard")
            continue
        sl = entry - risk if is_long else entry + risk
        if sl <= 0:
            continue
        risk_pct = risk / entry * 100.0
        cost_r = roundtrip_cost_pct(tf) / max(risk_pct, 1e-9)
        if cost_r > MAX_COST_R:
            blocks.append("MALİYET")
        sgn = 1.0 if is_long else -1.0
        tp1, tp2, tp3 = (entry + sgn * risk * m for m in TP_R)
        if min(tp1, tp2, tp3) <= 0:
            continue

        if is_long:
            above = [p for p in obst_highs if p > entry + 0.05 * atr]
            room_price = min(above) if above else None
            room_r = ((room_price - entry) / risk) if room_price is not None else None
            swing_move_pct = (((room_price - entry) / entry) * 100.0) if room_price is not None else None
        else:
            below = [p for p in obst_lows if p < entry - 0.05 * atr]
            room_price = max(below) if below else None
            room_r = ((entry - room_price) / risk) if room_price is not None else None
            swing_move_pct = (((entry - room_price) / entry) * 100.0) if room_price is not None else None
        tp3_move_pct = abs(tp3 - entry) / max(entry, 1e-9) * 100.0
        pot_pct = min(swing_move_pct, tp3_move_pct) if swing_move_pct is not None else None
        if room_r is None or room_r < MIN_ROOM_R or pot_pct is None or pot_pct < MIN_SWING_POTENTIAL_PCT:
            blocks.append("ALAN(ROOM)")

        abcd_groups = _build_abcd_groups(ict_items, best_grp, adx, rsi, eff_rv3,
                                         htf_full, react, room_r, cost_r, is_long)
        abcd_code_str = "".join(k for k in ("A", "B", "C", "D") if k in abcd_groups)

        # ---------------- PUANLAMA ----------------
        sweet = (44.0 <= rsi <= 62.0) if is_long else (38.0 <= rsi <= 56.0)
        deep = (pos <= 0.35) if is_long else (pos >= 0.65)
        score = 60.0 + scen_bonus
        if v3:
            score += min(8, 4 * min(2, len(best_grp) - 1) + (2 if zone_fresh else 0))
            htf_pts = ((6 if len(ctx_tfs) >= 2 else 4) if htf_full else 3)
            adx_pts = 4 if adx >= 30 else (3 if adx >= ADX_STRONG else (1 if adx >= MIN_ADX else 0))
            score += min(12, htf_pts + adx_pts + (2 if di_ok else 0))
            score += 4 if eff_rv3 >= 1.5 else (3 if eff_rv3 >= 1.25 else 1)
            score += min(3, (2 if sweet else 0) + (2 if deep else 0))
            score += 4 if (room_r is not None and pot_pct is not None and room_r >= 3.5 and pot_pct >= 3.5) else (2 if room_r is not None and room_r >= 2.6 else 0)
            if rsi_ext:
                score -= 3
            if pd_ext:
                score -= 2
        else:
            score += 4 * min(2, len(best_grp) - 1)
            if htf_full:
                score += 6 if len(ctx_tfs) >= 2 else 4
            else:
                score += 3
            score += 4 if eff_rv3 >= 1.5 else (3 if eff_rv3 >= 1.25 else 1)
            score += 4 if adx >= 30 else (3 if adx >= 25 else 1)
            score += 2 if di_ok else 0
            score += 2 if sweet else 0
            score += 3 if room_r is not None and room_r >= 3.0 else (2 if room_r is not None and room_r >= 2.2 else 0)
            if e20 and e50:
                if is_long and live_price > e50 and e20 > e50:
                    score += 3
                if (not is_long) and live_price < e50 and e20 < e50:
                    score += 3
            score += 2 if deep else 0
        if groups:
            mults = [concept_mults.get(g, 1.0) for g in groups]
            score += round((sum(mults) / len(mults) - 1.0) * 16)
        score += _tf_hist_bonus(learn, tf)
        if news_risk:
            score -= 6
        if risk / atr > 2.0:
            score -= 2
        if regime == "YATAY":
            score -= 2
        final_score = int(max(0, min(MAX_SCORE_CAP, round(score))))
        if final_score < min_score:
            blocks.append("SKOR")

        if blocks and diag is None:
            continue

        group_names = [g for g in MAIN_CONCEPTS if g in groups]
        labels = [f"{tf} {scen_label}"]
        if abcd_code_str:
            labels.append(f"Gruplar [{abcd_code_str}]")
        labels += [f"{tf} {g}" for g in MAIN_CONCEPTS if g in best_grp]
        labels += [f"{tf} {n}" for n, _ in ict_items]
        if ctx_tfs:
            labels += [f"HTF {t} {'↑' if biases[t] == 'BULL' else ('↓' if biases[t] == 'BEAR' else '→')}" for t in ctx_tfs]
        htf_txt = " / ".join(
            f"{t} {'yükseliş' if b == 'BULL' else ('düşüş' if b == 'BEAR' else 'nötr')}" for t, b in biases.items()
        ) if ctx_tfs else f"{tf} trend uyumlu"
        ict_txt = ", ".join(n.replace("ICT · ", "") for n, _ in ict_items)
        relax_txt = (f" Esnetilen koşul: {', '.join(relaxed)} (güçlü trend/yapı teyidiyle)." if relaxed else "")
        ai_reason = (
            f"{meta['pair']} SWAP ({tf} · {scen_label}) {side} [BTC Bağımsız]: üst TF {htf_txt}. "
            f"{', '.join(group_names)} + {ict_txt}. "
            f"ADX {adx:.0f}, RSI {rsi:.0f}, RVol {eff_rv3:.2f}x, hedef yolunda "
            f"{(format(room_r, '.1f') + 'R (~%' + format(pot_pct, '.1f') + ') alan') if room_r is not None and pot_pct is not None else 'doğrulanmış engel alanı bilinmiyor'}. "
            f"Stop yapı + hacim arkasında (%{risk_pct:.2f}), tahmini maliyet {cost_r:.2f}R.{relax_txt} {news_label}."
        )
        invalidation = (
            f"Fiyat {rp(sl)} altında kapanış/temas yaparsa geçersizdir." if is_long
            else f"Fiyat {rp(sl)} üzerinde kapanış/temas yaparsa geçersizdir."
        )

        now_local = datetime.now()
        cand = {
            "id": f"{meta['id']}-{tf}-{last['ts']}-{side}",
            "symbol": meta["id"],
            "pair": meta["pair"],
            "tf": tf,
            "tf_chain": f"Oto-TF ({tf}) · {scen_label} · Üst TF: {', '.join(ctx_tfs) if ctx_tfs else tf}",
            "side": side,
            "entry": rp(entry), "sl": rp(sl), "sl_orig": rp(sl),
            "tp1": rp(tp1), "tp2": rp(tp2), "tp3": rp(tp3),
            "rr": TP_R[1],
            "rr1": TP_R[0], "rr2": TP_R[1],
            "rr_levels": {"tp1": TP_R[0], "tp2": TP_R[1], "tp3": TP_R[2]},
            "risk_pct": round(risk_pct, 3),
            "cost_r": round(cost_r, 3),
            "room_r": round(room_r, 2) if room_r is not None else None,
            "pot_pct": round(pot_pct, 2) if pot_pct is not None else None,
            "room_price": rp(room_price) if room_price is not None else None,
            "atr_value": rp(atr),
            "event_times": {},
            "adx": round(adx, 1),
            "score": final_score,
            "confirmations": len(groups) + confirms,
            "abcd_groups": abcd_groups,
            "abcd_code": abcd_code_str,
            "concepts": list(dict.fromkeys(labels))[:12],
            "regime": regime,
            "ai_reason": ai_reason,
            "invalidation": invalidation,
            "validity_status": "GEÇERLİ",
            "time": now_local.strftime("%H:%M:%S"),
            "date_time": now_local.strftime("%d.%m.%Y %H:%M:%S"),
            "created_ts_ms": now_ms(),
            "candle_ts": last["ts"],
            "last_processed_candle_ts": last["ts"],
            "status": "BEKLIYOR",
            "stage": 0,
            "pnl_r": 0.0,
            "mode": mode,
            "relaxed": relaxed,
            "strong_trend": strong_trend,
        }
        if blocks:
            shadow_ok = not (blocks == ["SKOR"] and final_score < min_score - SHADOW_MIN_SCORE_GAP)
            cand["blocked_by"] = list(blocks)
            _note(diag, tf, side, "SOFT", lts, blocks=blocks, cand=(cand if shadow_ok else None),
                  stage="setup", extra={"missing_by_group": missing_by_group})
            continue
        if not best or _cand_priority(cand) > _cand_priority(best):
            best = cand
    return best


