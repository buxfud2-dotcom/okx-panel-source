class Throttle:
    def __init__(self, per_sec):
        self.gap = 1.0 / per_sec
        self.lock = threading.Lock()
        self.next_t = 0.0

    def wait(self):
        with self.lock:
            now = time.time()
            t = max(now, self.next_t)
            self.next_t = t + self.gap
        d = t - now
        if d > 0:
            time.sleep(d)


CANDLE_THROTTLE = Throttle(16)  # canlı mum/son mum istekleri
HISTORY_THROTTLE = Throttle(8)  # geçmiş mum API'sinde daha temkinli hız
BTC_HISTORY_CACHE = {}
BTC_HISTORY_LOCK = threading.Lock()
CANDLE_CACHE = {}
CACHE_LOCK = threading.Lock()


def fetch_json(url, retries=2, timeout=8):
    last_err = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": "Mozilla/5.0", "Accept": "application/json,text/plain,*/*"},
            )
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            last_err = e
            if e.code == 429:
                time.sleep(1.0 * (attempt + 1))
            elif 400 <= e.code < 500:
                raise
            else:
                time.sleep(0.35 * (attempt + 1))
        except Exception as e:
            last_err = e
            time.sleep(0.35 * (attempt + 1))
    raise last_err


def discover_live_swap_pairs():
    """OKX'teki tüm aktif SWAP sözleşmelerini hacim/spread sıralama filtresi olmadan keşfeder."""
    global LAST_DISCOVERY_STATS
    stats = {"total": 0, "eligible": 0, "excluded": 0, "invalid": 0,
             "stale": 0, "instrument_metadata_ok": False,
             "using_fallback": False, "error": None}
    active_ids = None
    try:
        inst_resp = fetch_json("https://www.okx.com/api/v5/public/instruments?instType=SWAP", retries=2, timeout=12)
        if str(inst_resp.get("code", "0")) == "0":
            active_ids = {str(row.get("instId")) for row in (inst_resp.get("data") or [])
                          if str(row.get("state", "")).lower() == "live" and str(row.get("instId", "")).endswith("-SWAP")}
            stats["instrument_metadata_ok"] = True
    except Exception as e:
        stats["error"] = f"Sözleşme metadata alınamadı: {e}"
        log.warning("OKX SWAP aktif sözleşme metadata alınamadı: %s", e)

    try:
        tick = fetch_json("https://www.okx.com/api/v5/market/tickers?instType=SWAP", retries=2, timeout=12)
        if str(tick.get("code", "0")) != "0":
            raise RuntimeError(tick.get("msg") or "Ticker API başarısız")
        now_m = now_ms()
        rows = tick.get("data") or []
        stats["total"] = len(rows)
        pairs, snap = [], {}
        for row in rows:
            inst = str(row.get("instId") or "").strip()
            if not inst.endswith("-SWAP"):
                stats["invalid"] += 1
                continue
            if active_ids is not None and inst not in active_ids:
                stats["excluded"] += 1
                continue
            try:
                px = float(row.get("last") or 0.0)
                ts_v = int(row.get("ts") or 0)
                o24 = float(row.get("open24h") or 0.0)
            except (TypeError, ValueError):
                stats["invalid"] += 1
                continue
            if px <= 0 or ts_v <= 0 or ts_v > now_m + 5000:
                stats["invalid"] += 1
                continue
            if now_m - ts_v > MAX_TICKER_AGE_SEC * 1000.0:
                stats["stale"] += 1
                continue
            # Hacim, spread, bid/ask ve kontrat büyüklüğü sinyal evreni filtresi değildir.
            pairs.append(inst)
            snap[inst] = {"price": px, "ts_ms": ts_v, "open24h": o24}
        pairs = sorted(set(pairs))
        stats["eligible"] = len(pairs)
        stats["excluded"] += max(0, stats["total"] - stats["eligible"] - stats["invalid"] - stats["stale"] - stats["excluded"])
        LAST_DISCOVERY_STATS = dict(stats)
        return pairs, snap
    except Exception as e:
        stats["error"] = (stats.get("error") + " | " if stats.get("error") else "") + str(e)
        stats["using_fallback"] = True
        LAST_DISCOVERY_STATS = dict(stats)
        log.warning("OKX SWAP listesi alınamadı; sınırlı yedek liste geçici olarak kullanılıyor: %s", e)
        # Ağ/API hatasında panel tamamen boş kalmasın; bu listenin tam evren olmadığı UI'de işaretlenir.
        fallback = list(FALLBACK_CRYPTO_PAIRS)
        return fallback, {}

def _parse_candle_rows(rows):
    out = []
    for r in rows:
        try:
            out.append({
                "ts": int(r[0]),
                "open": float(r[1]), "high": float(r[2]), "low": float(r[3]),
                "close": float(r[4]), "vol": float(r[5]),
                "closed": (r[8] == "1") if len(r) > 8 else True,
            })
        except Exception:
            continue
    return out


def get_okx_candles(inst_id, tf, limit=CANDLE_LIMIT):
    CANDLE_THROTTLE.wait()
    url = f"https://www.okx.com/api/v5/market/candles?instId={inst_id}&bar={tf}&limit={limit}"
    raw = fetch_json(url)
    if str(raw.get("code", "0")) != "0":
        raise RuntimeError(f"OKX mum hatası: {raw.get('msg')}")
    return _parse_candle_rows(list(reversed(raw.get("data") or [])))


def get_candles_cached(inst_id, tf):
    key = (inst_id, tf)
    now = time.time()
    with CACHE_LOCK:
        ent = CANDLE_CACHE.get(key)
    if ent and now - ent[0] < CACHE_TTL.get(tf, 60):
        return [dict(c) for c in ent[1]]
    try:
        cs = get_okx_candles(inst_id, tf)
    except Exception:
        if ent and now - ent[0] < CACHE_TTL.get(tf, 60) * 6:
            return [dict(c) for c in ent[1]]
        raise
    with CACHE_LOCK:
        CANDLE_CACHE[key] = (now, cs)
        if len(CANDLE_CACHE) > 5000:
            stale_keys = [k for k, v in CANDLE_CACHE.items() if now - v[0] > 3600]
            for k in stale_keys:
                CANDLE_CACHE.pop(k, None)
    return [dict(c) for c in cs]


def get_okx_history(inst_id, tf, total=900):
    out = []
    after = None
    while len(out) < total:
        HISTORY_THROTTLE.wait()
        url = f"https://www.okx.com/api/v5/market/history-candles?instId={inst_id}&bar={tf}&limit=300"
        if after:
            url += f"&after={after}"
        raw = fetch_json(url)
        if str(raw.get("code", "0")) != "0":
            raise RuntimeError(f"OKX geçmiş hatası: {raw.get('msg')}")
        rows = raw.get("data") or []
        if not rows:
            break
        out.extend(_parse_candle_rows(rows))
        after = rows[-1][0]
        if len(rows) < 300:
            break
    uniq = {c["ts"]: c for c in out}
    res = [uniq[k] for k in sorted(uniq)]
    return res[-total:]


