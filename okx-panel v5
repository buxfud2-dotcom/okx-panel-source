def _candidate_expected_net_r(sig, learn, min_group_n=20, prior_n=30):
    """Yalnız yeterli örneklemde, grup expectancy'sini küçülterek tahmin eder; olasılık/garanti değildir."""
    rows = {r.get("code"): r for r in ((learn or {}).get("groups_table") or [])}
    estimates, samples = [], []
    for code in (sig.get("grp_matched") or []):
        if code in GROUP_LAYER_CODES:
            continue
        row = rows.get(code) or {}
        n = int(row.get("win", 0)) + int(row.get("loss", 0))
        if n < min_group_n:
            continue
        raw_exp = float(row.get("net_r", 0.0)) / max(1, n)
        weight = n / float(n + prior_n)
        estimates.append(raw_exp * weight)
        samples.append(n)
    if not estimates:
        return None, 0
    return round(sum(estimates) / len(estimates), 4), min(samples)


def evaluate_signal_for_tf(meta, tf, closed_map, live_price, btc_bias, learn, news=None, mode=None, diag=None):
    """1–7 motoru; geçmiş performans sıralaması yalnız yeterli örneklemde etkinleşir."""
    mode = mode or STRATEGY_MODE
    if mode == "groups":
        sig = _evaluate_signal_groups(meta, tf, closed_map, live_price, btc_bias, learn, news=news, mode=mode, diag=diag)
    else:
        sig = _evaluate_signal_classic(meta, tf, closed_map, live_price, btc_bias, learn, news=news, mode=mode, diag=diag)
    if sig:
        exp_r, sample_n = _candidate_expected_net_r(sig, learn)
        sig["expected_net_r_est"] = exp_r
        sig["expected_net_r_sample"] = sample_n
        sig["expected_net_r_is_calibrated"] = exp_r is not None
    return sig


def _cand_priority(sig):
    """Potansiyel (% hareket / room_r) ve skora gore aday oncelik siralamasi."""
    return (
        float(sig.get("pot_pct") or 0.0),
        float(sig.get("room_r") or 0.0),
        int(sig.get("score", 0)),
        int(sig.get("confirmations", 0)),
    )


def evaluate_signal_all_tfs(meta, tf_closed_map, live_price, btc_bias_map, learn, news=None, mode=None, diag=None):
    """1H, 4H ve 1D'yi tarar; secim sirasi: eslesen grup sayisi > skor > potansiyel."""
    best_sig = None
    best_rank = None
    tf_order_idx = {t: i for i, t in enumerate(ALL_SCAN_TFS)}
    for tf_cand in ALL_SCAN_TFS:
        sig = evaluate_signal_for_tf(
            meta, tf_cand, tf_closed_map, live_price,
            btc_bias_map.get(BTC_REF_TF[tf_cand], "NEUTRAL"), learn, news=news, mode=mode, diag=diag,
        )
        if not sig:
            continue
        if sig.get("expected_net_r_est") is not None:
            rank = (1, float(sig["expected_net_r_est"]), int(sig.get("expected_net_r_sample", 0)),
                    len(sig.get("grp_matched") or []), int(sig.get("score", 0)), tf_order_idx.get(tf_cand, 0))
        else:
            rank = (0, len(sig.get("grp_matched") or []), int(sig.get("score", 0)),
                    float(sig.get("pot_pct") or 0.0), tf_order_idx.get(tf_cand, 0), 0)
        if best_rank is None or rank > best_rank:
            best_rank = rank
            best_sig = sig
    return best_sig


def reanchor_signal(sig, px):
    is_long = sig["side"] == "LONG"
    risk_old = abs(float(sig["entry"]) - float(sig["sl"]))
    risk_new = (float(px) - float(sig["sl"])) if is_long else (float(sig["sl"]) - float(px))
    atr_anchor = float(sig.get("atr_value") or 0.0)
    s = dict(sig)
    is_group_v3 = int(s.get("grp_ver", 0) or 0) >= 3
    chase_limit = MAX_CHASE_ATR if is_group_v3 else LEGACY_MAX_CHASE_ATR
    stop_pct_limits = MAX_STOP_PCT if is_group_v3 else LEGACY_MAX_STOP_PCT
    if atr_anchor > 0 and abs(float(px) - float(sig["entry"])) > chase_limit * atr_anchor:
        return None
    if risk_old <= 0 or risk_new <= 0 or risk_new < 0.70 * risk_old or risk_new > 1.35 * risk_old:
        return None
    risk_pct = risk_new / float(px) * 100.0
    if risk_pct > stop_pct_limits.get(sig.get("tf", "4H"), 5.5):
        return None
    if s.get("funding_rate") is not None:
        hold_h = expire_candles_for_tf(s.get("tf", "4H")) * TF_SEC.get(s.get("tf", "4H"), 14400) / 3600.0 * 0.5
        interval_h = max(1.0, float(s.get("funding_interval_hours") or 8.0))
        rate = float(s.get("funding_rate") or 0.0)
        payer_rate = max(0.0, rate if is_long else -rate)
        funding_cost_pct = payer_rate * 100.0 * hold_h / interval_h
        total_cost_pct = ROUNDTRIP_COST_PCT + funding_cost_pct
        s["funding_cost_pct"] = round(funding_cost_pct, 5)
    elif s.get("cost_pct_est") is not None:
        total_cost_pct = float(s.get("cost_pct_est"))
    else:
        total_cost_pct = roundtrip_cost_pct(s.get("tf", "4H"))
    cost_r = total_cost_pct / max(risk_pct, 1e-9)
    # Legacy motorunun eski davranışı korunur; Grup 0-7 motorunda maliyet sinyal eleme kapısı değildir.
    if not is_group_v3 and cost_r > MAX_COST_R:
        return None
    s["entry"] = rp(px)
    s["sl_orig"] = s["sl"]
    sgn = 1.0 if is_long else -1.0
    for key, m in zip(("tp1", "tp2", "tp3"), TP_R):
        s[key] = rp(px + sgn * risk_new * m)
    s["risk_pct"] = round(risk_pct, 3)
    s["cost_r"] = round(cost_r, 3)
    s["cost_pct_est"] = round(total_cost_pct, 4)
    room_price = s.get("room_price")
    if room_price is not None:
        try:
            room_price = float(room_price)
            s["room_r"] = round(((room_price - px) if is_long else (px - room_price)) / risk_new, 2)
            s["pot_pct"] = round(min(abs(room_price - px) / max(float(px), 1e-12) * 100.0,
                                     abs(float(s["tp3"]) - px) / max(float(px), 1e-12) * 100.0), 2)
            if s["room_r"] <= 0:
                return None
        except (TypeError, ValueError, ZeroDivisionError):
            s["room_r"], s["pot_pct"] = None, None
    else:
        s["room_r"], s["pot_pct"] = None, None
    room_r_now = s.get("room_r")
    groups_now = set(s.get("grp_matched") or [])
    if room_r_now is None:
        return None
    strict_room = bool(groups_now & {"2", "3"})
    min_room = G_MIN_ROOM_R if strict_room else G_BASE_ROOM_R
    min_pot = G_MIN_POT_PCT if strict_room else G_BASE_POT_PCT
    if room_r_now < min_room or s.get("pot_pct") is None or s["pot_pct"] < min_pot:
        return None
    now_local = datetime.now()
    s["time"] = now_local.strftime("%H:%M:%S")
    s["date_time"] = now_local.strftime("%d.%m.%Y %H:%M:%S")
    s["created_ts_ms"] = now_ms()
    return s

def _risk_abs(h):
    """Islemin ORIJINAL risk mesafesi (fiyat cinsinden). Stop BE'ye cekilse bile degismez."""
    try:
        entry = float(h["entry"])
        so = h.get("sl_orig")
        if so is not None:
            r = abs(entry - float(so))
            if r > 0:
                return r
        if int(h.get("stage", 0)) == 0:
            r = abs(entry - float(h["sl"]))
            if r > 0:
                return r
        rr1 = float(h.get("rr1", TP_R[0])) or TP_R[0]
        r = abs(float(h["tp1"]) - entry) / rr1
        if r > 0:
            return r
    except Exception:
        pass
    return 1e-12


def _move_r(h, px):
    entry = float(h["entry"])
    move = (px - entry) if h["side"] == "LONG" else (entry - px)
    return move / _risk_abs(h)


def _fracs():
    f1 = PARTIAL_AT_TP1
    f2 = PARTIAL_AT_TP2
    f3 = max(0.0, 1.0 - f1 - f2)
    return f1, f2, f3


def _calc_partial_pnl_r(h, leg_outcome, px=None):
    """3 kademeli cikis: TP1 %50 -> stop BE | TP2 %30 -> stop TP1 | TP3 %20. Maliyet (R) bir kez dusulur."""
    rr1 = float(h.get("rr1", TP_R[0]))
    rr2 = float(h.get("rr2", TP_R[1]))
    rr3 = float((h.get("rr_levels") or {}).get("tp3", TP_R[2]))
    cost = float(h.get("cost_r", 0.2))
    stage = int(h.get("stage", 0))
    f1, f2, f3 = _fracs()
    ref_px = px if px is not None else float(h["entry"])

    if stage == 0:
        r = -1.0 if leg_outcome == "SL" else _move_r(h, ref_px)
        return round(r - cost, 3)

    if stage == 1:
        base = f1 * rr1
        rem = 0.0 if leg_outcome == "BE" else (f2 + f3) * _move_r(h, ref_px)
        return round(base + rem - cost, 3)

    base = f1 * rr1 + f2 * rr2
    if leg_outcome == "TP3":
        rem = f3 * rr3
    elif leg_outcome == "TRAIL":
        rem = f3 * rr1
    else:
        rem = f3 * _move_r(h, ref_px)
    return round(base + rem - cost, 3)


def trade_pnl_r(h, outcome, px=None):
    return _calc_partial_pnl_r(h, outcome, px)


def _infer_exit_price(h, outcome, px=None):
    entry = float(h.get("entry") or 0.0)
    sl = float(h.get("sl") or entry)
    tp1 = float(h.get("tp1") or entry)
    tp2 = float(h.get("tp2") or entry)
    tp3 = float(h.get("tp3") or tp2 or entry)
    if outcome == "SL":
        return rp(sl)
    if outcome == "BE":
        return rp(entry)
    if outcome == "TRAIL":
        return rp(tp1)
    if outcome == "TP1":
        return rp(tp1)
    if outcome == "TP2":
        return rp(tp2)
    if outcome == "TP3":
        return rp(tp3)
    if px is not None and float(px) > 0:
        return rp(float(px))
    return rp(entry)


def finish_trade(h, outcome, px=None):
    h["pnl_r"] = trade_pnl_r(h, outcome, px)
    h["status"] = "WIN" if h["pnl_r"] > 0 else "LOSS"
    h["exit_reason"] = {
        "SL": "SL", "BE": "BE", "TRAIL": "TRAIL", "TP1": "TP1", "TP2": "TP2", "TP3": "TP3", "TIMEOUT": "TIMEOUT"
    }.get(outcome, outcome)
    h["exit_price"] = _infer_exit_price(h, outcome, px)
    now_local = datetime.now()
    h["closed_time"] = now_local.strftime("%d.%m.%Y %H:%M:%S")
    h["closed_ts_ms"] = now_ms()


def advance_trade(h, hi, lo):
    """Kademeli TP/SL. Aynı OHLC mumunda yeni aktive olan stop da görülürse muhafazakâr sonuç uygulanır."""
    is_long = h["side"] == "LONG"
    entry = float(h["entry"])
    tp1 = float(h["tp1"])
    tp2 = float(h.get("tp2") or tp1)
    tp3 = float(h.get("tp3") or tp2)
    rr1 = float(h.get("rr1", TP_R[0]))
    rr2 = float(h.get("rr2", TP_R[1]))
    f1, f2, _ = _fracs()
    hi, lo = float(hi), float(lo)

    def reached(level):
        return hi >= level if is_long else lo <= level

    def stopped(level):
        return lo <= level if is_long else hi >= level

    stage = int(h.get("stage", 0))
    if stage == 0:
        # İlk stop ile TP1 aynı mumda görülürse en kötü senaryo olan SL kabul edilir.
        if stopped(float(h["sl"])):
            finish_trade(h, "SL", float(h["sl"]))
            return h["status"]
        if not reached(tp1):
            return None
        h["stage"] = 1
        h["partial_frac"] = f1
        h["realized_r"] = round(f1 * rr1, 3)
        h["sl"] = rp(entry)
        # TP1 sonrasında BE seviyesi de aynı OHLC aralığındaysa kalan yarı BE'den kapatılır.
        if stopped(entry):
            finish_trade(h, "BE", entry)
            return h["status"]
        # Mum TP2'ye de ulaştıysa, BE stop görülmediği için sıradaki kademe de gerçekleşmiştir.
        if reached(tp2):
            h["stage"] = 2
            h["realized_r"] = round(f1 * rr1 + f2 * rr2, 3)
            h["sl"] = rp(tp1)
            # TP2 sonrası yeni stop aynı mumda görülüyorsa hedef sırasını varsayma; trail ile bitir.
            if stopped(tp1):
                finish_trade(h, "TRAIL", tp1)
                return h["status"]
            if reached(tp3):
                finish_trade(h, "TP3", tp3)
                return h["status"]
            return "PARTIAL_TP2"
        return "PARTIAL_TP1"

    if stage == 1:
        if stopped(entry):
            finish_trade(h, "BE", entry)
            return h["status"]
        if not reached(tp2):
            return None
        h["stage"] = 2
        h["realized_r"] = round(f1 * rr1 + f2 * rr2, 3)
        h["sl"] = rp(tp1)
        if stopped(tp1):
            finish_trade(h, "TRAIL", tp1)
            return h["status"]
        if reached(tp3):
            finish_trade(h, "TP3", tp3)
            return h["status"]
        return "PARTIAL_TP2"

    if stopped(tp1):
        finish_trade(h, "TRAIL", tp1)
        return h["status"]
    if reached(tp3):
        finish_trade(h, "TP3", tp3)
        return h["status"]
    return None


def check_timeout(h, px, now_m):
    tf_key = h.get("tf", "4H")
    exp_candles = expire_candles_for_tf(tf_key)
    exp_ms = exp_candles * TF_SEC.get(tf_key, 14400) * 1000
    if now_m - int(h.get("created_ts_ms", now_m)) >= exp_ms and px is not None:
        finish_trade(h, "TIMEOUT", px)
        return True
    return False


def catchup_resolve(h, candles):
    """Yalnızca bu işlem için daha önce işlenmemiş, sinyal sonrası kapanmış mumları oynatır."""
    tf = h.get("tf", "4H")
    tf_ms = TF_SEC.get(tf, 14400) * 1000
    candle_ts = int(h.get("candle_ts") or 0)
    created = int(h.get("created_ts_ms", 0) or 0)
    if not candle_ts:
        # Eski geçmiş kayıtları için en yakın tamamlanmış TF sınırından önceki mumu baz al.
        candle_ts = max(0, (created // max(tf_ms, 1)) * tf_ms - tf_ms)
    last_done = int(h.get("last_processed_candle_ts") or candle_ts)
    for c in sorted(candles, key=lambda x: int(x.get("ts", 0))):
        ts = int(c.get("ts", 0))
        if ts <= last_done or ts <= candle_ts or not c.get("closed", True):
            continue
        if h.get("status") != "BEKLIYOR":
            break
        advance_trade(h, c["high"], c["low"])
        h["last_processed_candle_ts"] = ts
        last_done = ts
    return h



def catchup_pending_unlocked():
    """Acik islemleri KENDI TF mumlariyla (ag cagrisi KILIT DISINDA) ilerletir. {id: islem_kopyasi} dondurur."""
    with LOCK:
        snaps = [dict(h) for h in STATE["history"] if h.get("status") == "BEKLIYOR"]
    out, cache = {}, {}
    for hc in snaps:
        sym = pair_to_swap(hc.get("symbol", ""))
        k = (sym, hc.get("tf"))
        if k not in cache:
            try:
                cache[k] = [c for c in get_candles_cached(sym, hc.get("tf", "4H")) if c.get("closed")]
            except Exception as e:
                log.debug("Catchup mumu alinamadi (%s %s): %s", sym, hc.get("tf"), e)
                cache[k] = []
        if cache[k]:
            before = int(hc.get("stage", 0))
            before_cursor = int(hc.get("last_processed_candle_ts", hc.get("candle_ts", 0)) or 0)
            catchup_resolve(hc, cache[k])
            if (hc.get("status") != "BEKLIYOR" or int(hc.get("stage", 0)) != before
                    or int(hc.get("last_processed_candle_ts", 0) or 0) != before_cursor):
                out[hc["id"]] = hc
    return out


