    rsi_ok = (44.0 <= rsi <= 64.0) if is_long else (36.0 <= rsi <= 56.0)
    vol_ok = (rv3 or 0.0) >= 1.25
    trend_ok = adx is not None and adx >= 25.0
    confirms = int(rsi_ok) + int(vol_ok) + int(trend_ok)
    short_names = {"FVG": "FVG", "Order Block": "OB", "Supply & Demand": "S&D"}
    z_lbl = "+".join(short_names[z] for z in zones)

    if has_sweep and has_struct and (len(zones) >= 2 or confirms >= 2):
