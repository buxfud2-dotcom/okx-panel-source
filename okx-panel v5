def _closed_trade_exit_price(h):
    entry = float(h.get("entry") or 0.0)
    sl = float(h.get("sl") or entry)
    tp1 = float(h.get("tp1") or entry)
    tp2 = float(h.get("tp2") or tp1 or entry)
    tp3 = float(h.get("tp3") or tp2 or entry)
    reason = str(h.get("exit_reason") or "").upper()
    if reason == "SL":
        return rp(sl)
    if reason == "BE":
        return rp(entry)
    if reason in ("TP1", "TRAIL"):
        return rp(tp1)
    if reason == "TP2":
        return rp(tp2)
    if reason == "TP3":
        return rp(tp3)
    if h.get("exit_price") is not None:
        try:
            v = float(h["exit_price"])
            if v > 0:
                return rp(v)
        except Exception:
            pass
    if reason == "TIMEOUT":
        risk = _risk_abs(h)
        pnl_r = float(h.get("pnl_r") or 0.0)
        cost_r = float(h.get("cost_r") or 0.0)
        sgn = 1.0 if h.get("side") == "LONG" else -1.0
        if entry > 0 and risk > 0:
            est = entry + sgn * (pnl_r + cost_r) * risk
            if est > 0:
                return rp(est)
    return rp(tp1 if h.get("status") == "WIN" else sl)


def _closed_trade_1x_pct_from_history(h):
    """1X getiri % = net pnl_r x risk% (kismi cikislar ve maliyet DAHIL; pnl_r ile tutarli)."""
    exit_px = _closed_trade_exit_price(h)
    risk_pct = float(h.get("risk_pct") or 1.0)
    raw_pct = float(h.get("pnl_r") or 0.0) * risk_pct
    return round(raw_pct, 2), exit_px


def _build_closed_trades_locked(leverage):
    lev = max(1, min(125, int(leverage or 2)))
    out = []
    hidden_ids = {str(x) for x in (STATE.get("closed_hidden_ids") or [])}
    cleared_at = int(STATE.get("closed_cleared_at_ms") or 0)
    for idx_h, h in enumerate(STATE["history"]):
        st = h.get("status")
        if st not in ("WIN", "LOSS"):
            continue
        if not h.get("id"):
            h["id"] = f"closed-{idx_h}-{int(h.get('closed_ts_ms') or h.get('created_ts_ms') or 0)}"
        hid = str(h["id"])
        cts = int(h.get("closed_ts_ms") or h.get("created_ts_ms") or 0)
        if hid in hidden_ids or (cleared_at > 0 and cts > 0 and cts <= cleared_at):
            continue
        entry = float(h.get("entry") or 0.0)
        raw_pct, exit_px = _closed_trade_1x_pct_from_history(h)
        side = h.get("side", "LONG")
        lev_pct = raw_pct * lev
        reason = h.get("exit_reason") or ("TP1" if st == "WIN" else "SL")
        out.append({
            "id": h.get("id", ""),
            "pair": h.get("pair") or swap_to_pair(h.get("symbol", "")),
            "tf": h.get("tf", ""),
            "side": side,
            "status": st,
            "exit_reason": reason,
            "entry": rp(entry),
            "exit_price": exit_px,
            "raw_pct": round(raw_pct, 2),
            "lev_pct": round(lev_pct, 2),
            "leverage": lev,
            "pnl_r": float(h.get("pnl_r") or 0.0),
            "opened_at": h.get("date_time") or h.get("time") or "-",
            "closed_at": h.get("closed_time") or "-",
        })
    return out[:60]


