def fetch_and_analyze_one(sym, chart_tf, btc_bias_map, learn_snap, open24h, want_diag=False, market_snapshot=None):
    all_needed_tfs = list(dict.fromkeys([*ALL_SCAN_TFS, chart_tf]))
    closed_map, all_raw_map = {}, {}
    for tf_x in all_needed_tfs:
        try:
            cs = get_candles_cached(sym, tf_x)
        except Exception as e:
            log.debug("Mum çekilemedi (%s %s): %s", sym, tf_x, e)
            continue
        if cs:
            all_raw_map[tf_x] = cs
            cl = [c for c in cs if c["closed"]]
            if len(cl) >= 60:
                closed_map[tf_x] = cl

    chart_all = all_raw_map.get(chart_tf) or []
    if not chart_all or not closed_map:
        return None
    ref_tf = chart_tf if chart_tf in all_raw_map else next(iter(all_raw_map))
    ref_all = all_raw_map[ref_tf]
    tf_ms = TF_SEC.get(ref_tf, 14400) * 1000
    if (now_ms() - ref_all[-1]["ts"]) > tf_ms * 8:
        return None

    meta = {"id": sym, "pair": swap_to_pair(sym), "provider": "OKX SWAP"}
    with LOCK:
        last_info = STATE["last_prices"].get(sym)
        last_age_ms = max(0, now_ms() - int(last_info.get("ts_ms", 0))) if last_info else None
        last_fresh = bool(last_info and last_info.get("price") and last_age_ms is not None
                          and last_age_ms <= PRICE_FRESHNESS_SEC * 1000.0)
        live_px = float(last_info["price"]) if last_fresh else None
    if not last_fresh or live_px is None or live_px <= 0:
        return None

    if open24h and open24h > 0:
        chg = (live_px - open24h) / open24h * 100.0
    else:
        prev_c = closed_map[ref_tf][-1]["close"] if ref_tf in closed_map else ref_all[-1]["close"]
        chg = ((live_px - prev_c) / prev_c * 100.0) if prev_c else 0.0

    diag = [] if want_diag else None
    sig = evaluate_signal_all_tfs(meta, closed_map, live_px, btc_bias_map, learn_snap, diag=diag)
    if sig:
        # Maliyet yalnız raporlama/sonuç hesabı içindir; V5.1 sinyal kapısı değildir.
        tf_sig = sig.get("tf", chart_tf)
        sig.setdefault("cost_pct_est", roundtrip_cost_pct(tf_sig))
        risk_pct = float(sig.get("risk_pct") or 0.0)
        sig.setdefault("cost_r", round(roundtrip_cost_pct(tf_sig) / max(risk_pct, 1e-9), 3))
        sig["cost_source"] = "sabit araştırma varsayımı; sinyal engeli değil"
        sig["spread_gate"] = "DISABLED"
        sig["volume_gate"] = "DISABLED"

    return {
        "id": sym, "pair": meta["pair"], "provider": meta["provider"],
        "tf": chart_tf, "base_price": chart_all[-1]["close"], "open24h": open24h,
        "change_pct": round(chg, 2), "candles": chart_all[-160:],
        "signal": sig, "diag": diag, "price_source": "LAST (OKX SWAP)",
        "price_age_ms": last_age_ms, "price_fresh": True,
    }

def safe_fetch_analyze(sym, tf, btc_bias_map, learn_snap, open24h, want_diag=False, market_snapshot=None):
    try:
        return fetch_and_analyze_one(sym, tf, btc_bias_map, learn_snap, open24h, want_diag, market_snapshot)
    except Exception as e:
        log.warning("Parite analiz hatasi (%s %s): %s", sym, tf, e)
        return None


def _merged_items_locked(results_by_id, target_tf, live_set, order):
    base = {it["id"]: it for it in STATE["items"] if it.get("tf") == target_tf and it["id"] in live_set}
    base.update(results_by_id)
    return sorted(base.values(), key=lambda x: order.get(x["id"], 999999))


def run_scan(target_tf):
    with LOCK:
        STATE["scanning"] = True
        learn_snap = dict(STATE.get("learning") or {})
    try:
        live_pairs, disc_snap = discover_live_swap_pairs()
        with LOCK:
            STATE["crypto_pairs"] = live_pairs
            STATE["scan_total"] = len(live_pairs)
            for k, v in disc_snap.items():
                if k not in STATE["last_prices"]:
                    STATE["last_prices"][k] = {"price": v["price"], "ts_ms": v["ts_ms"], "src": "rest"}
        WS_SYNC.set()

        live_set = set(live_pairs)
        order = {s: i for i, s in enumerate(live_pairs)}
        btc_bias_map = compute_btc_bias_map()

        results_by_id, failed, done = {}, 0, 0
        diag_all = []
        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
            futs = [
                pool.submit(safe_fetch_analyze, s, target_tf, btc_bias_map, learn_snap,
                            (disc_snap.get(s) or {}).get("open24h", 0.0), True, disc_snap.get(s) or {})
                for s in live_pairs
            ]
            for fut in as_completed(futs):
                r = fut.result()
                if r:
                    diag_all.append((r["id"], r.pop("diag", None)))
                    results_by_id[r["id"]] = r
                else:
                    failed += 1
                done += 1
                if done % 15 == 0:
                    with LOCK:
                        if STATE["tf"] == target_tf:
                            STATE["items"] = _merged_items_locked(results_by_id, target_tf, live_set, order)
                            STATE["scan_ok"] = len(results_by_id)
                            STATE["scan_total"] = len(live_pairs)
                            STATE["scan_errors"] = failed

        if failed > 0:
            log.info("Tarama ozeti (%s): %d/%d basarili, %d hatali/atladi", target_tf, len(results_by_id), len(live_pairs), failed)

        results = sorted(results_by_id.values(), key=lambda x: order.get(x["id"], 999999))
        cands = sorted(
            [d["signal"] for d in results if d.get("signal")],
            key=lambda s: (-(float(s.get("expected_net_r_est")) if s.get("expected_net_r_est") is not None else -999.0),
                           -float(s.get("pot_pct") or 0.0), -float(s.get("room_r") or 0.0), -int(s.get("score", 0))),
        )

        catch_updates = catchup_pending_unlocked()

        with LOCK:
            if STATE["tf"] == target_tf:
                STATE["items"] = _merged_items_locked(results_by_id, target_tf, live_set, order)

            m_now = now_ms()
            hist = STATE["history"]

            for h in hist:
                if h.get("status") != "BEKLIYOR":
                    continue
                u = catch_updates.get(h.get("id"))
                if u and (u.get("status") != "BEKLIYOR" or int(u.get("stage", 0)) > int(h.get("stage", 0))
                          or int(u.get("last_processed_candle_ts", 0) or 0) > int(h.get("last_processed_candle_ts", h.get("candle_ts", 0)) or 0)):
                    h.update(u)
                if h.get("status") == "BEKLIYOR":
                    px = _trade_price(pair_to_swap(h["symbol"]), None)
                    check_timeout(h, px, m_now)

            pending = [h for h in hist if h.get("status") == "BEKLIYOR"]
            pend_syms = {pair_to_swap(h["symbol"]) for h in pending}
            pend_open_tp_sl_syms = {
                pair_to_swap(h["symbol"]) for h in pending
                if _has_valid_tp_sl(h)
            }
            side_cnt = {"LONG": 0, "SHORT": 0}
            for h in pending:
                side_cnt[h.get("side", "LONG")] = side_cnt.get(h.get("side", "LONG"), 0) + 1
            today_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp() * 1000
            today_cnt = sum(1 for h in hist if int(h.get("created_ts_ms", 0)) >= today_start)
            blocked = set()
            seen_ids = {h["id"] for h in hist}
            last_by_sym = {}
            last_by_symtf = {}
            for h in hist:
                last_by_sym.setdefault(pair_to_swap(h.get("symbol", "")), int(h.get("created_ts_ms", 0)))
                last_by_symtf.setdefault((pair_to_swap(h.get("symbol", "")), h.get("tf")), int(h.get("created_ts_ms", 0)))

            added = []
            for sig in cands:
                sym = pair_to_swap(sig["symbol"])
                if sig["id"] in seen_ids:
                    continue
                if not _has_valid_tp_sl(sig):
                    _add_shadow_locked(sig, ["TP_SL_EKSİK"])
                    continue
                if sym in pend_syms or sym in pend_open_tp_sl_syms:
                    _add_shadow_locked(sig, ["AÇIK_SİNYAL_VAR"])
                    continue
                if sym in blocked:
                    _add_shadow_locked(sig, ["PARİTE_BLOK"])
                    continue
                cool_ms = cooldown_candles(sig["tf"]) * TF_SEC[sig["tf"]] * 1000
                last_t = last_by_sym.get(sym, 0) if STRATEGY_MODE == "legacy" else last_by_symtf.get((sym, sig["tf"]), 0)
                if cool_ms > 0 and (m_now - last_t < cool_ms):
                    _add_shadow_locked(sig, ["BEKLEME"])
                    continue
                if MAX_ACTIVE_SIGNALS is not None and len(pend_syms) >= MAX_ACTIVE_SIGNALS:
                    _add_shadow_locked(sig, ["PORTFÖY_LİMİT"])
                    continue
                if MAX_SAME_SIDE_ACTIVE is not None and side_cnt.get(sig["side"], 0) >= MAX_SAME_SIDE_ACTIVE:
                    _add_shadow_locked(sig, ["YÖN_LİMİT"])
                    continue
                if MAX_NEW_PER_SCAN is not None and len(added) >= MAX_NEW_PER_SCAN:
                    _add_shadow_locked(sig, ["TARAMA_LİMİT"])
                    continue
                if MAX_SIGNALS_PER_DAY is not None and (today_cnt + len(added)) >= MAX_SIGNALS_PER_DAY:
                    _add_shadow_locked(sig, ["GÜNLÜK_LİMİT"])
                    continue
                px = _trade_price(sym, None)
                if px is None:
                    _add_shadow_locked(sig, ["BAYAT_FİYAT"])
                    continue
                fixed = reanchor_signal(sig, px)
                if not fixed:
                    continue
                fixed.setdefault("last_processed_candle_ts", int(fixed.get("candle_ts") or 0))
                hist.insert(0, fixed)
                seen_ids.add(fixed["id"])
                pend_syms.add(sym)
                side_cnt[fixed["side"]] = side_cnt.get(fixed["side"], 0) + 1
                added.append(fixed)

            if added:
                STATE["selected_pair"] = added[0]["pair"]
                STATE["latest_signal_pair"] = added[0]["pair"]
                STATE["latest_signal_ts"] = now_ms()
                persist_ui_state_locked()

            process_diag_locked(diag_all)
            active_history = [h for h in hist if h.get("status") == "BEKLIYOR"]
            closed_history = [h for h in hist if h.get("status") != "BEKLIYOR"][:HISTORY_LIMIT]
            STATE["history"] = sorted(active_history + closed_history,
                                      key=lambda h: int(h.get("created_ts_ms", 0) or 0), reverse=True)
            STATE["learning"] = compute_learning_profile(STATE["history"])
            STATE["scan_ok"] = len(results)
            STATE["scan_total"] = len(live_pairs)
            STATE["scan_errors"] = failed
            STATE["last_scan"] = datetime.now().strftime("%H:%M:%S")
            save_json_file(HISTORY_FILE, STATE["history"])
            save_json_file(LEARN_FILE, STATE["learning"])
        if added:
            WS_SYNC.set()
        update_shadows_and_summary()
    finally:
        with LOCK:
            STATE["scanning"] = False


def scanner_loop():
    while True:
        with LOCK:
            tf = STATE["tf"]
        try:
            run_scan(tf)
        except Exception:
            log.exception("Tarama hatası")
        WAKE.wait(SCAN_INTERVAL_SEC)
        WAKE.clear()


def quick_refresh_selected(tf):
    try:
        with LOCK:
            pair = STATE["selected_pair"]
        sym = pair_to_swap(pair)
        cs = get_okx_candles(sym, tf)
        if not cs:
            return
        with LOCK:
            if STATE["tf"] != tf:
                return
            for it in STATE["items"]:
                if it["id"] == sym:
                    it["candles"] = cs[-160:]
                    it["tf"] = tf
                    it["base_price"] = cs[-1]["close"]
                    break
            else:
                STATE["items"].append({
                    "id": sym, "pair": swap_to_pair(sym), "provider": "OKX SWAP", "tf": tf,
                    "base_price": cs[-1]["close"], "open24h": 0.0, "change_pct": 0.0,
                    "candles": cs[-160:], "signal": None,
                })
    except Exception as e:
        log.warning("Secili parite hizli yenileme hatasi (%s %s): %s", pair_to_swap(STATE.get("selected_pair", "")), tf, e)


def get_snapshot():
    with LOCK:
        mode = STATE["price_mode"]
        tf_now = STATE["tf"]
        sel_pair = STATE["selected_pair"]
        lev_now = STATE.get("leverage", 2)
        out_items = []
        price_lookup = {}
        sel_it = None
        sel_row = None

        for it in STATE["items"]:
            sym = it["id"]
            p_info = _crypto_active_price(sym, it["base_price"])
            price_lookup[sym] = p_info["price"]
            last_b = STATE["last_prices"].get(sym)
            mark_b = STATE["mark_prices"].get(sym)
            idx_b = STATE["index_prices"].get(sym)
            o24 = it.get("open24h") or 0.0
            chg = ((p_info["price"] - o24) / o24 * 100.0) if (o24 and p_info["price"]) else it.get("change_pct", 0.0)
            row = {
                "id": sym,
                "pair": it["pair"],
                "provider": it["provider"],
                "price": p_info["price"],
                "price_fresh": p_info["fresh"],
                "price_label": p_info["label"],
                "age_ms": p_info["age_ms"],
                "last_price": last_b["price"] if last_b else p_info["price"],
                "mark_price": mark_b["price"] if mark_b else p_info["price"],
                "index_price": idx_b["price"] if idx_b else p_info["price"],
                "change_pct": round(chg, 2),
            }
            out_items.append(row)
            if it["pair"] == sel_pair:
                sel_it, sel_row = it, row
        if sel_it is None and STATE["items"]:
            sel_it, sel_row = STATE["items"][0], out_items[0]

        selected = None
        if sel_it is not None:
            candles_out = []
            if sel_it.get("tf") == tf_now:
                candles_out = [dict(c) for c in (sel_it.get("candles") or [])]
            selected = dict(sel_row)
            selected["candles"] = candles_out

        learn = STATE.get("learning") or {}
        today_start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp() * 1000
        today_cnt = sum(1 for h in STATE["history"] if int(h.get("created_ts_ms", 0)) >= today_start)

        active_sigs = []
        for h in STATE["history"]:
            if h.get("status") != "BEKLIYOR":
                continue
            sym_h = pair_to_swap(h.get("symbol", ""))
            # Sinyal karti daima islem icin kullanilan LAST fiyatini kullanir; MARK/INDEX veya
            # bayat bir yedek fiyatla anlik R/mesafe hesaplanmaz.
            cur_p = _trade_price(sym_h, None)
            entry_p = float(h.get("entry") or 0.0)
            risk = _risk_abs(h)
            sgn = 1.0 if h.get("side") == "LONG" else -1.0
            fav = (cur_p - entry_p) * sgn if cur_p is not None else None
            item = dict(h)
            item["current_price"] = cur_p
            last_quote = STATE["last_prices"].get(sym_h)
            quote_age_ms = (max(0, now_ms() - int(last_quote.get("ts_ms", 0))) if last_quote else None)
            item["signal_price_source"] = "LAST (OKX SWAP)"
            item["last_price_age_ms"] = quote_age_ms
            item["last_price_fresh"] = bool(quote_age_ms is not None and quote_age_ms <= PRICE_FRESHNESS_SEC * 1000.0)
            item["dist_pct"] = round(fav / max(entry_p, 1e-9) * 100.0, 2) if fav is not None else None
            item["r_now"] = round(fav / risk, 2) if fav is not None and risk > 0 else None
            item["late"] = bool(cur_p is not None and int(h.get("stage", 0)) == 0 and fav >= 0.5 * risk)
            active_sigs.append(item)

        wl_trades = [t for t in STATE["history"] if t.get("status") in ("WIN", "LOSS")]
        live_perf = _calc_metrics_from_trades([{"net_r": float(t.get("pnl_r", 0.0))} for t in wl_trades])
        closed_trades = _build_closed_trades_locked(lev_now)

        raw_sum_1x = sum(_closed_trade_1x_pct_from_history(h)[0] for h in wl_trades)
        offset_1x = float(STATE.get("net_1x_offset", 0.0) or 0.0)
        net_1x_pct = round(raw_sum_1x - offset_1x, 2)
        today_1x_pct = round(
            sum(
                _closed_trade_1x_pct_from_history(h)[0]
                for h in wl_trades
                if int(h.get("closed_ts_ms") or h.get("created_ts_ms") or 0) >= today_start
            ),
            2,
        )

        trade_stats = {
            "opened": len(STATE["history"]),
            "win": sum(1 for t in STATE["history"] if t.get("status") == "WIN"),
            "loss": sum(1 for t in STATE["history"] if t.get("status") == "LOSS"),
            "pending": sum(1 for t in STATE["history"] if t.get("status") == "BEKLIYOR"),
            "expired": sum(1 for t in STATE["history"] if t.get("exit_reason") == "TIMEOUT"),
        }

        return {
            "tf": tf_now,
            "price_mode": mode,
            "selected_pair": sel_row["pair"] if sel_row else sel_pair,
            "bell_enabled": STATE["bell_enabled"],
            "radio_enabled": STATE["radio_enabled"],
            "radio_vol": STATE["radio_vol"],
            "radio_idx": STATE["radio_idx"],
            "leverage": lev_now,
            "scanning": STATE["scanning"],
            "last_scan": STATE["last_scan"],
            "scan_ok": STATE["scan_ok"],
            "scan_total": STATE["scan_total"],
            "scan_errors": STATE.get("scan_errors", 0),
            "ws_connected": STATE["ws_connected"],
            "ws_status": STATE["ws_status"],
            "ws_reconnects": STATE["ws_reconnects"],
            "items": out_items,
            "selected_item": selected,
            "signals": active_sigs,
            "closed_trades": closed_trades,
            "net_1x_pct": net_1x_pct,
            "today_1x_pct": today_1x_pct,
            "live_perf": live_perf,
            "trade_stats": trade_stats,
            "today_signals": today_cnt,
            "max_day": MAX_SIGNALS_PER_DAY,
            "signal_quota": "YOK",
            "min_groups": 1,
            "min_groups_policy": "Grup 0 rejim/yön kapısıdır; Grup 1–5/7 sinyal motorlarıdır, Grup 6 yalnız confluence katmanıdır.",
            "abcd_legend": GROUP_LABELS,
            "learning": learn,
            "backtest": STATE.get("backtest"),
            "backtest_multi": STATE.get("backtest_multi"),
            "block_analysis": STATE.get("block_summary"),
            "market_universe": dict(LAST_DISCOVERY_STATS),
            "data_health": {
                "ws_connected": bool(STATE.get("ws_connected")),
                "ws_status": STATE.get("ws_status"),
                "ws_reconnects": int(STATE.get("ws_reconnects", 0)),
                "tracked_pairs": len(STATE.get("crypto_pairs") or []),
                "stale_last_prices": sum(
                    1 for sym in (STATE.get("crypto_pairs") or [])
                    if not (STATE.get("last_prices", {}).get(sym)
                            and now_ms() - int(STATE["last_prices"][sym].get("ts_ms", 0)) <= PRICE_FRESHNESS_SEC * 1000)
                ),
            },
            "strategy_mode": STRATEGY_MODE,
            "strategy_version": "5.1",
        }


