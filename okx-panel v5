def calc_atr(candles, period=14):
    if len(candles) < 2:
        return 0.0
    trs = []
    for i in range(1, len(candles)):
        h, l, pc = candles[i]["high"], candles[i]["low"], candles[i - 1]["close"]
        trs.append(max(h - l, abs(h - pc), abs(l - pc)))
    if len(trs) < period:
        return sum(trs) / len(trs) if trs else 0.0
    atr = sum(trs[:period]) / period
    for tr in trs[period:]:
        atr = (atr * (period - 1) + tr) / period
    return atr


def calc_ema(vals, period):
    if len(vals) < period:
        return None
    k = 2.0 / (period + 1.0)
    ema = sum(vals[:period]) / period
    for v in vals[period:]:
        ema = v * k + ema * (1.0 - k)
    return ema


def calc_rsi(vals, period=14):
    if len(vals) < period + 1:
        return None
    gains = 0.0
    losses = 0.0
    for i in range(1, period + 1):
        d = vals[i] - vals[i - 1]
        if d >= 0:
            gains += d
        else:
            losses += -d
    avg_gain = gains / period
    avg_loss = losses / period
    for i in range(period + 1, len(vals)):
        d = vals[i] - vals[i - 1]
        g = d if d > 0 else 0.0
        l = -d if d < 0 else 0.0
        avg_gain = (avg_gain * (period - 1) + g) / period
        avg_loss = (avg_loss * (period - 1) + l) / period
    if avg_loss == 0:
        return 100.0 if avg_gain > 0 else 50.0
    rs = avg_gain / avg_loss
    return 100.0 - (100.0 / (1.0 + rs))


def calc_relative_volume(candles, lookback=20):
    if len(candles) < lookback + 1:
        return None
    last_v = candles[-1].get("vol", 0.0) or 0.0
    prev = [c.get("vol", 0.0) for c in candles[-(lookback + 1):-1] if (c.get("vol", 0.0) or 0.0) > 0]
    if last_v <= 0 or len(prev) < max(5, lookback // 2):
        return None
    avg = sum(prev) / len(prev)
    if avg <= 0:
        return None
    return last_v / avg


def recent_rvol(candles, window=3, lookback=20):
    best = None
    for k in range(window):
        sub = candles[:len(candles) - k] if k else candles
        v = calc_relative_volume(sub, lookback)
        if v is not None and (best is None or v > best):
            best = v
    return best


def calc_adx(candles, period=14, with_prev=False):
    """Wilder ADX. (adx, +DI, -DI) dondurur; veri yetersizse None."""
    n = len(candles)
    if n < period * 2 + 2:
        return None
    tr_l, pdm_l, mdm_l = [], [], []
    for i in range(1, n):
        h, l = candles[i]["high"], candles[i]["low"]
        ph, pl, pc = candles[i - 1]["high"], candles[i - 1]["low"], candles[i - 1]["close"]
        up, dn = h - ph, pl - l
        pdm_l.append(up if (up > dn and up > 0) else 0.0)
        mdm_l.append(dn if (dn > up and dn > 0) else 0.0)
        tr_l.append(max(h - l, abs(h - pc), abs(l - pc)))

    def _dx(a, p, m):
        if a <= 0:
            return 0.0, 0.0, 0.0
        pdi = 100.0 * p / a
        mdi = 100.0 * m / a
        s = pdi + mdi
        return (100.0 * abs(pdi - mdi) / s if s > 0 else 0.0), pdi, mdi

    a_s = sum(tr_l[:period])
    p_s = sum(pdm_l[:period])
    m_s = sum(mdm_l[:period])
    dx0, pdi, mdi = _dx(a_s, p_s, m_s)
    dxs = [dx0]
    for i in range(period, len(tr_l)):
        a_s = a_s - a_s / period + tr_l[i]
        p_s = p_s - p_s / period + pdm_l[i]
        m_s = m_s - m_s / period + mdm_l[i]
        d, pdi, mdi = _dx(a_s, p_s, m_s)
        dxs.append(d)
    if len(dxs) < period:
        return None
    adx = sum(dxs[:period]) / period
    adx_vals = [adx]
    for d in dxs[period:]:
        adx = (adx * (period - 1) + d) / period
        adx_vals.append(adx)
    if with_prev:
        prev = adx_vals[-4] if len(adx_vals) >= 4 else adx_vals[0]
        return adx, pdi, mdi, prev
    return adx, pdi, mdi


def find_swings(candles, left=2, right=2):
    highs, lows = [], []
    n = len(candles)
    for i in range(left, n - right):
        win = candles[i - left:i + right + 1]
        if candles[i]["high"] >= max(c["high"] for c in win):
            highs.append((i, candles[i]["high"]))
        if candles[i]["low"] <= min(c["low"] for c in win):
            lows.append((i, candles[i]["low"]))
    return highs, lows


def detect_regime(candles, atr, price):
    closes = [c["close"] for c in candles]
    e20 = calc_ema(closes, 20)
    e50 = calc_ema(closes, 50)
    vol_pct = (atr / max(price, 1e-9)) * 100.0
    if vol_pct > 9.0:
        return "YÜKSEK VOLATİLİTE"
    if e20 and e50 and abs(e20 - e50) / max(price, 1e-9) * 100.0 >= 0.35:
        return "TREND"
    return "YATAY"


def tf_bias(closed):
    if len(closed) < 55:
        return "NEUTRAL"
    closes = [c["close"] for c in closed]
    e20 = calc_ema(closes, 20)
    e50 = calc_ema(closes, 50)
    if not e20 or not e50:
        return "NEUTRAL"
    px = closes[-1]
    highs, lows = find_swings(closed[-80:], 2, 2)
    hh = len(highs) >= 2 and highs[-1][1] > highs[-2][1]
    hl = len(lows) >= 2 and lows[-1][1] > lows[-2][1]
    lh = len(highs) >= 2 and highs[-1][1] < highs[-2][1]
    ll = len(lows) >= 2 and lows[-1][1] < lows[-2][1]
    if px > e50 and e20 > e50 and not (lh and ll):
        return "BULL"
    if px < e50 and e20 < e50 and not (hh and hl):
        return "BEAR"
    return "NEUTRAL"


