def _tf_hist_bonus(learn, tf):
    """Kapanan TF islem gecmisi biriktikce en basarili zaman dilimine hafif skor katki verir."""
    for row in ((learn or {}).get("tfs_table") or []):
        if row.get("name") == tf:
            tot = int(row.get("win", 0)) + int(row.get("loss", 0))
            if tot >= 8:
                net_r = float(row.get("net_r", 0.0))
                wr = float(row.get("wr", 50.0))
                if net_r > 1.0 and wr >= 55.0:
                    return 2
                if net_r < -1.5 and wr < 42.0:
                    return -2
    return 0


