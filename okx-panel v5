def _ema_slope_atr(vals, period, atr, back=3):
    """EMA'nin son `back` mumdaki degisimi (ATR cinsinden)."""
    if atr <= 0 or len(vals) < period + back + 1:
        return None
    e_now = calc_ema(vals, period)
    e_old = calc_ema(vals[:-back], period)
    if e_now is None or e_old is None:
        return None
    return (e_now - e_old) / atr


def _hca_ok(candles, is_long, n=14):
    """Heikin-Ashi (HCA): son 2 HA mumu yone uyumlu mu."""
    seg = candles[-(n + 8):]
    ha, p_o, p_c = [], None, None
    for c in seg:
        h_c = (c["open"] + c["high"] + c["low"] + c["close"]) / 4.0
        h_o = (c["open"] + c["close"]) / 2.0 if p_o is None else (p_o + p_c) / 2.0
        ha.append((h_o, h_c))
        p_o, p_c = h_o, h_c
    if len(ha) < 3:
        return False
    return all((h_c > h_o) if is_long else (h_c < h_o) for h_o, h_c in ha[-2:])


def _close_strength_ok(c, is_long, thr=0.55):
    """Kapanis gucu: mum yone uyumlu ve kapanis mumun ust/alt %45'inde."""
    rng = c["high"] - c["low"]
    if rng <= 0:
        return False
    if is_long:
        return c["close"] > c["open"] and (c["close"] - c["low"]) / rng >= thr
    return c["close"] < c["open"] and (c["high"] - c["close"]) / rng >= thr


def _equal_levels(candles, atr, is_long):
    """Uyumluluk sarmalayıcısı: yalnız EQH/EQL süpürme ve geri alma; breakout seçeneği yok."""
    event = _equal_sweep_event(candles, atr, is_long)
    return event.get("label") if event else None


def _recent_opposite_structure_break(candles, is_long):
    """Gecerli ters yapisal kirilimi yalnizca son kapanmis mumda arar; eski olaylar veto olmaz."""
    if len(candles) < 40:
        return None
    prior = candles[:-1]
    highs, lows = find_swings(prior[-85:], 2, 2)
    last = candles[-1]
    if is_long and lows and float(last["close"]) < float(lows[-1][1]):
        return {"side": "BEAR", "level": float(lows[-1][1]), "index": len(candles)-1, "ts": last["ts"]}
    if (not is_long) and highs and float(last["close"]) > float(highs[-1][1]):
        return {"side": "BULL", "level": float(highs[-1][1]), "index": len(candles)-1, "ts": last["ts"]}
    return None


def _fresh_bos_level(candles, atr, is_long, lookback=G_BOS_LOOKBACK):
    """Son `lookback` mum icinde ILK KEZ kapanisla kirilan yapi seviyesi. (seviye, kiran_mum_indeksi) veya None."""
    n = len(candles)
    if n < 40:
        return None
    hist = candles[:-lookback]
    seg = hist[-85:]
    highs, lows = find_swings(seg, 2, 2)
    swings = highs if is_long else lows
    if not swings:
        return None
    j, lvl = swings[-1]

    def beyond(c):
        return c["close"] > lvl if is_long else c["close"] < lvl

    if any(beyond(c) for c in seg[j + 1:]):     # kirilim daha eski
        return None
    for k in range(n - lookback, n):
        if beyond(candles[k]):
            return lvl, k
    return None


def _level_retest_ok(candles, atr, live_price, is_long, brk):
    """Kirilimdan sonra fiyat kirilan seviyeye geri dondu ve seviye tutuyor mu (_active_zones toleranslari)."""
    if not brk:
        return False
    lvl, k = brk
    after = candles[k + 1:]
    if not after:
        return False
    tol = atr * 0.40
    if is_long:
        return (any(c["low"] <= lvl + tol * 0.6 for c in after)
                and candles[-1]["close"] >= lvl - tol * 0.25
                and (lvl - tol * 0.85) <= live_price <= (lvl + tol * 1.35))
    return (any(c["high"] >= lvl - tol * 0.6 for c in after)
            and candles[-1]["close"] <= lvl + tol * 0.25
            and (lvl - tol * 1.35) <= live_price <= (lvl + tol * 0.85))


def _zone_retest_ok(candles, atr, zones, is_long, brk):
    """Kirilimdan SONRAKI bir mum gecerli bolgelerden birine geri dokundu mu."""
    if not brk:
        return False
    after = candles[brk[1] + 1:]
    tol = atr * 0.40 * 0.6
    if is_long:
        return any(c["low"] <= z[2] + tol for z in zones for c in after)
    return any(c["high"] >= z[1] - tol for z in zones for c in after)


def _ce_ok(candles, atr, live_price, is_long):
    """CE (%50 denge): son itki bacaginin orta noktasina geri cekilme."""
    seg = candles[-90:]
    m = len(seg)
    highs, lows = find_swings(seg, 2, 2)
    if not highs or not lows:
        return False
    if is_long:
        iH, pH = highs[-1]
        prior = [(i, p) for i, p in lows if i < iH]
        if not prior or iH < m - 40:
            return False
        pL = prior[-1][1]
    else:
        iL, pL = lows[-1]
        prior = [(i, p) for i, p in highs if i < iL]
        if not prior or iL < m - 40:
            return False
        pH = prior[-1][1]
    if pH - pL < 1.5 * atr:
        return False
    eq = (pH + pL) / 2.0
    return abs(live_price - eq) <= 0.5 * atr and pL < live_price < pH


def _group_hist_bonus(learn, codes):
    """Grup bazli canli sonuc biriktikce (>=20 islem) kotu grubu -3, iyi grubu +2 puanla ayarlar."""
    rows = {r.get("code"): r for r in ((learn or {}).get("groups_table") or [])}
    adj = []
    for c in codes:
        r = rows.get(c)
        if not r:
            continue
        tot = int(r.get("win", 0)) + int(r.get("loss", 0))
        if tot < 20:
            continue
        net_r, wr = float(r.get("net_r", 0.0)), float(r.get("wr", 50.0))
        if net_r > 1.0 and wr >= 50.0:
            adj.append(2)
        elif net_r < -2.0 and wr < 40.0:
            adj.append(-3)
    return int(round(sum(adj) / len(adj))) if adj else 0


