<script>
let currentTf = "4H";
let priceMode = "LAST";
let selectedPair = "BTC/USDT";
let leverageVal = 2;
let allItems = [];
let searchFilter = "";
let knownSignalIds = null;
let uiSyncedOnce = false;
let polling = false;
let failCount = 0;

let bellEnabled = true;
let radioEnabled = false;
let radioVol = 30;
let radioIdx = 0;

let audioCtx = null;
let synthGain = null;
let synthTimer = null;

const RADIO_STREAMS = [
  { name: "SomaFM Groove Salad", url: "https://ice1.somafm.com/groovesalad-128-mp3" },
  { name: "SomaFM Beat Blender", url: "https://ice1.somafm.com/beatblender-128-mp3" },
  { name: "SomaFM Def Con Radio", url: "https://ice1.somafm.com/defcon-128-mp3" },
  { name: "SomaFM PopTron", url: "https://ice1.somafm.com/poptron-128-mp3" },
  { name: "SomaFM Dub Step Beyond", url: "https://ice1.somafm.com/dubstep-128-mp3" },
];

const radioEl = document.getElementById("radioAudio");

function setText(el, txt) { if (el && el.textContent !== txt) el.textContent = txt; }
function esc(s) {
  return String(s).replace(/[&<>"']/g, ch => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
}

function savePrefsToServer() {
  const q = new URLSearchParams({
    bell: bellEnabled ? "1" : "0",
    radio: radioEnabled ? "1" : "0",
    vol: String(radioVol),
    ridx: String(radioIdx),
    lev: String(leverageVal),
  });
  fetch(`/api/prefs?${q.toString()}`, { method: "POST" }).catch(() => {});
}

function syncLeverageButtons() {
  document.querySelectorAll(".btn.lev-q").forEach(b => {
    b.classList.toggle("active", Number(b.dataset.lev) === Number(leverageVal));
  });
  const inp = document.getElementById("levInp");
  if (inp && document.activeElement !== inp) inp.value = String(leverageVal);
}

function setLeverage(v) {
  const n = Math.max(1, Math.min(125, parseInt(v, 10) || 2));
  leverageVal = n;
  syncLeverageButtons();
  savePrefsToServer();
  poll();
}

document.querySelectorAll(".btn.lev-q").forEach(b => {
  b.addEventListener("click", () => setLeverage(b.dataset.lev));
});

document.getElementById("levInp").addEventListener("change", (e) => setLeverage(e.target.value));

function ensureAudio() {
  if (!audioCtx) {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    audioCtx = new Ctx();
  }
  if (audioCtx.state === "suspended") {
    audioCtx.resume().catch(() => {});
  }
  return audioCtx;
}

function playLoudBell() {
  if (!bellEnabled) return;
  const ctx = ensureAudio();
  if (!ctx) return;
  const now = ctx.currentTime;
  const strikes = [0];
  strikes.forEach((offset) => {
    const freqs = [783.99, 1174.66];
    const master = ctx.createGain();
    master.gain.setValueAtTime(0.0005, now + offset);
    master.gain.linearRampToValueAtTime(0.11, now + offset + 0.035);
    master.gain.exponentialRampToValueAtTime(0.0005, now + offset + 0.45);
    master.connect(ctx.destination);

    freqs.forEach((f, idx) => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(f, now + offset);
      g.gain.setValueAtTime(idx === 0 ? 0.45 : 0.22, now + offset);
      g.connect(g.context.destination);
      osc.connect(g);
      osc.connect(master);
      osc.start(now + offset);
      osc.stop(now + offset + 0.48);
    });
  });
}

function startFallbackSynth() {
  const ctx = ensureAudio();
  if (!ctx) return;
  if (!synthGain) {
    synthGain = ctx.createGain();
    synthGain.connect(ctx.destination);
  }
  synthGain.gain.setTargetAtTime((radioVol / 100) * 0.18, ctx.currentTime, 0.1);
  const notes = [196.0, 246.94, 293.66, 329.63, 392.0, 293.66, 329.63, 440.0];
  let step = 0;

  function tick() {
    if (!radioEnabled || !audioCtx || !synthGain || !radioEl.paused) return;
    const t0 = audioCtx.currentTime;
    const freq = notes[step % notes.length] * (step % 8 === 7 ? 1.5 : 1.0);
    const osc = ctx.createOscillator();
    const env = ctx.createGain();
    osc.type = "triangle";
    osc.frequency.setValueAtTime(freq, t0);
    env.gain.setValueAtTime(0.0001, t0);
    env.gain.linearRampToValueAtTime(0.25, t0 + 0.015);
    env.gain.exponentialRampToValueAtTime(0.0008, t0 + 0.22);
    osc.connect(env);
    env.connect(synthGain);
    osc.start(t0);
    osc.stop(t0 + 0.23);
    step += 1;
    if (radioEnabled) synthTimer = setTimeout(tick, 220);
  }
  stopFallbackSynth();
  tick();
}

function stopFallbackSynth() {
  if (synthTimer) {
    clearTimeout(synthTimer);
    synthTimer = null;
  }
  if (synthGain && audioCtx) {
    synthGain.gain.setTargetAtTime(0.0001, audioCtx.currentTime, 0.06);
  }
}

function tuneRadio(index, autoPlay = true) {
  radioIdx = ((index % RADIO_STREAMS.length) + RADIO_STREAMS.length) % RADIO_STREAMS.length;
  const st = RADIO_STREAMS[radioIdx];
  radioEl.volume = Math.max(0, Math.min(1, radioVol / 100));
  radioEl.src = st.url;
  document.getElementById("radioBtn").textContent = radioEnabled ? `Radyo: ${st.name.split(" ")[0]}` : "Radyo: KAPALI";
  if (autoPlay && radioEnabled) {
    radioEl.play().then(() => {
      stopFallbackSynth();
    }).catch(() => {
      startFallbackSynth();
    });
  }
  savePrefsToServer();
}

radioEl.addEventListener("error", () => {
  if (!radioEnabled) return;
  const next = (radioIdx + 1) % RADIO_STREAMS.length;
  if (next !== radioIdx) {
    tuneRadio(next, true);
  } else {
    startFallbackSynth();
  }
});

document.getElementById("bellBtn").addEventListener("click", () => {
  ensureAudio();
  bellEnabled = !bellEnabled;
  const b = document.getElementById("bellBtn");
  b.textContent = bellEnabled ? "Çan: AÇIK" : "Çan: KAPALI";
  b.classList.toggle("active", bellEnabled);
  savePrefsToServer();
});

document.getElementById("bellTestBtn").addEventListener("click", () => {
  ensureAudio();
  const prev = bellEnabled;
  bellEnabled = true;
  playLoudBell();
  bellEnabled = prev;
});

document.getElementById("radioBtn").addEventListener("click", () => {
  ensureAudio();
  radioEnabled = !radioEnabled;
  const b = document.getElementById("radioBtn");
  b.classList.toggle("active", radioEnabled);
  if (radioEnabled) {
    tuneRadio(radioIdx, true);
  } else {
    b.textContent = "Radyo: KAPALI";
    radioEl.pause();
    stopFallbackSynth();
    savePrefsToServer();
  }
});

document.getElementById("radioNextBtn").addEventListener("click", () => {
  ensureAudio();
  if (!radioEnabled) radioEnabled = true;
  document.getElementById("radioBtn").classList.add("active");
  tuneRadio(radioIdx + 1, true);
});

document.getElementById("radioVol").addEventListener("input", (e) => {
  radioVol = Number(e.target.value);
  radioEl.volume = Math.max(0, Math.min(1, radioVol / 100));
  if (synthGain && audioCtx && radioEnabled) {
    synthGain.gain.setTargetAtTime((radioVol / 100) * 0.18, audioCtx.currentTime, 0.08);
  }
  savePrefsToServer();
});

let chart = null;
let candleSeries = null;
let lEntry = null, lTp1 = null, lTp2 = null, lTp3 = null, lSl = null;
let activeChartSignalId = "";
let chartKey = "", chartSetAt = 0, chartLastTs = 0, chartLen = 0;

function fmt(v) {
  if (v === null || v === undefined || isNaN(v)) return "VERİ YOK";
  const n = Number(v);
  if (n >= 1000) return n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  if (n >= 1) return n.toFixed(4);
  if (n >= 0.01) return n.toFixed(6);
  const d = Math.min(10, Math.max(6, 3 - Math.floor(Math.log10(Math.max(n, 1e-12)))));
  return n.toFixed(d);
}

function initChart() {
  const box = document.getElementById("chartBox");
  if (!window.LightweightCharts || !box) return;
  chart = LightweightCharts.createChart(box, {
    width: box.clientWidth,
    height: box.clientHeight,
    layout: { background: { color: "#000000" }, textColor: "#ffffff" },
    grid: {
      vertLines: { color: "rgba(255,255,255,0.06)" },
      horzLines: { color: "rgba(255,255,255,0.06)" },
    },
    rightPriceScale: { borderColor: "#262626" },
    timeScale: { borderColor: "#262626", timeVisible: true, secondsVisible: false },
  });
  candleSeries = chart.addCandlestickSeries({
    upColor: "#ffffff", downColor: "#404040",
    borderUpColor: "#ffffff", borderDownColor: "#525252",
    wickUpColor: "#ffffff", wickDownColor: "#737373",
    priceFormat: { type: "price", precision: 6, minMove: 0.000001 },
  });
  window.addEventListener("resize", () => {
    if (chart && box) chart.applyOptions({ width: box.clientWidth, height: box.clientHeight });
  });
}

function clearLines() {
  if (!candleSeries) return;
  [lEntry, lTp1, lTp2, lTp3, lSl].forEach(l => { if (l) candleSeries.removePriceLine(l); });
  lEntry = lTp1 = lTp2 = lTp3 = lSl = null;
  activeChartSignalId = "";
}

function renderChart(item, tf, sigs) {
  if (!candleSeries) initChart();
  if (!candleSeries || !item || !item.candles || !item.candles.length) return;
  const cs = item.candles;
  const last = cs[cs.length - 1];
  const sig = (sigs || []).find(s => s.pair === item.pair) || null;
  const stage = sig ? (sig.stage || 0) : 0;
  const sigKey = sig ? `${sig.id}:${sig.entry}:${sig.sl}:${sig.tp2}:${stage}` : "NONE";
  const key = `${item.pair}|${tf}|${item.price_label}`;
  const nowT = Date.now();
  const toBar = c => ({ time: Math.floor(c.ts / 1000), open: c.open, high: c.high, low: c.low, close: c.close });

  const canUpdate = key === chartKey && last.ts >= chartLastTs &&
    (cs.length === chartLen || cs.length === chartLen + 1) && (nowT - chartSetAt) < 15000;
  let done = false;
  if (canUpdate) {
    try { candleSeries.update(toBar(last)); done = true; } catch (e) { done = false; }
  }
  if (!done) {
    candleSeries.setData(cs.map(toBar));
    if (key !== chartKey && chart) chart.timeScale().fitContent();
    chartSetAt = nowT;
    chartKey = key;
  }
  chartLastTs = last.ts;
  chartLen = cs.length;

  if (sigKey !== activeChartSignalId) {
    clearLines();
    if (sig) {
      activeChartSignalId = sigKey;
      const slPrice = sig.sl;
      lEntry = candleSeries.createPriceLine({ price: sig.entry, color: "#ffffff", lineWidth: 1, lineStyle: 2, title: "GİRİŞ" });
      lTp1 = candleSeries.createPriceLine({ price: sig.tp1, color: "#e5e5e5", lineWidth: 1, lineStyle: 1, title: stage >= 1 ? "TP1 (%50) ✓" : "TP1 (%50)" });
      lTp2 = candleSeries.createPriceLine({ price: sig.tp2, color: "#ffffff", lineWidth: 1, lineStyle: 0, title: stage >= 2 ? "TP2 (%30) ✓" : "TP2 (%30)" });
      lTp3 = candleSeries.createPriceLine({ price: sig.tp3, color: "#d4d4d4", lineWidth: 1, lineStyle: 1, title: "TP3 (%20)" });
      lSl = candleSeries.createPriceLine({ price: slPrice, color: "#737373", lineWidth: 1, lineStyle: 2, title: stage >= 2 ? "TRAIL STOP (TP1)" : (stage ? "BE STOP" : "SL") });
    }
  }
}

let pairListKey = "";
function renderPairList() {
  const q = searchFilter.trim().toLowerCase();
  const filtered = q ? allItems.filter(it => it.pair.toLowerCase().includes(q)) : allItems;
  setText(document.getElementById("cntTxt"), `${filtered.length}/${allItems.length}`);
  const list = document.getElementById("pairList");
  const key = filtered.map(it => it.pair).join(",");
  if (key !== pairListKey) {
    pairListKey = key;
    const st = list.scrollTop;
    list.innerHTML = filtered.map(it => `
      <div class="row-item" data-pair="${esc(it.pair)}">
        <div><div class="pair">${esc(it.pair)}</div><div class="sub js-lbl"></div></div>
        <div class="right"><div class="px js-px"></div><span class="badge js-chg"></span></div>
      </div>`).join("");
    list.scrollTop = st;
  }
  const rows = list.children;
  filtered.forEach((it, i) => {
    const row = rows[i];
    if (!row) return;
    row.classList.toggle("active", it.pair === selectedPair);
