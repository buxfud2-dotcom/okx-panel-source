    if not b and mode != "LAST":
        b = STATE["last_prices"].get(sym)
        if b:
            lbl += " · LAST yedek"
    if not b:
        return {"price": fallback_px, "fresh": False, "label": lbl, "age_ms": 0}
    age_ms = max(0, now_m - b["ts_ms"])
    return {"price": b["price"], "fresh": (age_ms / 1000.0) <= SOFT_STALE_CRYPTO_SEC, "label": lbl, "age_ms": age_ms}


def _apply_price_to_candles(it, px, now_m):
    cs = it.get("candles")
    if not cs or px is None:
        return
    tf_ms = TF_SEC.get(it.get("tf", "4H"), 14400) * 1000
    last = cs[-1]
    if now_m >= last["ts"] + tf_ms:
        last["closed"] = True
        new_ts = last["ts"] + tf_ms * ((now_m - last["ts"]) // tf_ms)
        op = last["close"]
        cs.append({"ts": new_ts, "open": op, "high": max(op, px), "low": min(op, px),
                   "close": px, "vol": 0.0, "closed": False})
        if len(cs) > CANDLE_LIMIT:
            del cs[:len(cs) - CANDLE_LIMIT]
    else:
        last["close"] = px
        if px > last["high"]:
            last["high"] = px
        if px < last["low"]:
            last["low"] = px
    it["tick_ts_ms"] = now_m


