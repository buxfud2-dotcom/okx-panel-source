        ("G3 breakout RVOL 1.00", {"g3_min_rvol": 1.00}),
        ("G3 breakout RVOL 1.20", {"g3_min_rvol": 1.20}),
        ("G3 breakout RVOL 1.35", {"g3_min_rvol": 1.35}),
        ("G4 sweep RVOL 1.40", {"g4_min_rvol": 1.40}),
        ("G4 sweep RVOL 1.60", {"g4_min_rvol": 1.60}),
        ("G4 sweep RVOL 1.80", {"g4_min_rvol": 1.80}),
        ("G5 EQ sweep RVOL 0.75", {"g5_min_rvol": 0.75}),
        ("G5 EQ sweep RVOL 0.90", {"g5_min_rvol": 0.90}),
        ("G5 EQ sweep RVOL 1.05", {"g5_min_rvol": 1.05}),
