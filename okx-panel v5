    if (has_sweep or has_choch) and (len(zones) >= 2 or confirms >= 2):
        return f"A {'Sweep' if has_sweep else 'CHoCH'} + {z_lbl}", 10, confirms
    if has_bos and len(zones) >= 2 and confirms >= 2:
        return f"B BOS + {z_lbl}", 6, confirms
    return None, 0, confirms


