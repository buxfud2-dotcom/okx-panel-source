def compute_learning_profile(history):
    concept_stats = {}
    group_stats = {k: {"win": 0, "loss": 0, "net_r": 0.0} for k in GROUP_SIGNAL_CODES}
    layer_stats = {k: {"activations": 0, "win": 0, "loss": 0, "net_r": 0.0} for k in GROUP_LAYER_CODES}
    combo_stats = {}
    symbol_stats = {}
    tf_stats = {}
    side_stats = {}
    regime_stats = {}
    fail_reasons = {}

    closed_trades = sorted(
        (h for h in history if h.get("status") in ("WIN", "LOSS")),
        key=lambda h: int(h.get("closed_ts_ms") or h.get("created_ts_ms") or 0), reverse=True,
    )
    for t in closed_trades:
        won = t.get("status") == "WIN"
        sym = t.get("symbol", "?")
        tf = t.get("tf", "?")

        for d_map, key in ((symbol_stats, sym), (tf_stats, tf),
                           (side_stats, t.get("side", "?")),
                           (regime_stats, t.get("regime", "?"))):
            st = d_map.setdefault(key, {"win": 0, "loss": 0, "net_r": 0.0})
            if won:
                st["win"] += 1
            else:
                st["loss"] += 1
            st["net_r"] = round(st["net_r"] + float(t.get("pnl_r", 0.0)), 2)

        abcd_map = (t.get("abcd_groups") or {}) if t.get("grp_ver") == 3 else {}
        for g_code in GROUP_SIGNAL_CODES:
            if abcd_map.get(g_code):
                gs = group_stats[g_code]
                gs["win" if won else "loss"] += 1
                gs["net_r"] = round(gs["net_r"] + float(t.get("pnl_r", 0.0)), 2)
        for layer_code in GROUP_LAYER_CODES:
            if abcd_map.get(layer_code):
                ls = layer_stats[layer_code]
                ls["activations"] += 1
                ls["win" if won else "loss"] += 1
                ls["net_r"] = round(ls["net_r"] + float(t.get("pnl_r", 0.0)), 2)
        combo = t.get("abcd_code") if t.get("grp_ver") == 3 else None
        if combo:
            cb = combo_stats.setdefault(combo, {"win": 0, "loss": 0, "net_r": 0.0})
            cb["win" if won else "loss"] += 1
            cb["net_r"] = round(cb["net_r"] + float(t.get("pnl_r", 0.0)), 2)

        c_pairs = []
        for c_name in (t.get("concepts") or []):
            name = c_name.split(" ", 1)[1] if " " in c_name else c_name
            base_c = name.split(" ·")[0].strip()
            if base_c in MAIN_CONCEPTS:
                c_pairs.append((c_name, base_c))

        for base_c in {b for _, b in c_pairs}:
            cs = concept_stats.setdefault(base_c, {"win": 0, "loss": 0, "mult": 1.0})
            if won:
                cs["win"] += 1
            else:
                cs["loss"] += 1
        if not won:
            for c_name, _ in c_pairs:
                fail_reasons[c_name] = fail_reasons.get(c_name, 0) + 1

    concept_mults = {}
    for c_name, cs in concept_stats.items():
        tot = cs["win"] + cs["loss"]
        if tot >= 30:
            wr = cs["win"] / tot
            mult = max(0.90, min(1.10, 1.0 + (wr - 0.45) * 0.5))
        else:
            mult = 1.0
        cs["mult"] = round(mult, 2)
        concept_mults[c_name] = mult

    recent = closed_trades[:20]
    poor = False
    if len(recent) >= LEARN_MIN_CLOSED_TRADES:
        wr_recent = sum(1 for t in recent if t.get("status") == "WIN") / len(recent) * 100.0
        exp_recent = sum(float(t.get("pnl_r", 0.0)) for t in recent) / len(recent)
        poor = wr_recent < 45.0 or exp_recent < 0.0
    min_score = POOR_PERF_MIN_SCORE if poor else MIN_SCORE

    blocked = []

    total_wl = len(closed_trades)
    top_fails = sorted(fail_reasons.items(), key=lambda x: -x[1])[:5]

    def finalize_table(src, is_symbol=False):
        out = []
        for k, v in src.items():
            tot = v["win"] + v["loss"]
            wr = round(v["win"] / tot * 100.0, 1) if tot else 0.0
            lbl = swap_to_pair(k) if is_symbol else k
            out.append({"name": lbl, "win": v["win"], "loss": v["loss"], "wr": wr, "net_r": v.get("net_r", 0.0)})
        out.sort(key=lambda x: (-x["net_r"], -x["wr"]))
        return out

    groups_table = []
    for g_code in GROUP_SIGNAL_CODES:
        gs = group_stats[g_code]
        tot = gs["win"] + gs["loss"]
        groups_table.append({"code": g_code, "name": GROUP_LABELS[g_code], "win": gs["win"], "loss": gs["loss"],
                             "wr": round(gs["win"] / tot * 100.0, 1) if tot else 0.0, "net_r": gs["net_r"]})
    confluence_table = []
    for layer_code in GROUP_LAYER_CODES:
        ls = layer_stats[layer_code]
        n_layer = ls["win"] + ls["loss"]
        confluence_table.append({"code": layer_code, "name": GROUP_LABELS[layer_code],
                                 "activations": ls["activations"], "win": ls["win"], "loss": ls["loss"],
                                 "wr": round(ls["win"] / n_layer * 100.0, 1) if n_layer else 0.0,
                                 "net_r": ls["net_r"],
                                 "note": "Yalnızca bu katmanın eşlik ettiği ana grup işlemleridir; bağımsız strateji sonucu değildir."})
    combos_table = []
    for code, cb in combo_stats.items():
        tot = cb["win"] + cb["loss"]
        combos_table.append({"code": code, "win": cb["win"], "loss": cb["loss"],
                             "wr": round(cb["win"] / tot * 100.0, 1) if tot else 0.0, "net_r": cb["net_r"]})
    combos_table.sort(key=lambda x: (-x["net_r"], -x["wr"]))

    return {
        "min_score": min_score,
        "concept_mults": concept_mults,
        "groups_table": groups_table,
        "confluence_table": confluence_table,
        "combos_table": combos_table,
        "concepts_table": sorted(
            [{"name": k, **v, "wr": round(v["win"] / max(1, v["win"] + v["loss"]) * 100.0, 1)} for k, v in concept_stats.items()],
            key=lambda x: (-x["mult"], -x["wr"]),
        ),
        "symbols_table": finalize_table(symbol_stats, is_symbol=True),
        "tfs_table": finalize_table(tf_stats, is_symbol=False),
        "sides_table": finalize_table(side_stats, is_symbol=False),
        "regimes_table": finalize_table(regime_stats, is_symbol=False),
        "top_fail_reasons": [{"reason": r, "count": c} for r, c in top_fails],
        "blocked_symbols": [swap_to_pair(s) for s in blocked],
        "learned_trades": total_wl,
    }


def _bootstrap_confidence_intervals(values, samples=CI_BOOTSTRAP_SAMPLES):
    """Dairesel moving-block bootstrap; kisa zaman bagimliligini IID'den daha iyi korur."""
    vals = [float(x) for x in values]
    n = len(vals)
    if n < 2:
        return None
    rng = random.Random(20261126 + n)
    block = min(5, max(2, int(round(n ** 0.5))))
    net_samples, exp_samples = [], []
    for _ in range(max(100, int(samples))):
        draw = []
        while len(draw) < n:
            start = rng.randrange(n)
            for j in range(block):
                draw.append(vals[(start + j) % n])
                if len(draw) >= n:
                    break
        total = sum(draw)
        net_samples.append(total)
        exp_samples.append(total / n)
    net_samples.sort()
    exp_samples.sort()
    lo = int(0.025 * (len(net_samples) - 1))
    hi = int(0.975 * (len(net_samples) - 1))
    return {"net_r_95": [round(net_samples[lo], 2), round(net_samples[hi], 2)],
            "expectancy_r_95": [round(exp_samples[lo], 3), round(exp_samples[hi], 3)],
            "method": f"Dairesel moving-block bootstrap (blok={block}); parite korelasyonu/eşzamanlı portföy riski modellenmez"}

def _calc_metrics_from_trades(trades):
    if not trades:
        return {"trades": 0, "win_rate": 0.0, "profit_factor": 0.0,
                "max_drawdown_r": 0.0, "expectancy_r": 0.0, "avg_rr": 0.0,
                "net_r": 0.0, "sl_rate": None, "tp1_rate": None, "tp2_rate": None,
                "tp3_rate": None, "be_rate": None, "timeout_rate": None, "avg_cost_r": 0.0,
                "ci95": None, "sample_warning": "ÖRNEKLEM YOK"}
    ordered = sorted(trades, key=lambda t: int(t.get("ts", 0) or 0))
    vals = [float(t.get("net_r", 0.0)) for t in ordered]
    wins, losses = [x for x in vals if x > 0], [x for x in vals if x <= 0]
    gross_win, gross_loss = sum(wins), abs(sum(losses))
    eq = peak = max_dd = 0.0
    for value in vals:
        eq += value
        peak = max(peak, eq)
        max_dd = max(max_dd, peak - eq)
    avg_win = gross_win / len(wins) if wins else 0.0
    avg_loss = gross_loss / len(losses) if losses else 0.0
    payoff = avg_win / avg_loss if avg_loss > 0 else avg_win
    pf = gross_win / gross_loss if gross_loss > 0 else (99.0 if gross_win > 0 else 0.0)
    n = len(vals)
    return {
        "trades": n, "win_rate": round(len(wins) / n * 100.0, 1),
        "profit_factor": round(min(pf, 99.0), 2), "max_drawdown_r": round(max_dd, 2),
        "expectancy_r": round(sum(vals) / n, 3), "avg_rr": round(payoff, 2),
        "net_r": round(sum(vals), 2),
        "sl_rate": round(sum(1 for t in ordered if t.get("exit") == "SL") / n * 100.0, 1),
        "tp1_rate": round(sum(1 for t in ordered if int(t.get("stage_at_exit", 0)) >= 1) / n * 100.0, 1),
        "tp2_rate": round(sum(1 for t in ordered if int(t.get("stage_at_exit", 0)) >= 2) / n * 100.0, 1),
        "tp3_rate": round(sum(1 for t in ordered if t.get("exit") == "TP3") / n * 100.0, 1),
        "be_rate": round(sum(1 for t in ordered if t.get("exit") == "BE") / n * 100.0, 1),
        "timeout_rate": round(sum(1 for t in ordered if t.get("exit") == "TIMEOUT") / n * 100.0, 1),
        "avg_cost_r": round(sum(float(t.get("cost_r", 0.0)) for t in ordered) / n, 3),
        "ci95": _bootstrap_confidence_intervals(vals),
        "sample_warning": None if n >= CI_MIN_SAMPLE else f"ÖRNEKLEM AZ: {n}/{CI_MIN_SAMPLE} işlem; CI geniş ve kararsız olabilir.",
    }

def _bt_fetch(meta, tf):
    """Backtest icin genis tarihsel veri; HTF/BTC mumlari ana pencereyle ayni zamani kapsar."""
    ctx = CONTEXT_TFS[tf]
    sym_id = meta["id"]
    btc_id = "BTC-USDT-SWAP"
    primary_target = int(BACKTEST_CANDLES_BY_TF.get(tf, 4200))
    try:
        prim = [c for c in get_okx_history(sym_id, tf, primary_target) if c["closed"]]
        if len(prim) < 200:
            return {"error": f"Yeterli geçmiş mum yok: {len(prim)}"}
        primary_span_sec = len(prim) * TF_SEC[tf]
        ctx_data = {}
        for t in ctx:
            target = min(5000, max(200, int(primary_span_sec / TF_SEC[t]) + 200))
            ctx_data[t] = [c for c in get_okx_history(sym_id, t, target) if c["closed"]]
        btc_tf = BTC_REF_TF[tf]
        btc_target = min(5000, max(200, int(primary_span_sec / TF_SEC[btc_tf]) + 200))
        if sym_id != btc_id:
            cache_key = (btc_tf, btc_target)
            with BTC_HISTORY_LOCK:
                cached_btc = BTC_HISTORY_CACHE.get(cache_key)
                if cached_btc is None:
                    cached_btc = [c for c in get_okx_history(btc_id, btc_tf, btc_target) if c["closed"]]
                    BTC_HISTORY_CACHE[cache_key] = cached_btc
                btc = [dict(c) for c in cached_btc]
        else:
            btc = None
    except Exception as e:
        log.warning("Backtest veri alinamadi (%s %s): %s", sym_id, tf, e)
        return {"error": f"Geçmiş veri alınamadı: {e}"}

    btc_tf_ms = TF_SEC[BTC_REF_TF[tf]] * 1000
    return {
        "prim": prim, "ctx_data": ctx_data, "btc": btc,
        "ends": {t: [c["ts"] + TF_SEC[t] * 1000 for c in lst] for t, lst in ctx_data.items()},
        "btc_ends": [c["ts"] + btc_tf_ms for c in btc] if btc else [],
        "coverage": {
            "requested_primary": primary_target, "received_primary": len(prim),
            "first_ts": int(prim[0]["ts"]) if prim else None,
            "last_ts": int(prim[-1]["ts"]) if prim else None,
        },
    }

def _bt_apply_next_open_fill(sig, prim, signal_idx, tf):
    """Sinyal kapanışından sonra ilk yürütülebilir fiyat: sonraki mum açılışı + aleyhe kayma."""
    fill_idx = signal_idx + 1
    if fill_idx >= len(prim):
        return None
    side = sig.get("side")
    raw_open = float(prim[fill_idx].get("open") or 0.0)
    if raw_open <= 0:
        return None
    slip = BACKTEST_SLIPPAGE_PCT / 100.0
    fill_px = raw_open * (1.0 + slip if side == "LONG" else 1.0 - slip)
    atr_v = float(sig.get("atr_value") or 0.0)
    is_group_signal = int(sig.get("grp_ver", 0) or 0) >= 3
    chase_limit = MAX_CHASE_ATR if is_group_signal else LEGACY_MAX_CHASE_ATR
    if atr_v > 0 and abs(fill_px - float(sig["entry"])) > chase_limit * atr_v:
        return None
    blocked_flags = set(sig.get("blocked_by") or [])
    counterfactual = bool(sig.get("shadow_only") or "ALAN(ROOM)" in blocked_flags)
    if counterfactual:
        fixed = dict(sig)
        risk_new = (fill_px - float(sig["sl"])) if side == "LONG" else (float(sig["sl"]) - fill_px)
        if risk_new <= 0:
            return None
        sign = 1.0 if side == "LONG" else -1.0
        fixed["entry"] = rp(fill_px)
        fixed["sl_orig"] = fixed["sl"]
        fixed["tp1"], fixed["tp2"], fixed["tp3"] = (rp(fill_px + sign * risk_new * m) for m in TP_R)
        risk_pct = risk_new / fill_px * 100.0
        fixed["risk_pct"] = round(risk_pct, 3)
        fixed["cost_r"] = round(roundtrip_cost_pct(tf) / max(risk_pct, 1e-9), 3)
        fixed["backtest_shadow_counterfactual"] = True
        fixed["shadow_only"] = True
        fixed["shadow_reason"] = fixed.get("shadow_reason") or ("ALAN(ROOM)" if "ALAN(ROOM)" in blocked_flags else "RİSK_FİLTRESİ")
        # Room-only counterfactual still keeps the recalculated real obstacle information.
        room_price = fixed.get("room_price")
        if room_price is not None:
            gap = ((float(room_price) - fill_px) if side == "LONG" else (fill_px - float(room_price)))
            fixed["room_r"] = round(gap / risk_new, 2)
            fixed["pot_pct"] = round(min(max(0.0, gap) / max(fill_px, 1e-12) * 100.0,
                                          abs(float(fixed["tp3"]) - fill_px) / max(fill_px, 1e-12) * 100.0), 2)
    else:
        fixed = reanchor_signal(sig, fill_px)
        if not fixed:
            return None
    fixed["created_ts_ms"] = int(prim[fill_idx]["ts"])
    fixed["candle_ts"] = int(prim[fill_idx]["ts"])
    fixed["last_processed_candle_ts"] = int(prim[signal_idx]["ts"])
    fixed["backtest_fill"] = "NEXT_OPEN_PLUS_ADVERSE_SLIPPAGE"
    fixed["backtest_slippage_pct"] = BACKTEST_SLIPPAGE_PCT
    return fixed


def _bt_outcome(h, prim, i, tf="4H"):
    """Islemi i. mumdan itibaren ilerletir; kapanis mum indeksini dondurur (veri bittiyse None)."""
    exp_n = expire_candles_for_tf(tf)
    last_j = min(len(prim) - 1, i + exp_n)
    for j in range(i + 1, last_j + 1):
        c = prim[j]
        advance_trade(h, c["high"], c["low"])
        if h.get("status") != "BEKLIYOR":
            return j
    if i + exp_n >= len(prim):
        return None
    finish_trade(h, "TIMEOUT", prim[i + exp_n]["close"])
    return i + exp_n


def _bt_simulate(meta, tf, data, mode, collect_blocked=False, param_overrides=None):
    """Ayni veride simülasyon; OOS giriş mumuna göre etiketlenir ve sınırı aşan eğitim işlemleri purge edilir."""
    prim = data["prim"]
    ctx = CONTEXT_TFS[tf]
    ctx_data, ends = data["ctx_data"], data["ends"]
    btc, btc_ends = data["btc"], data["btc_ends"]
    tf_ms = TF_SEC[tf] * 1000
    btc_tf_ms = TF_SEC[BTC_REF_TF[tf]] * 1000
    learn_stub = {"concept_mults": {}, "min_score": (MIN_SCORE if mode == "groups" else LEGACY_MIN_SCORE),
                  "_param_overrides": dict(param_overrides or {})}
    cool = cooldown_candles(tf, mode)
    training_only = bool((param_overrides or {}).get("_training_only"))
    train_end_idx = len(prim) if training_only else int(len(prim) * 0.60)
    validation_end_idx = len(prim) if training_only else int(len(prim) * 0.80)
    oos_start_idx = validation_end_idx

    trades, blocked, last_blk = [], [], {}
    i = 205 if mode == "groups" else 100
    while i < len(prim) - 2:
        entry_idx = i + 1  # sinyal kapanışından sonraki ilk yürütülebilir mum
        close_ts = prim[i]["ts"] + tf_ms
        progress_ratio = entry_idx / max(1, len(prim) - 1)
        wf_fold = int(min(3, max(0, (progress_ratio - 0.40) / 0.10))) if (not training_only and 0.40 <= progress_ratio < 0.80) else None
        segment = "train" if entry_idx < train_end_idx else ("validation" if entry_idx < validation_end_idx else "oos")
        is_oos = (not training_only) and segment == "oos"
        is_validation = (not training_only) and segment == "validation"
        window = prim[max(0, i - CANDLE_LIMIT + 1): i + 1]
        cmap = {tf: window}
        for t in ctx:
            idx = bisect.bisect_right(ends[t], close_ts)
            cmap[t] = ctx_data[t][max(0, idx - CANDLE_LIMIT):idx]
        btc_bias = "NEUTRAL"
        if btc:
            bidx = bisect.bisect_right(btc_ends, close_ts)
            btc_bias = tf_bias(btc[max(0, bidx - CANDLE_LIMIT):bidx])
        diag = [] if collect_blocked else None
        sig = evaluate_signal_for_tf(meta, tf, cmap, window[-1]["close"], btc_bias, learn_stub,
                                     news=(False, "Backtest"), mode=mode, diag=diag)

        if diag:
            for ev in diag:
                if ev["stage"] != "setup" or not ev.get("cand"):
                    continue
                key = "+".join(sorted(ev["blocks"]))
                gk = (ev["side"], key)
                if i - last_blk.get(gk, -10 ** 9) < max(3, cool):
                    continue
                last_blk[gk] = i
                hb = _bt_apply_next_open_fill(dict(ev["cand"]), prim, i, tf)
                if hb is None:
                    continue
                end_shadow = _bt_outcome(hb, prim, i, tf=tf)
                if end_shadow is None:
                    continue
                shadow_segment = "train" if entry_idx < train_end_idx else ("validation" if entry_idx < validation_end_idx else "oos")
                shadow_oos = (not training_only) and shadow_segment == "oos"
                # İşlem bir dönem sınırını aşarsa iki dönemi de kirletmemek için rapordan çıkar.
                if not training_only and ((shadow_segment == "train" and end_shadow >= train_end_idx)
                                          or (shadow_segment == "validation" and end_shadow >= validation_end_idx)):
                    last_blk[gk] = end_shadow
                    continue
                blocked.append({
                    "net_r": hb["pnl_r"], "cost_r": hb.get("cost_r", 0.2), "exit": hb.get("exit_reason"),
                    "stage_at_exit": int(hb.get("stage", 0)),
                    "entry_ts": int(prim[entry_idx]["ts"]), "ts": int(prim[end_shadow]["ts"]),
                    "side": hb.get("side"), "regime": hb.get("regime"), "pair": meta.get("pair"),
                    "oos": shadow_oos, "segment": shadow_segment, "wf_fold": wf_fold,
                    "relax": list(hb.get("relaxed") or []),
                    "blocks": list(ev.get("blocks") or []),
                    "key": ev["blocks"][0] if len(ev["blocks"]) == 1 else "ÇOKLU",
                    "combo_key": "+".join(sorted(ev.get("blocks") or [])) or "Bilinmiyor",
                })

        if not sig:
            i += 1
            continue

        h = _bt_apply_next_open_fill(dict(sig), prim, i, tf)
        if h is None:
            i += 1
            continue
        end_j = _bt_outcome(h, prim, i, tf=tf)
        if end_j is None:
            break
        # Purge: eğitim/validation işlemi kendi döneminin sonrasına taşıyorsa iki döneme de yazılmaz.
        if not training_only and ((segment == "train" and end_j >= train_end_idx)
                                  or (segment == "validation" and end_j >= validation_end_idx)):
            i = max(end_j + 1, i + cool)
            continue
        matched = list(h.get("grp_matched") or [])
        trades.append({
            "net_r": h["pnl_r"], "cost_r": h.get("cost_r", 0.2), "exit": h.get("exit_reason"),
            "stage_at_exit": int(h.get("stage", 0)),
            "entry_ts": int(prim[entry_idx]["ts"]), "ts": int(prim[end_j]["ts"]),
            "side": h.get("side"), "regime": h.get("regime"), "pair": meta.get("pair"),
            "oos": is_oos, "segment": segment, "wf_fold": wf_fold,
            "relax": list(h.get("relaxed") or []),
            "groups": [g for g in matched if g in GROUP_SIGNAL_CODES],
            "confluence_layers": [g for g in matched if g in GROUP_LAYER_CODES],
        })
        i = max(end_j + 1, i + cool)
    return trades, blocked

def _metrics_pack(trades):
    ordered = sorted(trades, key=lambda t: int(t.get("ts", 0) or 0))
    overall = _calc_metrics_from_trades(ordered)
    if ordered and all(t.get("segment") in ("train", "validation", "oos") for t in ordered):
        train = [t for t in ordered if t.get("segment") == "train"]
        validation = [t for t in ordered if t.get("segment") == "validation"]
        test = [t for t in ordered if t.get("segment") == "oos"]
        split_method = ("Bar bazlı kronolojik %60 eğitim / %20 doğrulama / %20 kilitli OOS. "
                        "Eğitim ve doğrulama sınırlarını aşan işlemler purge edilir.")
    else:
        train = [t for t in ordered if not t.get("oos")]
        validation = []
        test = [t for t in ordered if t.get("oos")]
        split_method = "Eski kayıt uyumluluğu: oos etiketli işlemler ayrıldı; doğrulama segmenti mevcut değil."
    return {"overall": overall,
            "in_sample": _calc_metrics_from_trades(train),
            "validation": _calc_metrics_from_trades(validation),
            "out_of_sample": _calc_metrics_from_trades(test),
            "split_method": split_method,
            "train_trades": len(train), "validation_trades": len(validation), "oos_trades": len(test)}

def _group_metrics(trades, keyf):
    groups = {}
    for t in trades:
        for k in keyf(t):
            groups.setdefault(k, []).append(t)
    return {k: _calc_metrics_from_trades(v) for k, v in groups.items()}


def _bt_pack(meta, tf, data, leg, v3, blocked):
    prim = data["prim"]
    out = {
        "pair": meta["pair"], "tf": tf, "bars": len(prim),
        "cost_model_r": round((sum(t["cost_r"] for t in v3) / len(v3)) if v3 else 0.0, 2),
        "legacy": _metrics_pack(leg),
        "v3": {**_metrics_pack(v3), "relax": _group_metrics(v3, lambda t: t["relax"] or ["Esnetme yok"]),
               "groups": _group_metrics(v3, lambda t: t.get("groups") or ["Grupsuz"]),
               "confluence": _group_metrics(v3, lambda t: t.get("confluence_layers") or []),
               "sides": _group_metrics(v3, lambda t: [t.get("side") or "Bilinmiyor"]),
               "regimes": _group_metrics(v3, lambda t: [t.get("regime") or "Bilinmiyor"])},
        "blocked": _group_metrics(blocked, lambda t: [t["key"]]),
        "blocked_by_filter_including_combos": _group_metrics(blocked, lambda t: t.get("blocks") or ["Bilinmiyor"]),
        "blocked_single_filter_only": _group_metrics(blocked, lambda t: [t["combo_key"]] if len(t.get("blocks") or []) == 1 else []),
        "blocked_combinations": _group_metrics(blocked, lambda t: [t.get("combo_key", "Bilinmiyor")] if len(t.get("blocks") or []) > 1 else []),
        "walk_forward_method": "Kronolojik zaman dilimleri; sabit kural seti (adaptif model eğitimi değildir)",
    }
    wf = []
    for fold, m in sorted(_group_metrics(v3, lambda t: [str(t.get("wf_fold"))] if t.get("wf_fold") is not None else {}).items()):
        wf.append({"window": f"WF-{int(fold) + 1}", **m})
    out["overall"] = out["v3"]["overall"]
    out["out_of_sample"] = out["v3"]["out_of_sample"]
    out["walk_forward"] = wf
    out["walk_forward_method"] = (
        "4 kronolojik ileri pencere (ana mumların %40-%80 bölümü); her pencerede aynı sabit kurallar. "
        "Parametre optimizasyonu yapılmadığından bu, yeniden-eğitim yapan adaptif WF değildir."
    )
    out["oos_protocol"] = out["v3"].get("split_method")
    out["blocked_combinations"] = _group_metrics(blocked, lambda t: [t.get("combo_key", "Bilinmiyor")] if len(t.get("blocks") or []) > 1 else [])
    out["blocked_single_filter_only"] = _group_metrics(blocked, lambda t: [t.get("combo_key", "Bilinmiyor")] if len(t.get("blocks") or []) == 1 else [])
    return out

def _run_parameter_sensitivity(meta, tf, data, baseline_trades=None):
