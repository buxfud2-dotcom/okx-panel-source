class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def _json(self, obj, code=200):
        raw = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            raw = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
        elif path == "/api/state":
            self._json(get_snapshot())
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        parsed = urlparse(self.path)
        qs = parse_qs(parsed.query)
        if parsed.path == "/api/chart_tf":
            tf = qs.get("tf", [None])[0]
            changed = False
            with LOCK:
                if tf in TF_SEC:
                    changed = tf != STATE["tf"]
                    STATE["tf"] = tf
                    persist_ui_state_locked()
            if changed:
                threading.Thread(target=quick_refresh_selected, args=(tf,), daemon=True).start()
            WS_SYNC.set()
            self._json({"ok": True})
        elif parsed.path == "/api/scan":
            tf = qs.get("tf", [None])[0]
            changed = False
            with LOCK:
                if tf in TF_SEC:
                    changed = tf != STATE["tf"]
                    STATE["tf"] = tf
                    persist_ui_state_locked()
            if changed:
                threading.Thread(target=quick_refresh_selected, args=(tf,), daemon=True).start()
            WS_SYNC.set()
            WAKE.set()
            self._json({"ok": True})
        elif parsed.path == "/api/select":
            pair = qs.get("pair", ["BTC/USDT"])[0]
            with LOCK:
                STATE["selected_pair"] = pair
                persist_ui_state_locked()
            WS_SYNC.set()
            self._json({"ok": True})
        elif parsed.path == "/api/price_mode":
            mode = (qs.get("mode", ["LAST"])[0] or "LAST").upper()
            if mode in ("LAST", "MARK", "INDEX"):
                with LOCK:
                    STATE["price_mode"] = mode
                    persist_ui_state_locked()
            self._json({"ok": True})
        elif parsed.path == "/api/prefs":
            with LOCK:
                if "bell" in qs:
                    STATE["bell_enabled"] = qs["bell"][0] in ("1", "true", "True")
                if "radio" in qs:
                    STATE["radio_enabled"] = qs["radio"][0] in ("1", "true", "True")
                if "vol" in qs:
                    try:
                        STATE["radio_vol"] = max(0, min(100, int(qs["vol"][0])))
                    except Exception:
                        pass
                if "ridx" in qs:
                    try:
                        STATE["radio_idx"] = max(0, int(qs["ridx"][0]))
                    except Exception:
                        pass
                if "lev" in qs:
                    try:
                        STATE["leverage"] = max(1, min(125, int(qs["lev"][0])))
                    except Exception:
                        pass
                persist_ui_state_locked()
            self._json({"ok": True})
        elif parsed.path == "/api/backtest":
            with LOCK:
                pair = qs.get("pair", [STATE["selected_pair"]])[0]
                tf = qs.get("tf", [STATE["tf"]])[0]
            if tf not in TF_SEC:
                tf = "4H"
            meta = {"id": pair_to_swap(pair), "pair": swap_to_pair(pair_to_swap(pair))}
            res = run_walk_forward_backtest(meta, tf)
            with LOCK:
                STATE["backtest"] = res
            self._json({"ok": True, "backtest": res})
        elif parsed.path == "/api/backtest_multi":
            tf = qs.get("tf", [STATE["tf"]])[0]
            if tf not in ALL_SCAN_TFS:
                tf = "4H"
            raw_n = str(qs.get("n", ["all"])[0]).strip().lower()
            try:
                n = None if raw_n in ("", "all", "0", "none") else max(1, int(raw_n))
            except Exception:
                n = None
            with LOCK:
                running = bool((STATE.get("backtest_multi") or {}).get("running"))
                if not running:
                    STATE["backtest_multi"] = {"running": True, "done": 0,
                                                "total": len(STATE.get("crypto_pairs") or []) if n is None else n,
                                                "tf": tf, "result": None}
            if not running:
                threading.Thread(target=run_backtest_multi, args=(tf, n), daemon=True).start()
            self._json({"ok": True, "started": not running})
        elif parsed.path == "/api/clear_closed":
            with LOCK:
                STATE["closed_cleared_at_ms"] = now_ms()
                cur_hidden = set(STATE.get("closed_hidden_ids") or [])
                for idx_h, h in enumerate(STATE["history"]):
                    if h.get("status") in ("WIN", "LOSS"):
                        if not h.get("id"):
                            h["id"] = f"closed-{idx_h}-{int(h.get('closed_ts_ms') or h.get('created_ts_ms') or now_ms())}"
                        cur_hidden.add(str(h["id"]))
                STATE["closed_hidden_ids"] = list(cur_hidden)[-4000:]
                save_json_file(HISTORY_FILE, STATE["history"])
                persist_ui_state_locked()
            self._json({"ok": True, "hidden_count": len(STATE["closed_hidden_ids"])})
        elif parsed.path == "/api/reset_net_1x":
            with LOCK:
                wl_now = [h for h in STATE["history"] if h.get("status") in ("WIN", "LOSS")]
                STATE["net_1x_offset"] = round(
                    sum(_closed_trade_1x_pct_from_history(h)[0] for h in wl_now), 4
                )
                persist_ui_state_locked()
            self._json({"ok": True})
        else:
            self.send_response(404)
            self.end_headers()


