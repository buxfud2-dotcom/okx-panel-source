            "tested_parameters": ["MIN_STOP_ATR", "STOP_BUFFER_ATR", "MIN_SCORE", "G3 RVOL", "G4 RVOL", "G5 RVOL", "ROOM"]}

def run_walk_forward_backtest(meta, tf):
    """Tek parite: genis tarih, ayri kronolojik OOS, sabit-parametre WF ve duyarlilik raporu."""
    with BTC_HISTORY_LOCK:
        BTC_HISTORY_CACHE.clear()
    data = _bt_fetch(meta, tf)
    if "error" in data:
        return data
    leg, _ = _bt_simulate(meta, tf, data, "legacy")
    v3, blocked = _bt_simulate(meta, tf, data, "groups", collect_blocked=True)
    out = _bt_pack(meta, tf, data, leg, v3, blocked)
    out["coverage"] = data.get("coverage")
    out["sensitivity"] = _run_parameter_sensitivity(meta, tf, data, v3)
    return out

def run_backtest_multi(tf, n=None):
    """Tüm keşfedilmiş aktif SWAP sözleşmelerinde eski/yeni sistem A/B backtesti."""
    with BTC_HISTORY_LOCK:
        BTC_HISTORY_CACHE.clear()
    fresh_pairs, _ = discover_live_swap_pairs()
    pairs = sorted(set(fresh_pairs))
    if not pairs:
        with LOCK:
            STATE["backtest_multi"] = {
                "running": False, "done": 0, "total": 0, "tf": tf, "result": None,
                "error": "Güncel ve geçerli LAST fiyatı bulunan aktif SWAP sözleşmesi keşfedilemedi.",
                "discovery": dict(LAST_DISCOVERY_STATS),
            }
        return
    with LOCK:
        STATE["crypto_pairs"] = list(pairs)
    chosen = pairs if n is None or int(n) <= 0 else pairs[:int(n)]
    with LOCK:
        STATE["backtest_multi"] = {"running": True, "done": 0, "total": len(chosen), "tf": tf, "result": None}

    def work(sym):
        meta = {"id": sym, "pair": swap_to_pair(sym)}
        try:
            data = _bt_fetch(meta, tf)
            if "error" in data:
                return sym, None
            leg, _ = _bt_simulate(meta, tf, data, "legacy")
            v3, blk = _bt_simulate(meta, tf, data, "groups", collect_blocked=True)
            return sym, (leg, v3, blk)
        except Exception as e:
            log.warning("Multi backtest parite hatası (%s): %s", sym, e)
            return sym, None

    all_leg, all_v3, all_blk, rows, done, failed = [], [], [], [], 0, 0
    try:
        # Concurrency deliberately modest to respect OKX public REST rate limits.
        with ThreadPoolExecutor(max_workers=3) as pool:
            futures = [pool.submit(work, sym) for sym in chosen]
            for fut in as_completed(futures):
                sym, res = fut.result()
                done += 1
                if res:
                    leg, v3, blk = res
                    all_leg += leg
                    all_v3 += v3
                    all_blk += blk
                    rows.append({"pair": swap_to_pair(sym), "legacy_n": len(leg), "v3_n": len(v3),
                                 "legacy_net": round(sum(t["net_r"] for t in leg), 2),
                                 "v3_net": round(sum(t["net_r"] for t in v3), 2)})
                else:
                    failed += 1
                with LOCK:
                    STATE["backtest_multi"]["done"] = done
        for lst in (all_leg, all_v3, all_blk):
            lst.sort(key=lambda t: t["ts"])
        rows.sort(key=lambda r: -r["v3_net"])
        result = {
            "tf": tf, "pairs": len(rows), "requested_pairs": len(chosen), "failed_pairs": failed,
            "legacy": _metrics_pack(all_leg),
            "v3": {**_metrics_pack(all_v3),
                   "relax": _group_metrics(all_v3, lambda t: t.get("relax") or ["Esnetme yok"]),
                   "groups": _group_metrics(all_v3, lambda t: t.get("groups") or ["Grupsuz"]),
                   "confluence": _group_metrics(all_v3, lambda t: t.get("confluence_layers") or []),
                   "regimes": _group_metrics(all_v3, lambda t: [t.get("regime") or "Bilinmiyor"]),
                   "sides": _group_metrics(all_v3, lambda t: [t.get("side") or "Bilinmiyor"])},
            "blocked": _group_metrics(all_blk, lambda t: [t["key"]]),
            "blocked_combinations": _group_metrics(all_blk, lambda t: [t.get("combo_key", "Bilinmiyor")] if len(t.get("blocks") or []) > 1 else []),
            "blocked_single_filter_only": _group_metrics(all_blk, lambda t: [t.get("combo_key", "Bilinmiyor")] if len(t.get("blocks") or []) == 1 else []),
            "walk_forward": [
                {"window": f"WF-{i + 1}", **_calc_metrics_from_trades([t for t in all_v3 if t.get("wf_fold") == i])}
                for i in range(4) if any(t.get("wf_fold") == i for t in all_v3)
            ],
            "walk_forward_method": "4 kronolojik ileri pencere; sabit kural seti, adaptif yeniden eğitim yok.",
            "oos_pooling_method": "Her paritenin kendi mum dizisinde %60/%20/%20 kronolojik segment; ortak takvim kesiti değildir.",
            "portfolio_risk_note": "Havuzlanmış max-DD eşzamanlı pozisyon büyüklüğü ve pariteler arası korelasyonu tam portföy simülasyonu olarak modellemez.",
            "coverage": {"requested_primary": BACKTEST_CANDLES_BY_TF.get(tf), "requested_pairs": len(chosen),
                         "pairs_completed": len(rows), "pairs_failed": failed,
                         "universe": "Keşfedilen tüm aktif SWAP sözleşmeleri (geçerli ve güncel LAST fiyatı olanlar)",
                         "discovery": dict(LAST_DISCOVERY_STATS),
                         "universe_complete": not bool(LAST_DISCOVERY_STATS.get("using_fallback"))},
            "per_pair": rows,
        }
        with LOCK:
            STATE["backtest_multi"] = {"running": False, "done": done, "total": len(chosen), "tf": tf, "result": result}
    except Exception as e:
        log.exception("Multi backtest hatası")
        with LOCK:
            STATE["backtest_multi"] = {"running": False, "done": done, "total": len(chosen), "tf": tf,
                                       "result": None, "error": str(e)}

