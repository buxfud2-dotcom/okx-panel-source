def fetch_json(url, retries=2, timeout=8):
    last_err = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": "Mozilla/5.0", "Accept": "application/json,text/plain,*/*"},
            )
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            last_err = e
            if e.code == 429:
                time.sleep(1.0 * (attempt + 1))
            elif 400 <= e.code < 500:
                raise
            else:
                time.sleep(0.35 * (attempt + 1))
        except Exception as e:
            last_err = e
            time.sleep(0.35 * (attempt + 1))
    raise last_err


def _swap_vol_usdt(row, px):
    """OKX USDT-margined SWAP ticker'ındaki base-currency hacmini USDT notional'a çevirir."""
    try:
        vol_ccy = float(row.get("volCcy24h") or 0.0)
    except (TypeError, ValueError):
        vol_ccy = 0.0
    if vol_ccy > 0 and px > 0:
        return vol_ccy * px
    # vol24h sözleşme adedidir; ctVal bilinmeden USDT notional'a güvenle çevrilemez.
    return 0.0


def _market_cost_info_cached(inst_id, fallback_price=0.0, side="LONG", tf="4H"):
    """Sinyal adayı için OKX public orderbook + funding verisini önbellekli alır.

    Orderbook notional hesabı ancak sözleşme çarpanı/currency güvenle tanımlanabiliyorsa verilir.
    Funding maliyeti, elde tutma süresinin tahmini boyunca yalnızca ödeyen taraf için eklenir.
    """
    now = time.time()
    cache_key = (inst_id, side, tf)
    with MARKET_INFO_LOCK:
        cached = MARKET_INFO_CACHE.get(cache_key)
        if cached and now - cached.get("cached_at", 0.0) <= MARKET_INFO_TTL_SEC:
            return dict(cached)

    result = {
        "spread_pct": None, "book_depth_usdt": None, "book_depth_side": None,
        "funding_rate": None, "funding_interval_hours": 8.0,
        "funding_cost_pct": None, "market_data_source": "ESTIMATE",
        "book_source": "UNAVAILABLE", "funding_source": "ESTIMATE",
    }
    base_ccy = inst_id.split("-")[0] if "-" in inst_id else ""

    # Funding rate; instrument bazında ve cache ile çağrılır.
    try:
        fr = fetch_json(f"https://www.okx.com/api/v5/public/funding-rate?instId={inst_id}", retries=1, timeout=5)
        row = (fr.get("data") or [None])[0]
        if str(fr.get("code", "0")) == "0" and row:
            rate = float(row.get("fundingRate"))
            interval_h = 8.0
            try:
                t0 = int(row.get("fundingTime") or 0)
                t1 = int(row.get("nextFundingTime") or 0)
                if t0 > 0 and t1 > t0:
                    interval_h = max(1.0, min(24.0, (t1 - t0) / 3600000.0))
            except (TypeError, ValueError):
                pass
            hold_h = expire_candles_for_tf(tf) * TF_SEC.get(tf, 14400) / 3600.0 * 0.5
            payer_rate = max(0.0, rate if side == "LONG" else -rate)
            result.update({
                "funding_rate": rate,
                "funding_interval_hours": interval_h,
                "funding_cost_pct": payer_rate * 100.0 * hold_h / interval_h,
                "funding_source": "OKX_PUBLIC_FUNDING_RATE",
            })
    except Exception as e:
        log.debug("Funding verisi alınamadı (%s): %s", inst_id, e)

    # Orderbook + sözleşme değeri: doğru kontrat notional'ı hesaplanamazsa depth alanı boş kalır.
    try:
        book = fetch_json(f"https://www.okx.com/api/v5/market/books?instId={inst_id}&sz=5", retries=1, timeout=5)
        book_row = (book.get("data") or [None])[0]
        if str(book.get("code", "0")) == "0" and book_row:
            bids = book_row.get("bids") or []
            asks = book_row.get("asks") or []
            bid_px = float(bids[0][0]) if bids else 0.0
            ask_px = float(asks[0][0]) if asks else 0.0
            if bid_px > 0 and ask_px >= bid_px:
                mid = (bid_px + ask_px) / 2.0
                result["spread_pct"] = (ask_px - bid_px) / max(mid, 1e-12) * 100.0
            inst = fetch_json(f"https://www.okx.com/api/v5/public/instruments?instType=SWAP&instId={inst_id}", retries=1, timeout=5)
            meta = (inst.get("data") or [None])[0]
            if str(inst.get("code", "0")) == "0" and meta:
                ct_val = float(meta.get("ctVal") or 0.0)
                ct_ccy = str(meta.get("ctValCcy") or "").upper()
                quote_ccy = inst_id.split("-")[1].upper() if len(inst_id.split("-")) > 2 else "USDT"
                side_levels = asks if side == "LONG" else bids
                depth = 0.0
                valid = ct_val > 0 and bool(ct_ccy)
                for level in side_levels[:5]:
                    px_l, sz_l = float(level[0]), float(level[1])
                    if px_l <= 0 or sz_l <= 0:
                        continue
                    if ct_ccy == quote_ccy:
                        depth += sz_l * ct_val
                    elif ct_ccy == base_ccy.upper():
                        depth += sz_l * ct_val * px_l
                    else:
                        valid = False
                        break
                if valid:
                    result["book_depth_usdt"] = depth
                    result["book_depth_side"] = "ASK" if side == "LONG" else "BID"
                    result["book_source"] = "OKX_BOOK_TOP5_CONTRACT_CONVERTED"
    except Exception as e:
        log.debug("Orderbook derinliği alınamadı (%s): %s", inst_id, e)

    result["market_data_source"] = "OKX_PUBLIC" if result["funding_source"] != "ESTIMATE" or result["book_source"] != "UNAVAILABLE" else "ESTIMATE"
    result["cached_at"] = now
    with MARKET_INFO_LOCK:
        MARKET_INFO_CACHE[cache_key] = dict(result)
    return result


def discover_live_swap_pairs():
    """OKX SWAP (kaldiracli) tarafinda canli LAST fiyati ve guncel ts'si bulunan tum SWAP kontratlarini alir."""
    global LAST_DISCOVERY_STATS
    stats = {"total": 0, "eligible": 0, "excluded": 0, "invalid": 0,
             "stale": 0, "low_volume": 0, "missing_book": 0, "wide_spread": 0, "error": None}
    try:
        r = fetch_json("https://www.okx.com/api/v5/market/tickers?instType=SWAP", retries=2, timeout=12)
        if str(r.get("code", "0")) == "0":
            now_m = now_ms()
            max_age_ms = MAX_TICKER_AGE_SEC * 1000.0
            ranked = []
            rows = (r.get("data") or [])
            stats["total"] = len(rows)
            for row in rows:
                inst = (row.get("instId") or "").strip()
                if not inst.endswith("-SWAP") or row.get("last") in (None, ""):
                    stats["invalid"] += 1
                    continue
                try:
                    px = float(row["last"])
                    vol_usdt = _swap_vol_usdt(row, px)
                    ts_v = int(row.get("ts") or 0)
                    o24 = float(row.get("open24h") or 0.0)
                    bid_px = float(row.get("bidPx") or 0.0)
                    ask_px = float(row.get("askPx") or 0.0)
                    if px <= 0 or ts_v <= 0:
                        stats["invalid"] += 1
                        continue
                    if (now_m - ts_v) > max_age_ms or ts_v > now_m + 5000:
                        stats["stale"] += 1
                        continue
                    if MIN_VOL_USDT_24H > 0 and vol_usdt < MIN_VOL_USDT_24H:
                        stats["low_volume"] += 1
                        continue
                    # Bid/ask yoksa spread doğrulanamaz; bu kontratı sinyal evrenine alma.
                    if bid_px <= 0 or ask_px <= 0 or ask_px < bid_px:
                        stats["missing_book"] += 1
                        continue
                    mid_px = (ask_px + bid_px) / 2.0
                    spread_pct = ((ask_px - bid_px) / max(mid_px, 1e-12)) * 100.0
                    if spread_pct > MAX_SPREAD_PCT:
                        stats["wide_spread"] += 1
                        continue
                    ranked.append((vol_usdt, inst, px, ts_v, o24, spread_pct, bid_px, ask_px))
                except Exception:
                    stats["invalid"] += 1
                    continue
            ranked.sort(key=lambda x: -x[0])
            stats["eligible"] = len(ranked)
            stats["excluded"] = max(0, stats["total"] - stats["eligible"])
            LAST_DISCOVERY_STATS = dict(stats)
            if TOP_N_PAIRS is not None:
                ranked = ranked[:TOP_N_PAIRS]
            pairs = [x[1] for x in ranked]
            snap = {x[1]: {"price": x[2], "ts_ms": x[3], "open24h": x[4],
                           "vol_24h_usdt": x[0], "spread_pct": round(x[5], 4),
                           "bid_px": x[6], "ask_px": x[7]} for x in ranked}
            # API basarili olsa bile hicbir kontrat kalite filtresini gecmediyse fallback
            # listesini sinyal evreni gibi kullanma. BTC fiyatini baska coinden kopyalama.
            return pairs, snap
    except Exception as e:
        stats["error"] = str(e)
        LAST_DISCOVERY_STATS = dict(stats)
        log.warning("OKX SWAP parite listesi alinamadi, yedek liste kullanilacak: %s", e)
    return list(FALLBACK_CRYPTO_PAIRS), {}

def _parse_candle_rows(rows):
    out = []
    for r in rows:
        try:
            out.append({
                "ts": int(r[0]),
                "open": float(r[1]), "high": float(r[2]), "low": float(r[3]),
                "close": float(r[4]), "vol": float(r[5]),
                "closed": (r[8] == "1") if len(r) > 8 else True,
            })
        except Exception:
            continue
    return out


def get_okx_candles(inst_id, tf, limit=CANDLE_LIMIT):
    CANDLE_THROTTLE.wait()
    url = f"https://www.okx.com/api/v5/market/candles?instId={inst_id}&bar={tf}&limit={limit}"
    raw = fetch_json(url)
    if str(raw.get("code", "0")) != "0":
        raise RuntimeError(f"OKX mum hatası: {raw.get('msg')}")
    return _parse_candle_rows(list(reversed(raw.get("data") or [])))


def get_candles_cached(inst_id, tf):
    key = (inst_id, tf)
    now = time.time()
    with CACHE_LOCK:
        ent = CANDLE_CACHE.get(key)
    if ent and now - ent[0] < CACHE_TTL.get(tf, 60):
        return [dict(c) for c in ent[1]]
    try:
        cs = get_okx_candles(inst_id, tf)
    except Exception:
        if ent and now - ent[0] < CACHE_TTL.get(tf, 60) * 6:
            return [dict(c) for c in ent[1]]
        raise
    with CACHE_LOCK:
        CANDLE_CACHE[key] = (now, cs)
        if len(CANDLE_CACHE) > 5000:
            stale_keys = [k for k, v in CANDLE_CACHE.items() if now - v[0] > 3600]
            for k in stale_keys:
                CANDLE_CACHE.pop(k, None)
    return [dict(c) for c in cs]


def get_okx_history(inst_id, tf, total=900):
    out = []
    after = None
    while len(out) < total:
        CANDLE_THROTTLE.wait()
        url = f"https://www.okx.com/api/v5/market/history-candles?instId={inst_id}&bar={tf}&limit=100"
        if after:
            url += f"&after={after}"
        raw = fetch_json(url)
        if str(raw.get("code", "0")) != "0":
            raise RuntimeError(f"OKX geçmiş hatası: {raw.get('msg')}")
        rows = raw.get("data") or []
        if not rows:
            break
        out.extend(_parse_candle_rows(rows))
        after = rows[-1][0]
        if len(rows) < 100:
            break
    uniq = {c["ts"]: c for c in out}
    res = [uniq[k] for k in sorted(uniq)]
    return res[-total:]


def fetch_okx_rest_snapshot(need_set, with_mark_idx=True):
    """OKX SWAP LAST fiyatlarini ve istenirse MARK/INDEX fiyatlarini canli ts ile ceker."""
    last_map, mark_map, idx_map = {}, {}, {}
    now_m = now_ms()
    max_age_ms = MAX_TICKER_AGE_SEC * 1000.0
    try:
        r = fetch_json("https://www.okx.com/api/v5/market/tickers?instType=SWAP", retries=1, timeout=8)
        if str(r.get("code", "0")) == "0":
            for row in (r.get("data") or []):
                inst = row.get("instId")
                if inst in need_set and row.get("last") not in (None, ""):
                    ts_v = int(row.get("ts") or 0)
                    if ts_v > 0 and (now_m - ts_v) > max_age_ms:
                        continue
                    last_map[inst] = {"price": float(row["last"]), "ts_ms": ts_v if ts_v > 0 else now_m}
    except Exception:
        pass
    if with_mark_idx:
        try:
            r = fetch_json("https://www.okx.com/api/v5/public/mark-price?instType=SWAP", retries=1, timeout=6)
            if str(r.get("code", "0")) == "0":
                for row in (r.get("data") or []):
                    inst = row.get("instId") or ""
                    if inst in need_set and row.get("markPx") not in (None, ""):
                        mark_map[inst] = {"price": float(row["markPx"]), "ts_ms": now_m}
        except Exception:
            pass
        try:
            r = fetch_json("https://www.okx.com/api/v5/market/index-tickers?quoteCcy=USDT", retries=1, timeout=6)
            if str(r.get("code", "0")) == "0":
                by_base = {}
                for row in (r.get("data") or []):
                    idx_id = row.get("instId") or ""
                    if idx_id.endswith("-USDT") and row.get("idxPx") not in (None, ""):
                        by_base[idx_id[:-5]] = float(row["idxPx"])
                for inst in need_set:
                    base = inst[:-10] if inst.endswith("-USDT-SWAP") else (inst[:-5].split("-")[0] if inst.endswith("-SWAP") else "")
                    if base and base in by_base:
                        idx_map[inst] = {"price": by_base[base], "ts_ms": now_m}
        except Exception:
            pass
    return last_map, mark_map, idx_map


