def _has_valid_tp_sl(sig):
    """Sinyalin gecerli TP ve Stop Loss seviyelerine sahip olup olmadigini kontrol eder."""
    if not isinstance(sig, dict):
        return False
    side = (sig.get("side") or "").upper()
    try:
        entry = float(sig.get("entry") or 0.0)
        sl = float(sig.get("sl") or 0.0)
        tp1 = float(sig.get("tp1") or 0.0)
    except Exception:
        return False
    if entry <= 0 or sl <= 0 or tp1 <= 0:
        return False
    if side == "LONG":
        return sl < entry and tp1 > entry
    if side == "SHORT":
        return sl > entry and tp1 < entry
    return False


def _add_shadow_locked(sig, blocks):
    """Engellenen sinyali sanal islem olarak kaydeder (ayni sinyal id'si bir kez)."""
    sid = "S-" + sig["id"]
    ids = STATE["shadow_ids"]
    if sid in ids:
        return
    h = dict(sig)
    h.update({"id": sid, "shadow": True, "blocked_by": list(blocks), "status": "BEKLIYOR",
              "stage": 0, "pnl_r": 0.0, "created_ts_ms": now_ms()})
    STATE["shadow"].insert(0, h)
    ids.add(sid)
    if len(STATE["shadow"]) > SHADOW_LIMIT:
        for old in STATE["shadow"][SHADOW_LIMIT:]:
            ids.discard(old.get("id"))
        STATE["shadow"] = STATE["shadow"][:SHADOW_LIMIT]


def process_diag_locked(diag_all):
    """Tarama sirasinda biriken engelleme olaylarini isler (mum basina bir kez sayar)."""
    blocks = STATE["blocks"]
    for sym, events in diag_all:
        for ev in events or []:
            # Aynı mumdaki aynı olay tekrar sayılmaz; farklı filtre/grup olayları birbirini ezmez.
            blocks_key = "+".join(sorted(ev.get("blocks") or []))
            cand_id = (ev.get("cand") or {}).get("id", "")
            key = f"{sym}|{ev['tf']}|{ev['side']}|{ev.get('name')}|{blocks_key}|{cand_id}"
            ts = ev.get("ts")
            seen = SEEN_DIAG.get(key)
            if seen == ts:
                continue
            SEEN_DIAG[key] = ts
            if len(SEEN_DIAG) > 5000:
                for old_key in list(SEEN_DIAG)[:max(1, len(SEEN_DIAG) - 5000)]:
                    SEEN_DIAG.pop(old_key, None)
            blocks["seen_events"] = dict(SEEN_DIAG)
            blocks["events"] = blocks.get("events", 0) + 1
            f = blocks["funnel"]
            if ev["stage"] == "hard":
                f[ev["name"]] = f.get(ev["name"], 0) + 1
            for group_code, miss_list in (ev.get("missing_by_group") or {}).items():
                for missing_key in miss_list:
                    miss_name = f"{group_code}-eksik:{missing_key}"
                    f[miss_name] = f.get(miss_name, 0) + 1
            if ev["stage"] == "hard":
                continue
            sd = blocks["by_symbol"].setdefault(sym, {})
            for b in ev["blocks"]:
                sd[b] = sd.get(b, 0) + 1
            blocks["setups_blocked"] = blocks.get("setups_blocked", 0) + 1
            if ev.get("cand"):
                _add_shadow_locked(ev["cand"], ev["blocks"])


def compute_block_summary(blocks, shadow):
    filt = {}
    for sym, d in (blocks.get("by_symbol") or {}).items():
        for name, n in d.items():
            f = filt.setdefault(name, {"blocked": 0, "symbols": {}})
            f["blocked"] += n
            f["symbols"][sym] = f["symbols"].get(sym, 0) + n

    closed = [h for h in shadow if h.get("status") in ("WIN", "LOSS")]
    solo_perf, all_filter_perf, combo_perf = {}, {}, {}
    for h in closed:
        bs = sorted(set(h.get("blocked_by") or []))
        if not bs:
            bs = ["Bilinmiyor"]
        combo_key = "+".join(bs)
        combo_perf.setdefault(combo_key, []).append(h)
        if len(bs) == 1:
            solo_perf.setdefault(bs[0], []).append(h)
        for b in bs:
            all_filter_perf.setdefault(b, []).append(h)

    def metric_row(name, tr, blocked_n=0, top_symbols=None):
        n = len(tr)
        wins = sum(1 for h in tr if float(h.get("pnl_r", 0.0)) > 0)
        net = sum(float(h.get("pnl_r", 0.0)) for h in tr)
        sl_n = sum(1 for h in tr if h.get("exit_reason") == "SL")
        # Profit factor and drawdown are computed on ordered virtual outcomes.
        ordered = sorted(tr, key=lambda h: int(h.get("closed_ts_ms") or h.get("created_ts_ms") or 0))
        gains = sum(max(0.0, float(h.get("pnl_r", 0.0))) for h in ordered)
        losses = abs(sum(min(0.0, float(h.get("pnl_r", 0.0))) for h in ordered))
        eq = peak = dd = 0.0
        for h in ordered:
            eq += float(h.get("pnl_r", 0.0))
            peak = max(peak, eq)
            dd = max(dd, peak - eq)
        return {
            "filter": name, "blocked": blocked_n, "virt_n": n,
            "virt_wr": round(wins / n * 100.0, 1) if n else None,
            "virt_sl": round(sl_n / n * 100.0, 1) if n else None,
            "virt_net_r": round(net, 2), "virt_exp": round(net / n, 3) if n else None,
            "virt_pf": round(gains / losses, 2) if losses else (99.0 if gains > 0 else 0.0),
            "virt_max_dd_r": round(dd, 2),
            "top_symbols": top_symbols or [],
        }

    rows = []
    names = set(filt) | set(all_filter_perf)
    for name in names:
        tr = all_filter_perf.get(name, [])
        top = sorted((filt.get(name, {}).get("symbols") or {}).items(), key=lambda x: -x[1])[:3]
        rows.append(metric_row(name, tr, filt.get(name, {}).get("blocked", 0),
                               [f"{swap_to_pair(sym)} ({count})" for sym, count in top]))
    rows.sort(key=lambda r: (-r["virt_net_r"], -r["blocked"]))

    solo_rows = [metric_row(name, tr, filt.get(name, {}).get("blocked", 0))
                 for name, tr in solo_perf.items()]
    solo_rows.sort(key=lambda r: (-r["virt_net_r"], -r["blocked"]))
    combo_rows = [metric_row(name, tr) for name, tr in combo_perf.items() if "+" in name]
    combo_rows.sort(key=lambda r: (-r["virt_net_r"], -r["virt_n"]))

    sym_rows = []
    for sym, d in (blocks.get("by_symbol") or {}).items():
        tot = sum(d.values())
        top = sorted(d.items(), key=lambda x: -x[1])[:3]
        sym_rows.append({"pair": swap_to_pair(sym), "total": tot, "top": [f"{k} ({v})" for k, v in top]})
    sym_rows.sort(key=lambda r: -r["total"])
    funnel = sorted(((k, v) for k, v in (blocks.get("funnel") or {}).items()), key=lambda x: -x[1])[:12]
    return {
        "since": blocks.get("since"), "events": blocks.get("events", 0),
        "setups_blocked": blocks.get("setups_blocked", 0),
        "funnel": [{"name": k, "count": v} for k, v in funnel],
        "filters": rows[:12], "single_filter_only": solo_rows[:12],
        "combinations": combo_rows[:20], "symbols": sym_rows[:12],
        "open_shadow": sum(1 for h in shadow if h.get("status") == "BEKLIYOR"),
        "closed_shadow": len(closed),
    }


def update_shadows_and_summary():
    """Acik sanal islemleri mum verisiyle ilerletir (ag cagrilari kilit disinda), ozeti yeniler, kaydeder."""
    try:
        with LOCK:
            snaps = [(h["id"], dict(h)) for h in STATE["shadow"] if h.get("status") == "BEKLIYOR"]
        updates, cache, m_now = {}, {}, now_ms()
        for sid, hc in snaps:
            sym = pair_to_swap(hc.get("symbol", ""))
            k = (sym, hc.get("tf"))
            if k not in cache:
                try:
                    cache[k] = [c for c in get_candles_cached(sym, hc["tf"]) if c.get("closed")]
                except Exception as e:
                    log.debug("Sanal mum alinamadi (%s %s): %s", sym, hc.get("tf"), e)
                    cache[k] = []
            cs = cache[k]
            if not cs:
                continue
            catchup_resolve(hc, cs)
            if hc.get("status") == "BEKLIYOR":
                check_timeout(hc, cs[-1]["close"], m_now)
            if hc.get("status") != "BEKLIYOR" or int(hc.get("stage", 0)) > 0:
                updates[sid] = hc
        with LOCK:
            if updates:
                for h in STATE["shadow"]:
                    u = updates.get(h["id"])
                    if u:
                        h.update(u)
            STATE["block_summary"] = compute_block_summary(STATE["blocks"], STATE["shadow"])
            save_json_file(SHADOW_FILE, STATE["shadow"])
            save_json_file(BLOCK_FILE, STATE["blocks"])
    except Exception as e:
        log.warning("Engelleme analizi güncelleme hatası: %s", e)


