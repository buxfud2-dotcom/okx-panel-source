class SimpleOKXWebSocket:
    def __init__(self, url, on_message, on_status):
        self.url = url
        self.on_message = on_message
        self.on_status = on_status
        self._sock = None
        self._lock = threading.Lock()
        self._sub_lock = threading.Lock()
        self._apply_lock = threading.Lock()
        self._stop = threading.Event()
        self._desired = {}
        self._active = set()
        self._ready = False

    def _recv_exact(self, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = self._sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("WS bağlantısı kapandı")
            buf.extend(chunk)
        return bytes(buf)

    def _send_frame(self, opcode, payload_bytes):
        mask_key = os.urandom(4)
        masked = bytes(b ^ mask_key[i % 4] for i, b in enumerate(payload_bytes))
        header = bytearray()
        header.append(0x80 | (opcode & 0x0F))
        length = len(masked)
        if length < 126:
            header.append(0x80 | length)
        elif length < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", length))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", length))
        header.extend(mask_key)
        with self._lock:
            if not self._sock:
                raise ConnectionError("WS soketi açık değil")
            self._sock.sendall(bytes(header) + masked)

    def send_text(self, text):
        self._send_frame(0x1, text.encode("utf-8"))

    def send_pong(self, data=b""):
        self._send_frame(0xA, data)

    def set_desired(self, args):
        with self._sub_lock:
            self._desired = {(a["channel"], a["instId"]): a for a in args}
        threading.Thread(target=self._apply_diff, daemon=True).start()

    def subscribe(self, args):
        self.set_desired(args)

    def _apply_diff(self):
        with self._apply_lock:
            with self._sub_lock:
                if not self._ready:
                    return
                desired = dict(self._desired)
                active = set(self._active)
            to_add = [desired[k] for k in desired if k not in active]
            to_del = [{"channel": k[0], "instId": k[1]} for k in active if k not in desired]
            for op, items in (("unsubscribe", to_del), ("subscribe", to_add)):
                for i in range(0, len(items), 10):
                    chunk = items[i:i + 10]
                    try:
                        self.send_text(json.dumps({"op": op, "args": chunk}))
                    except Exception:
                        return
                    with self._sub_lock:
                        for a in chunk:
                            k = (a["channel"], a["instId"])
                            if op == "subscribe":
                                self._active.add(k)
                            else:
                                self._active.discard(k)
                    time.sleep(0.35)

    def _connect_and_handshake(self):
        parsed = urlparse(self.url)
        host = parsed.hostname
        port = parsed.port or 443
        path = parsed.path or "/"
        key = base64.b64encode(os.urandom(16)).decode("ascii")

        raw_sock = socket.create_connection((host, port), timeout=12)
        ctx = ssl.create_default_context()
        tls_sock = ctx.wrap_socket(raw_sock, server_hostname=host)
        tls_sock.settimeout(18.0)

        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        )
        tls_sock.sendall(req.encode("utf-8"))

        resp = b""
        while b"\r\n\r\n" not in resp:
            part = tls_sock.recv(1024)
            if not part:
                raise ConnectionError("WS handshake başarısız")
            resp += part
            if len(resp) > 16384:
                raise ConnectionError("WS handshake başlığı çok büyük")

        status_line = resp.split(b"\r\n", 1)[0].decode("latin1")
        if "101" not in status_line:
            raise ConnectionError(f"WS 101 bekleniyordu, gelen: {status_line}")

        expected_accept = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
        ).decode("ascii")
        if expected_accept.encode("ascii") not in resp:
            raise ConnectionError("WS Sec-WebSocket-Accept doğrulanamadı")

        with self._lock:
            self._sock = tls_sock

    def _read_frame(self):
        b1, b2 = self._recv_exact(2)
        opcode = b1 & 0x0F
        masked = bool(b2 & 0x80)
        length = b2 & 0x7F
        if length == 126:
            length = struct.unpack("!H", self._recv_exact(2))[0]
        elif length == 127:
            length = struct.unpack("!Q", self._recv_exact(8))[0]
        mask = self._recv_exact(4) if masked else b""
        payload = self._recv_exact(length) if length > 0 else b""
        if masked:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        return opcode, payload

    def run_forever(self):
        attempt = 0
        while not self._stop.is_set():
            try:
                attempt += 1
                self.on_status("BAĞLANIYOR", attempt)
                self._connect_and_handshake()
                with self._sub_lock:
                    self._active = set()
                    self._ready = True
                self.on_status("BAĞLI (WS)", 0)
                attempt = 0
                threading.Thread(target=self._apply_diff, daemon=True).start()

                last_ping = time.time()
                while not self._stop.is_set():
                    if time.time() - last_ping > 14:
                        try:
                            self.send_text("ping")
                        except Exception:
                            break
                        last_ping = time.time()

                    try:
                        opcode, payload = self._read_frame()
                    except socket.timeout:
                        continue

                    if opcode == 0x8:
                        break
                    elif opcode == 0x9:
                        self.send_pong(payload)
                    elif opcode == 0x1:
                        txt = payload.decode("utf-8", errors="ignore").strip()
                        if txt == "pong":
                            continue
                        try:
                            data = json.loads(txt)
                            self.on_message(data)
                        except Exception:
                            continue
            except Exception as e:
                log.warning("OKX WS koptu: %s", e)
            finally:
                with self._sub_lock:
                    self._ready = False
                    self._active = set()
                with self._lock:
                    if self._sock:
                        try:
                            self._sock.close()
                        except Exception:
                            pass
                        self._sock = None
            if not self._stop.is_set():
                self.on_status("YENİDEN BAĞLANIYOR (CANLI KORUNUYOR)", attempt)
                time.sleep(min(3.0, 0.5 * max(1, attempt)))

    def stop(self):
        self._stop.set()
        with self._lock:
            if self._sock:
                try:
                    self._sock.close()
                except Exception:
                    pass


