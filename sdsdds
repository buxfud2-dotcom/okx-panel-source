def backup_existing_json_files():
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    paths = (HISTORY_FILE, LEARN_FILE, UI_STATE_FILE, SHADOW_FILE, BLOCK_FILE)
    existing = [path for path in paths if os.path.isfile(path)]
    if not existing:
        return []
    os.makedirs(JSON_BACKUP_DIR, exist_ok=True)
    saved = []
    for path in existing:
        target = os.path.join(JSON_BACKUP_DIR, f"{stamp}_{os.path.basename(path)}")
        try:
            shutil.copy2(path, target)
            saved.append(target)
        except OSError as exc:
            log.warning("JSON yedeklenemedi (%s): %s", path, exc)
    return saved

