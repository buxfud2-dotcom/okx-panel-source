def on_ws_message(msg):
    if msg.get("event"):
        if msg.get("event") == "error":
            log.warning("OKX WS hata: %s", msg.get("msg"))
        return
    arg = msg.get("arg") or {}
    ch = arg.get("channel") or ""
    inst = arg.get("instId") or ""
    rows = msg.get("data") or []
    if not rows:
        return
    m_now = now_ms()
    with LOCK:
        valid = set(STATE["crypto_pairs"]) | {pair_to_swap(s) for s in _pending_symbols_locked()}
        tf_now = STATE["tf"]
        for row in rows:
            try:
                if ch == "tickers" and inst in valid and row.get("last") not in (None, ""):
                    ts_v = int(row.get("ts") or m_now)
                    STATE["last_prices"][inst] = {"price": float(row["last"]), "ts_ms": ts_v, "src": "ws"}
                    _refresh_item_price_locked(inst, m_now)
                elif ch == "mark-price" and inst in valid and row.get("markPx") not in (None, ""):
                    ts_v = int(row.get("ts") or m_now)
                    STATE["mark_prices"][inst] = {"price": float(row["markPx"]), "ts_ms": ts_v, "src": "ws"}
                    _refresh_item_price_locked(inst, m_now)
                elif ch == OKX_WS_BAR.get(tf_now) and inst in valid and isinstance(row, list) and len(row) >= 5:
                    c_ts = int(row[0])
                    c_o, c_h, c_l, c_c = float(row[1]), float(row[2]), float(row[3]), float(row[4])
                    c_v = float(row[5]) if len(row) > 5 else 0.0
                    c_closed = (row[8] == "1") if len(row) > 8 else False
                    for it in STATE["items"]:
                        if it["id"] == inst and it.get("candles") and it.get("tf") == tf_now:
                            cs = it["candles"]
                            if cs[-1]["ts"] == c_ts:
                                cs[-1]["open"] = c_o
                                cs[-1]["high"] = max(c_h, cs[-1]["high"] if not c_closed else c_h)
                                cs[-1]["low"] = min(c_l, cs[-1]["low"] if not c_closed else c_l)
                                cs[-1]["close"] = c_c
                                cs[-1]["vol"] = c_v
                                cs[-1]["closed"] = c_closed
                            elif c_ts > cs[-1]["ts"]:
                                cs[-1]["closed"] = True
                                cs.append({"ts": c_ts, "open": c_o, "high": c_h, "low": c_l, "close": c_c, "vol": c_v, "closed": c_closed})
                                it["candles"] = cs[-CANDLE_LIMIT:]
                            break
            except Exception as e:
                log.debug("WS satir isleme hatasi (%s): %s", inst, e)


