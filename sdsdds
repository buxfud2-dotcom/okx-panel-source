def price_loop():
    cycle = 0
    while True:
        t0 = time.time()
        try:
            with LOCK:
                need = set(STATE["crypto_pairs"]) | {pair_to_swap(s) for s in _pending_symbols_locked()}
            started = now_ms()
            last_m, mark_m, idx_m = fetch_okx_rest_snapshot(need, with_mark_idx=(cycle % 2 == 0))
            m_now = now_ms()
            with LOCK:
                for src_map, dst in ((last_m, STATE["last_prices"]), (mark_m, STATE["mark_prices"]), (idx_m, STATE["index_prices"])):
                    for k, v in src_map.items():
                        cur = dst.get(k)
                        if cur and cur.get("src") == "ws" and cur["ts_ms"] >= started:
                            continue
                        dst[k] = {"price": v["price"], "ts_ms": v.get("ts_ms", m_now), "src": "rest"}
                if mark_m:
                    STATE["swap_ok"] |= set(mark_m.keys())
                if idx_m:
                    STATE["idx_ok"] |= set(idx_m.keys())
                for it in STATE["items"]:
                    if it.get("candles"):
                        p = _crypto_active_price(it["id"], it["base_price"])
                        _apply_price_to_candles(it, p["price"], m_now)
                resolve_pending_live_locked(m_now)
            if cycle == 1:
                WS_SYNC.set()
        except Exception as e:
            log.warning("fiyat döngüsü: %s", e)
        cycle += 1
        time.sleep(max(0.3, PRICE_POLL_SEC - (time.time() - t0)))


