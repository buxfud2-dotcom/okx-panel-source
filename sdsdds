def swap_to_pair(inst_id):
    """BTC-USDT-SWAP -> BTC/USDT"""
    base = inst_id[:-5] if inst_id.endswith("-SWAP") else inst_id
    return base.replace("-", "/")


def pair_to_swap(pair_str):
    """BTC/USDT veya BTC-USDT -> BTC-USDT-SWAP"""
    clean = (pair_str or "").strip().upper().replace("/", "-")
    if clean.endswith("-SWAP"):
        return clean
    if not clean.endswith("-USDT"):
        clean = f"{clean}-USDT"
    return f"{clean}-SWAP"


def check_news_window():
    now_u = datetime.now(timezone.utc)
    if now_u.weekday() >= 5:
        return False, "Hafta sonu (veri takvimi yok)"
    cur = now_u.hour * 60 + now_u.minute
    for sh, sm, eh, em in HIGH_IMPACT_WINDOWS_UTC:
        if (sh * 60 + sm) <= cur <= (eh * 60 + em):
            return True, f"Yüksek Etkili Haber ({sh:02d}:{sm:02d}-{eh:02d}:{em:02d} UTC)"
    return False, "Normal Haber Akışı"


def load_json_file(path, default):
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                d = json.load(f)
            if type(d) is type(default):
                return d
        except Exception:
            log.exception("Dosya okunamadı: %s", path)
    return default


def save_json_file(path, data):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
        os.replace(tmp, path)
    except Exception:
        log.exception("Dosya kaydedilemedi: %s", path)


