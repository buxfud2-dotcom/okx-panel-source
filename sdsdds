def compute_ws_desired():
    with LOCK:
        tf = STATE["tf"]
        valid = set(STATE["crypto_pairs"])
        focus = []
        sel_sym = pair_to_swap(STATE["selected_pair"])
        if sel_sym in valid:
            focus.append(sel_sym)
        for h in STATE["history"]:
            sym_h = pair_to_swap(h.get("symbol", ""))
            if h.get("status") == "BEKLIYOR" and sym_h in valid and sym_h not in focus:
                focus.append(sym_h)
        focus = focus[:10]
    bar = OKX_WS_BAR.get(tf, "candle4H")
    pub_args, biz_args = [], []
    for s in focus:
        pub_args.append({"channel": "tickers", "instId": s})
        pub_args.append({"channel": "mark-price", "instId": s})
        biz_args.append({"channel": bar, "instId": s})
    return pub_args, biz_args


def ws_sync_loop():
    while True:
        WS_SYNC.wait(6.0)
        WS_SYNC.clear()
        try:
            pub_args, biz_args = compute_ws_desired()
            if WS_CLIENT:
                WS_CLIENT.set_desired(pub_args)
            if WS_CLIENT_BIZ:
                WS_CLIENT_BIZ.set_desired(biz_args)
