#  V3.0 GRUP MOTORU: sinyal uretimi (A-F)
# =====================================================================
def _evaluate_signal_groups(meta, tf, closed_map, live_price, btc_bias, learn, news=None, mode=None, diag=None):
    """Her grup kendi bilesenleri ayni yonde uyusursa sinyal uretir. Sinyal, uyusan grup(lar)in adini tasir."""
    mode = mode or "groups"
    params = (learn or {}).get("_param_overrides", {}) or {}
    choch_atr_min = float(params.get("choch_atr_min", G_CHOCH_ATR_MIN))
    e_min_rvol = float(params.get("e_min_rvol", G_E_MIN_RVOL))
    min_room_r = float(params.get("min_room_r", G_MIN_ROOM_R))
    min_pot_pct = float(params.get("min_pot_pct", G_MIN_POT_PCT))
    base_room_r = float(params.get("base_room_r", G_BASE_ROOM_R))
    group_defs = {k: tuple(v) for k, v in GROUP_DEFS.items()}
    b_omit = params.get("b_omit")
    if b_omit in group_defs.get("B", ()):
        group_defs["B"] = tuple(k for k in group_defs["B"] if k != b_omit)
    prim = closed_map.get(tf) or []
    if len(prim) < 80 or not live_price or live_price <= 0:
        return None
    atr = calc_atr(prim, 14)
    if atr <= 0:
        return None
    last = prim[-1]
    lts = last["ts"]
    regime = detect_regime(prim, atr, live_price)
    global_filter_blocks = []
    if regime == "YÜKSEK VOLATİLİTE":
        _note(diag, tf, None, "REJİM_VOLATİL", lts)
        global_filter_blocks.append("REJİM_VOLATİL")
    chase_blocked = abs(live_price - last["close"]) > MAX_CHASE_ATR * atr
    if chase_blocked:
        _note(diag, tf, None, "KOVALAMA", lts)

    adx_res = calc_adx(prim, 14, with_prev=True)
    if adx_res is None:
        return None
    adx, pdi, mdi, adx_prev = adx_res

    ctx_tfs = CONTEXT_TFS[tf]
    for t in ctx_tfs:
        if len(closed_map.get(t) or []) < 60:
            return None
    biases = {t: tf_bias(closed_map[t]) for t in ctx_tfs}
    prim_bias = tf_bias(prim)

    c_data = detect_concepts(prim, atr)
    trig = detect_triggers(prim, atr)
    closes = [c["close"] for c in prim]
    rsi = calc_rsi(closes, 14)
    e20, e50 = calc_ema(closes, 20), calc_ema(closes, 50)
    rv3 = recent_rvol(prim, 3)
    if rsi is None or rv3 is None:
        return None

    news_risk, news_label = news if news is not None else check_news_window()
    concept_mults = (learn or {}).get("concept_mults", {}) or {}
    min_score = max(MIN_SCORE, int((learn or {}).get("min_score", MIN_SCORE)))

    rng_hi = max(c["high"] for c in prim[-60:])
    rng_lo = min(c["low"] for c in prim[-60:])
    pos = (live_price - rng_lo) / max(rng_hi - rng_lo, 1e-12)

    sh_main, sl_main = find_swings(prim[-130:], 4, 4)
    obst_highs = [p for _, p in sh_main]
    obst_lows = [p for _, p in sl_main]
    if ctx_tfs:
        sh_c, sl_c = find_swings(closed_map[ctx_tfs[0]][-130:], 4, 4)
        obst_highs += [p for _, p in sh_c]
        obst_lows += [p for _, p in sl_c]

    best = None
    for side in ("LONG", "SHORT"):
        is_long = side == "LONG"
        side_filter_blocks = list(global_filter_blocks)
        if chase_blocked:
            side_filter_blocks.append("KOVALAMA")
        want = "BULL" if is_long else "BEAR"
        opp = "BEAR" if is_long else "BULL"

        # --- Ust zaman dilimi yonu (BTC bagimsiz) ---
        if ctx_tfs:
            htf_ok = biases[ctx_tfs[0]] == want and not any(biases[t] == opp for t in ctx_tfs[1:])
            htf_full = all(biases[t] == want for t in ctx_tfs)
            if not htf_ok:
                _note(diag, tf, side, "ÜST_TF_YÖN", lts)
                side_filter_blocks.append("ÜST_TF_YÖN")
        else:
            primary_ok = prim_bias == want and not (e50 and ((is_long and live_price < e50) or ((not is_long) and live_price > e50)))
            htf_full = bool(primary_ok)
            if not primary_ok:
                _note(diag, tf, side, "ÜST_TF_YÖN", lts)
                side_filter_blocks.append("ÜST_TF_YÖN")

        # --- Yönlü olaylar: her grup kendi zaman sırasını doğrular ---
        opposite_break_event = _recent_opposite_structure_break(prim, is_long)
        opp_bos = opposite_break_event is not None
        opp_choch = opposite_break_event is not None
        sweep_event = _sweep_reclaim_confirm(prim, atr, is_long)
        sweep = sweep_event is not None
        bos_brk = _fresh_bos_level(prim, atr, is_long)
        bos = bos_brk is not None
        choch_event = _strong_choch_event(prim, is_long, choch_atr_min)
        choch = choch_event is not None
        if (opp_choch or opp_bos) and not (choch or sweep):
            _note(diag, tf, side, "TERS_KIRILIM", lts)
            side_filter_blocks.append("TERS_KIRILIM")
        ict_items = []
        if choch:
            ict_items.append(("ICT · Güçlü CHoCH", 3))
        if bos:
            ict_items.append(("ICT · BOS", 2))
        if sweep:
            ict_items.append(("ICT · Sweep>Yapı Onayı", 3))

        # --- Bölgeler ---
        act, zone_visits = [], {}
        for z in _active_zones(_collect_zones(c_data, side), prim, atr, live_price, side):
            vv = _zone_prior_visits(prim, z[1], z[2], z[3])
            if vv <= ZONE_MAX_PRIOR_VISITS:
                act.append(z)
                zone_visits[z] = vv
        zt = {z[0] for z in act}

        di_ok = (pdi > mdi) if is_long else (mdi > pdi)
        ema_al = bool(e20 and e50 and ((is_long and live_price > e50 and e20 > e50)
                                       or ((not is_long) and live_price < e50 and e20 < e50)))
        strong_trend = bool(htf_full and prim_bias == want and adx >= ADX_STRONG and di_ok and ema_al)

        lo_r, hi_r = G_RSI_LONG if is_long else G_RSI_SHORT
        rsi_base = lo_r <= rsi <= hi_r
        rsi_ext = (not rsi_base) and strong_trend and (
            (is_long and hi_r < rsi <= RSI_STRONG_LONG_MAX) or ((not is_long) and RSI_STRONG_SHORT_MIN <= rsi < lo_r))
        eq_event = _equal_sweep_event(prim, atr, is_long)
        eq_lbl = eq_event.get("label") if eq_event else None
        eq_rvol = float(eq_event.get("rvol", 0.0)) if eq_event else 0.0

        ob_fvg = any(
            _z_overlap(z_ob, z_fvg, atr * 0.15)
            for z_ob in act if z_ob[0] == "Order Block"
            for z_fvg in act if z_fvg[0] == "FVG")
        bos_retest_event = _bos_retest_reaction(prim, atr, is_long, bos_brk) if bos_brk else None
        reaction = _reaction_candle(prim, len(prim) - 1, is_long)
        impulse_pullback_event = _impulse_pullback_reaction(prim, is_long, atr)
        first_test_event = _ob_fvg_first_test(prim, act, is_long)

        comp = {
            "sweep": bool(sweep), "sweep_confirm": bool(sweep_event),
            "bos": bool(bos_brk), "choch": bool(choch), "choch_strong": bool(choch_event),
            "zone": bool(zt),
            "snd_ob": bool(zt & {"Supply & Demand", "Order Block"}),
            "fvg_ob": bool(zt & {"FVG", "Order Block"}),
            "ob_fvg": bool(ob_fvg),
            "retest": bool(bos_retest_event),
            "reaction": bool(reaction),
            "first_test": bool(first_test_event),
            "impulse_pullback": bool(impulse_pullback_event),
            "ema20": bool(e20) and abs(live_price - e20) <= G_MAX_EMA20_DIST_ATR * atr,
            "eq": eq_event is not None,
            "rvol_e": eq_rvol >= e_min_rvol,
            "ce": _ce_ok(prim, atr, live_price, is_long),
            "rsi": rsi_base or rsi_ext,  # yalnızca skor/raporlama; A/C uygunluk şartı değildir
            "cs": _close_strength_ok(last, is_long),
            "adx": adx >= G_MIN_ADX,
            "rvol": rv3 >= G_MIN_RVOL,
            "rvol_d": rv3 >= G_D_MIN_RVOL,
            "room": False,
        }

        # --- Her grubun eksikleri ayrı kaydedilir; tek bir 'best miss' ile bilgi kaybetme ---
        pre, best_miss, missing_by_group = [], None, {}
        for code in GROUP_CODES:
            if regime == "YATAY" and code in GROUP_TREND_ONLY:
                continue
            miss = [k for k in group_defs[code] if k != "room" and not comp.get(k, False)]
            if not miss:
                pre.append(code)
            else:
                missing_by_group[code] = miss
                if best_miss is None or len(miss) < len(best_miss[1]):
                    best_miss = (code, miss)
        if not pre:
            _note(diag, tf, side, "GRUP_YOK", lts, extra={"missing_by_group": missing_by_group})
            continue

        # --- Onay mumu: yonde kapanis + kapanis mumun ilgili yarisinda ---
        if not _close_strength_ok(last, is_long, G_CONFIRM_CLOSE_THR):
            _note(diag, tf, side, "ONAY_MUMU", lts)
            side_filter_blocks.append("ONAY_MUMU")

        # --- Stop referansi: en iyi bolge, yoksa son 5 mum ---
        best_grp, zone_fresh = set(), False
        if act:
            tolz = atr * 0.15
            best_z, best_key = None, None
            for z in act:
                grp = {z2[0] for z2 in act if _z_overlap(z, z2, tolz)}
                key = (len(grp), -abs(live_price - (z[1] + z[2]) / 2.0))
                if best_key is None or key > best_key:
                    best_z, best_grp, best_key = z, grp, key
            group_zs = [z2 for z2 in act if _z_overlap(best_z, z2, tolz)]
            zlo = min(z2[1] for z2 in group_zs)
            zhi = max(z2[2] for z2 in group_zs)
            zone_fresh = any(zone_visits.get(z2, 1) == 0 for z2 in group_zs)
        else:
            zlo = min(c["low"] for c in prim[-5:])
            zhi = max(c["high"] for c in prim[-5:])

        blocks, relaxed = list(dict.fromkeys(side_filter_blocks)), []

        # RSI A/C uygunluk şartı veya gizli global veto değildir; yalnızca mevcut skor katkısı raporlanır.

        # Premium / Discount: donus gruplari (A, C, E) esnetilmez; devam gruplari (B, D, F) sinirli esner
        pd_fail = (is_long and pos > PD_LONG_MAX) or ((not is_long) and pos < PD_SHORT_MIN)
        pd_ext = False
        if pd_fail:
            ext_ok = (strong_trend or htf_full) and (
                (is_long and pos <= PD_STRONG_LONG_MAX) or ((not is_long) and pos >= PD_STRONG_SHORT_MIN))
            cont = [c for c in pre if c in GROUP_TREND_ONLY] if ext_ok else []
            if cont:
                pre = cont          # donus gruplari bu kurulumdan dusurulur
                pd_ext = True
                relaxed.append("P/D uzama")
            else:
                blocks.append("PREMIUM_DISCOUNT")

        # Stop / hedef / maliyet
        entry = live_price
        if is_long:
            sl_raw = min(zlo, min(c["low"] for c in prim[-5:])) - STOP_BUFFER_ATR * atr
            risk = entry - sl_raw
        else:
            sl_raw = max(zhi, max(c["high"] for c in prim[-5:])) + STOP_BUFFER_ATR * atr
            risk = sl_raw - entry
        if risk <= 0:
            _note(diag, tf, side, "STOP_GEÇERSİZ", lts)
            continue
        if risk > MAX_STOP_ATR * atr:
            sh = _risk_filter_shadow_candidate(meta, tf, side, entry, sl_raw, atr, last, "STOP_GENİŞ")
            _note(diag, tf, side, "STOP_GENİŞ", lts, blocks=["STOP_GENİŞ"] + blocks,
                  cand=sh, stage="setup")
            continue
        risk = max(risk, MIN_STOP_ATR * atr)
        sl = entry - risk if is_long else entry + risk
        if sl <= 0:
            continue
        risk_pct = risk / entry * 100.0
        if risk_pct > MAX_STOP_PCT.get(tf, 3.5):
            sh = _risk_filter_shadow_candidate(meta, tf, side, entry, sl, atr, last, "STOP_YÜZDE")
            _note(diag, tf, side, "STOP_YÜZDE", lts, blocks=["STOP_YÜZDE"] + blocks,
                  cand=sh, stage="setup")
            continue
        cost_r = roundtrip_cost_pct(tf) / max(risk_pct, 1e-9)
        if cost_r > MAX_COST_R:
            blocks.append("MALİYET")
        sgn = 1.0 if is_long else -1.0
        tp1, tp2, tp3 = (entry + sgn * risk * m for m in TP_R)
        if min(tp1, tp2, tp3) <= 0:
            continue

        room_price = None
        if is_long:
            above = [p for p in obst_highs if p > entry + 0.05 * atr]
            if above:
                room_price = min(above)
                room_r = (room_price - entry) / risk
                swing_move_pct = (room_price - entry) / entry * 100.0
            else:
                room_r, swing_move_pct = None, None
        else:
            below = [p for p in obst_lows if p < entry - 0.05 * atr]
            if below:
                room_price = max(below)
                room_r = (entry - room_price) / risk
                swing_move_pct = (entry - room_price) / entry * 100.0
            else:
                room_r, swing_move_pct = None, None
        tp3_move_pct = abs(tp3 - entry) / max(entry, 1e-9) * 100.0
        pot_pct = min(swing_move_pct, tp3_move_pct) if swing_move_pct is not None else None

        # Alan bilinmiyorsa uydurma potansiyel üretme. O durumda A/C/E taban alanı da doğrulanamaz.
        room_full = room_r is not None and room_r >= min_room_r and pot_pct is not None and pot_pct >= min_pot_pct
        room_base = room_r is not None and room_r >= base_room_r
        matched = [c for c in pre if (room_full if "room" in group_defs[c] else room_base)]
        if not matched:
            blocks.append("ALAN(ROOM)")
            matched = list(pre)
        comp["room"] = room_full

        rsi_used = bool(rsi_ext and any("rsi" in group_defs[c] for c in matched))
        if rsi_used:
            relaxed.append("RSI uzama")

        short_z = {"Order Block": "OB", "FVG": "FVG", "Supply & Demand": "S&D"}

        def zlbl(*names):
            return "/".join(short_z[g] for g in names if g in zt) or "Bölge"

        lbl = {
            "sweep": "Sweep", "sweep_confirm": "Sweep>Yapı Onayı",
            "bos": "BOS", "choch": "CHoCH", "choch_strong": f"CHoCH {choch_event.get('body_atr', 0):.2f} ATR" if choch_event else "CHoCH",
            "zone": zlbl("Order Block", "FVG", "Supply & Demand"),
            "snd_ob": zlbl("Supply & Demand", "Order Block"),
            "fvg_ob": zlbl("FVG", "Order Block"),
            "ob_fvg": "OB+FVG Çakışma",
            "retest": "BOS Retest", "reaction": "Tepki Mumu",
            "first_test": "OB+FVG İlk Test", "impulse_pullback": "Hacimli İtki+Düşük Hacimli Düzeltme",
            "ema20": "EMA20 Yakın",
            "eq": eq_lbl or "EQ Süpürme", "rvol_e": f"Sweep RVol {eq_rvol:.2f}x",
            "ce": "CE 50%", "rsi": f"RSI {rsi:.0f}", "cs": "Kapanış Gücü",
            "adx": f"ADX {adx:.0f}", "rvol": f"RVol {rv3:.2f}x", "rvol_d": f"RVol {rv3:.2f}x",
            "room": f"Alan {room_r:.1f}R" if room_r is not None else "Alan bilinmiyor",
        }
        abcd_groups = {c: [lbl[k] for k in group_defs[c]] for c in matched}
        code_str = "".join(matched)

        # ---------------- PUANLAMA ----------------
        sweet = (44.0 <= rsi <= 62.0) if is_long else (38.0 <= rsi <= 56.0)
        deep = (pos <= 0.35) if is_long else (pos >= 0.65)
        score = 60.0 + min(20, 14 + 3 * (len(matched) - 1))
        score += min(8, 4 * min(2, max(0, len(best_grp) - 1)) + (2 if zone_fresh else 0))
        htf_pts = ((6 if len(ctx_tfs) >= 2 else 4) if htf_full else 3)
        adx_pts = 4 if adx >= 30 else (3 if adx >= ADX_STRONG else (1 if adx >= MIN_ADX else 0))
        score += min(12, htf_pts + adx_pts + (2 if di_ok else 0))
        score += 4 if rv3 >= 1.5 else (3 if rv3 >= 1.25 else 1)
        rsi_score_points = 2 if sweet else 0
        deep_score_points = 2 if deep else 0
        score += min(3, rsi_score_points + deep_score_points)
        score += 4 if (room_r is not None and pot_pct is not None and room_r >= 3.5 and pot_pct >= 3.5) else (2 if room_r is not None and room_r >= 2.6 else 0)
        if rsi_used:
            score -= 3
        if pd_ext:
            score -= 2
        groups = set(best_grp) | ({"ICT"} if ict_items else set())
        if groups:
            mults = [concept_mults.get(g, 1.0) for g in groups]
            score += round((sum(mults) / len(mults) - 1.0) * 16)
        score += _tf_hist_bonus(learn, tf)
        score += _group_hist_bonus(learn, matched)
        if news_risk:
            score -= 6
        if risk / atr > 2.0:
            score -= 2
        if regime == "YATAY":
            score -= 2
        final_score = int(max(0, min(MAX_SCORE_CAP, round(score))))
        if final_score < min_score:
            blocks.append("SKOR")

        if blocks and diag is None:
            continue

        scen_label = f"Grup {code_str}"
        labels = [f"{tf} {scen_label}"]
        labels += [f"Grup {c} ✓ {'+'.join(abcd_groups[c])}" for c in matched]
        labels += [f"{tf} {g}" for g in MAIN_CONCEPTS if g in best_grp]
        labels += [f"{tf} {n}" for n, _ in ict_items]
        if ctx_tfs:
            labels += [f"HTF {t} {'↑' if biases[t] == 'BULL' else ('↓' if biases[t] == 'BEAR' else '→')}" for t in ctx_tfs]
        htf_txt = " / ".join(
            f"{t} {'yükseliş' if b == 'BULL' else ('düşüş' if b == 'BEAR' else 'nötr')}" for t, b in biases.items()
        ) if ctx_tfs else f"{tf} trend uyumlu"
        grp_txt = " | ".join(f"Grup {c} ({GROUP_SHORT[c]}): {'+'.join(abcd_groups[c])}" for c in matched)
        relax_txt = (f" Esnetilen koşul: {', '.join(relaxed)} (güçlü trend/yapı teyidiyle)." if relaxed else "")
        ai_reason = (
            f"{meta['pair']} SWAP ({tf} · {scen_label}) {side} [BTC Bağımsız]: üst TF {htf_txt}. "
            f"{grp_txt}. "
            f"Hedef yolunda {('~' + format(room_r, '.1f') + 'R (~%' + format(pot_pct, '.1f') + ') alan') if room_r is not None and pot_pct is not None else 'doğrulanmış engel alanı bilinmiyor'}. "
            f"Stop yapı arkasında (%{risk_pct:.2f}), tahmini maliyet {cost_r:.2f}R.{relax_txt} {news_label}."
        )
        invalidation = (
            f"Fiyat {rp(sl)} altında kapanış/temas yaparsa geçersizdir." if is_long
            else f"Fiyat {rp(sl)} üzerinde kapanış/temas yaparsa geçersizdir."
        )

        now_local = datetime.now()
        cand = {
            "id": f"{meta['id']}-{tf}-{last['ts']}-{side}",
            "symbol": meta["id"],
            "pair": meta["pair"],
            "tf": tf,
            "tf_chain": f"Oto-TF ({tf}) · {scen_label} · Üst TF: {', '.join(ctx_tfs) if ctx_tfs else tf}",
            "side": side,
            "entry": rp(entry), "sl": rp(sl), "sl_orig": rp(sl),
            "tp1": rp(tp1), "tp2": rp(tp2), "tp3": rp(tp3),
            "rr": TP_R[1],
            "rr1": TP_R[0], "rr2": TP_R[1],
            "rr_levels": {"tp1": TP_R[0], "tp2": TP_R[1], "tp3": TP_R[2]},
            "risk_pct": round(risk_pct, 3),
            "cost_r": round(cost_r, 3),
            "room_r": round(room_r, 2) if room_r is not None else None,
            "pot_pct": round(pot_pct, 2) if pot_pct is not None else None,
            "room_price": rp(room_price) if room_price is not None else None,
            "atr_value": rp(atr),
            "event_times": {
                "sweep_ts": sweep_event.get("sweep_ts") if sweep_event else None,
                "sweep_confirm_ts": sweep_event.get("confirm_ts") if sweep_event else None,
                "choch_ts": choch_event.get("ts") if choch_event else None,
                "bos_ts": bos_retest_event.get("bos_ts") if bos_retest_event else None,
                "retest_ts": bos_retest_event.get("retest_ts") if bos_retest_event else None,
                "reaction_ts": last.get("ts") if reaction else None,
                "eq_sweep_ts": eq_event.get("ts") if eq_event else None,
                "first_zone_test_ts": first_test_event.get("touch_ts") if first_test_event else None,
            },
            "adx": round(adx, 1),
            "rsi": round(rsi, 1),
            "indicator_contributions": {
                "rsi_score_points_raw": rsi_score_points,
                "deep_location_score_points_raw": deep_score_points,
                "adx_score_points": adx_pts,
                "rvol_score_points": 4 if rv3 >= 1.5 else (3 if rv3 >= 1.25 else 1),
                "note": "RSI/ADX A-F uygunluk engeli değildir; mevcut ortak skora katkıları şeffaftır."
            },
            "score": final_score,
            "confirmations": len(matched) + len(groups),
            "abcd_groups": abcd_groups,
            "abcd_code": code_str,
            "grp_matched": list(matched),
            "missing_by_group": {k: list(v) for k, v in missing_by_group.items()},
            "grp_ver": 2,
            "concepts": list(dict.fromkeys(labels))[:16],
            "regime": regime,
            "ai_reason": ai_reason,
            "invalidation": invalidation,
            "validity_status": "GEÇERLİ",
            "time": now_local.strftime("%H:%M:%S"),
            "date_time": now_local.strftime("%d.%m.%Y %H:%M:%S"),
            "created_ts_ms": now_ms(),
            "candle_ts": last["ts"],
            "last_processed_candle_ts": last["ts"],
            "status": "BEKLIYOR",
            "stage": 0,
            "pnl_r": 0.0,
            "mode": mode,
            "relaxed": relaxed,
            "strong_trend": strong_trend,
        }
        if blocks:
            shadow_ok = not (blocks == ["SKOR"] and final_score < min_score - SHADOW_MIN_SCORE_GAP)
            cand["blocked_by"] = list(blocks)
            _note(diag, tf, side, "SOFT", lts, blocks=blocks, cand=(cand if shadow_ok else None), stage="setup")
            continue
        if not best or _cand_priority(cand) > _cand_priority(best):
            best = cand
    return best

def _candidate_expected_net_r(sig, learn, min_group_n=20, prior_n=30):
    """Yalnız yeterli örneklemde, grup expectancy'sini küçülterek tahmin eder; olasılık/garanti değildir."""
    rows = {r.get("code"): r for r in ((learn or {}).get("groups_table") or [])}
    estimates, samples = [], []
    for code in (sig.get("grp_matched") or []):
        row = rows.get(code) or {}
        n = int(row.get("win", 0)) + int(row.get("loss", 0))
        if n < min_group_n:
            continue
        raw_exp = float(row.get("net_r", 0.0)) / max(1, n)
        weight = n / float(n + prior_n)
        estimates.append(raw_exp * weight)
        samples.append(n)
    if not estimates:
        return None, 0
    return round(sum(estimates) / len(estimates), 4), min(samples)


def evaluate_signal_for_tf(meta, tf, closed_map, live_price, btc_bias, learn, news=None, mode=None, diag=None):
    """A-F motoru; geçmiş performans sıralaması yalnız yeterli örneklemde etkinleşir."""
    mode = mode or STRATEGY_MODE
    if mode == "groups":
        sig = _evaluate_signal_groups(meta, tf, closed_map, live_price, btc_bias, learn, news=news, mode=mode, diag=diag)
    else:
        sig = _evaluate_signal_classic(meta, tf, closed_map, live_price, btc_bias, learn, news=news, mode=mode, diag=diag)
    if sig:
        exp_r, sample_n = _candidate_expected_net_r(sig, learn)
        sig["expected_net_r_est"] = exp_r
        sig["expected_net_r_sample"] = sample_n
        sig["expected_net_r_is_calibrated"] = exp_r is not None
    return sig


def _cand_priority(sig):
    """Potansiyel (% hareket / room_r) ve skora gore aday oncelik siralamasi."""
    return (
        float(sig.get("pot_pct") or 0.0),
        float(sig.get("room_r") or 0.0),
        int(sig.get("score", 0)),
        int(sig.get("confirmations", 0)),
    )


def evaluate_signal_all_tfs(meta, tf_closed_map, live_price, btc_bias_map, learn, news=None, mode=None, diag=None):
    """1H, 4H ve 1D'yi tarar; secim sirasi: eslesen grup sayisi > skor > potansiyel."""
    best_sig = None
    best_rank = None
    tf_order_idx = {t: i for i, t in enumerate(ALL_SCAN_TFS)}
    for tf_cand in ALL_SCAN_TFS:
        sig = evaluate_signal_for_tf(
            meta, tf_cand, tf_closed_map, live_price,
            btc_bias_map.get(BTC_REF_TF[tf_cand], "NEUTRAL"), learn, news=news, mode=mode, diag=diag,
        )
        if not sig:
            continue
        if sig.get("expected_net_r_est") is not None:
            rank = (1, float(sig["expected_net_r_est"]), int(sig.get("expected_net_r_sample", 0)),
                    len(sig.get("grp_matched") or []), int(sig.get("score", 0)), tf_order_idx.get(tf_cand, 0))
        else:
            rank = (0, len(sig.get("grp_matched") or []), int(sig.get("score", 0)),
                    float(sig.get("pot_pct") or 0.0), tf_order_idx.get(tf_cand, 0), 0)
        if best_rank is None or rank > best_rank:
            best_rank = rank
            best_sig = sig
    return best_sig


def reanchor_signal(sig, px):
    is_long = sig["side"] == "LONG"
    risk_old = abs(sig["entry"] - sig["sl"])
    risk_new = (px - sig["sl"]) if is_long else (sig["sl"] - px)
    atr_anchor = float(sig.get("atr_value") or 0.0)
    if atr_anchor > 0 and abs(float(px) - float(sig["entry"])) > MAX_CHASE_ATR * atr_anchor:
        return None
    if risk_old <= 0 or risk_new <= 0 or risk_new < 0.70 * risk_old or risk_new > 1.35 * risk_old:
        return None
    risk_pct = risk_new / px * 100.0
    if risk_pct > MAX_STOP_PCT.get(sig.get("tf", "4H"), 3.5):
        return None
    s = dict(sig)
    if s.get("funding_rate") is not None:
        hold_h = expire_candles_for_tf(s.get("tf", "4H")) * TF_SEC.get(s.get("tf", "4H"), 14400) / 3600.0 * 0.5
        interval_h = max(1.0, float(s.get("funding_interval_hours") or 8.0))
        rate = float(s.get("funding_rate") or 0.0)
        payer_rate = max(0.0, rate if is_long else -rate)
        funding_cost_pct = payer_rate * 100.0 * hold_h / interval_h
        total_cost_pct = ROUNDTRIP_COST_PCT + funding_cost_pct + float(s.get("spread_pct") or 0.0)
        s["funding_cost_pct"] = round(funding_cost_pct, 5)
    elif s.get("cost_pct_est") is not None:
        total_cost_pct = float(s.get("cost_pct_est"))
    else:
        total_cost_pct = roundtrip_cost_pct(s.get("tf", "4H"))
    cost_r = total_cost_pct / max(risk_pct, 1e-9)
    if cost_r > MAX_COST_R:
        return None
    s["entry"] = rp(px)
    s["sl_orig"] = s["sl"]
    sgn = 1.0 if is_long else -1.0
    for key, m in zip(("tp1", "tp2", "tp3"), TP_R):
        s[key] = rp(px + sgn * risk_new * m)
    s["risk_pct"] = round(risk_pct, 3)
    s["cost_r"] = round(cost_r, 3)
    s["cost_pct_est"] = round(total_cost_pct, 4)
    room_price = s.get("room_price")
    if room_price is not None:
        try:
            room_price = float(room_price)
            s["room_r"] = round(((room_price - px) if is_long else (px - room_price)) / risk_new, 2)
            s["pot_pct"] = round(min(abs(room_price - px) / max(px, 1e-12) * 100.0,
                                     abs(float(s["tp3"]) - px) / max(px, 1e-12) * 100.0), 2)
            if s["room_r"] <= 0:
                return None
        except (TypeError, ValueError, ZeroDivisionError):
            s["room_r"], s["pot_pct"] = None, None
    else:
        s["room_r"], s["pot_pct"] = None, None
    room_r_now = s.get("room_r")
    groups_now = set(s.get("grp_matched") or [])
    if room_r_now is None:
        return None
    if any(g in groups_now for g in ("B", "D", "F")):
        if room_r_now < G_MIN_ROOM_R or (s.get("pot_pct") is None or s["pot_pct"] < G_MIN_POT_PCT):
            return None
    elif room_r_now < G_BASE_ROOM_R:
        return None
    now_local = datetime.now()
    s["time"] = now_local.strftime("%H:%M:%S")
    s["date_time"] = now_local.strftime("%d.%m.%Y %H:%M:%S")
    s["created_ts_ms"] = now_ms()
    return s


# =====================================================================
#  ISLEM YONETIMI (TP1 %50 + BE STOP + KADEMELI CIKIS)
# =====================================================================
def _risk_abs(h):
    """Islemin ORIJINAL risk mesafesi (fiyat cinsinden). Stop BE'ye cekilse bile degismez."""
    try:
        entry = float(h["entry"])
        so = h.get("sl_orig")
        if so is not None:
            r = abs(entry - float(so))
            if r > 0:
                return r
        if int(h.get("stage", 0)) == 0:
            r = abs(entry - float(h["sl"]))
            if r > 0:
                return r
        rr1 = float(h.get("rr1", TP_R[0])) or TP_R[0]
        r = abs(float(h["tp1"]) - entry) / rr1
        if r > 0:
            return r
    except Exception:
        pass
    return 1e-12


def _move_r(h, px):
    entry = float(h["entry"])
    move = (px - entry) if h["side"] == "LONG" else (entry - px)
    return move / _risk_abs(h)


def _fracs():
    f1 = PARTIAL_AT_TP1
    f2 = PARTIAL_AT_TP2
    f3 = max(0.0, 1.0 - f1 - f2)
    return f1, f2, f3


def _calc_partial_pnl_r(h, leg_outcome, px=None):
    """3 kademeli cikis: TP1 %50 -> stop BE | TP2 %30 -> stop TP1 | TP3 %20. Maliyet (R) bir kez dusulur."""
    rr1 = float(h.get("rr1", TP_R[0]))
    rr2 = float(h.get("rr2", TP_R[1]))
    rr3 = float((h.get("rr_levels") or {}).get("tp3", TP_R[2]))
    cost = float(h.get("cost_r", 0.2))
    stage = int(h.get("stage", 0))
    f1, f2, f3 = _fracs()
    ref_px = px if px is not None else float(h["entry"])

    if stage == 0:
        r = -1.0 if leg_outcome == "SL" else _move_r(h, ref_px)
        return round(r - cost, 3)

    if stage == 1:
        base = f1 * rr1
        rem = 0.0 if leg_outcome == "BE" else (f2 + f3) * _move_r(h, ref_px)
        return round(base + rem - cost, 3)

    base = f1 * rr1 + f2 * rr2
    if leg_outcome == "TP3":
        rem = f3 * rr3
    elif leg_outcome == "TRAIL":
        rem = f3 * rr1
    else:
        rem = f3 * _move_r(h, ref_px)
    return round(base + rem - cost, 3)


def trade_pnl_r(h, outcome, px=None):
    return _calc_partial_pnl_r(h, outcome, px)


def _infer_exit_price(h, outcome, px=None):
    entry = float(h.get("entry") or 0.0)
    sl = float(h.get("sl") or entry)
    tp1 = float(h.get("tp1") or entry)
    tp2 = float(h.get("tp2") or entry)
    tp3 = float(h.get("tp3") or tp2 or entry)
    if outcome == "SL":
        return rp(sl)
    if outcome == "BE":
        return rp(entry)
    if outcome == "TRAIL":
        return rp(tp1)
    if outcome == "TP1":
        return rp(tp1)
    if outcome == "TP2":
        return rp(tp2)
    if outcome == "TP3":
        return rp(tp3)
    if px is not None and float(px) > 0:
        return rp(float(px))
    return rp(entry)


def finish_trade(h, outcome, px=None):
    h["pnl_r"] = trade_pnl_r(h, outcome, px)
    h["status"] = "WIN" if h["pnl_r"] > 0 else "LOSS"
    h["exit_reason"] = {
        "SL": "SL", "BE": "BE", "TRAIL": "TRAIL", "TP1": "TP1", "TP2": "TP2", "TP3": "TP3", "TIMEOUT": "TIMEOUT"
    }.get(outcome, outcome)
    h["exit_price"] = _infer_exit_price(h, outcome, px)
    now_local = datetime.now()
    h["closed_time"] = now_local.strftime("%d.%m.%Y %H:%M:%S")
    h["closed_ts_ms"] = now_ms()


def advance_trade(h, hi, lo):
    """Kademeli TP/SL. Aynı OHLC mumunda yeni aktive olan stop da görülürse muhafazakâr sonuç uygulanır."""
    is_long = h["side"] == "LONG"
    entry = float(h["entry"])
    tp1 = float(h["tp1"])
    tp2 = float(h.get("tp2") or tp1)
    tp3 = float(h.get("tp3") or tp2)
    rr1 = float(h.get("rr1", TP_R[0]))
    rr2 = float(h.get("rr2", TP_R[1]))
    f1, f2, _ = _fracs()
    hi, lo = float(hi), float(lo)

    def reached(level):
        return hi >= level if is_long else lo <= level

    def stopped(level):
        return lo <= level if is_long else hi >= level

    stage = int(h.get("stage", 0))
    if stage == 0:
        # İlk stop ile TP1 aynı mumda görülürse en kötü senaryo olan SL kabul edilir.
        if stopped(float(h["sl"])):
            finish_trade(h, "SL", float(h["sl"]))
            return h["status"]
        if not reached(tp1):
            return None
        h["stage"] = 1
        h["partial_frac"] = f1
        h["realized_r"] = round(f1 * rr1, 3)
        h["sl"] = rp(entry)
        # TP1 sonrasında BE seviyesi de aynı OHLC aralığındaysa kalan yarı BE'den kapatılır.
        if stopped(entry):
            finish_trade(h, "BE", entry)
            return h["status"]
        # Mum TP2'ye de ulaştıysa, BE stop görülmediği için sıradaki kademe de gerçekleşmiştir.
        if reached(tp2):
            h["stage"] = 2
            h["realized_r"] = round(f1 * rr1 + f2 * rr2, 3)
            h["sl"] = rp(tp1)
            # TP2 sonrası yeni stop aynı mumda görülüyorsa hedef sırasını varsayma; trail ile bitir.
            if stopped(tp1):
                finish_trade(h, "TRAIL", tp1)
                return h["status"]
            if reached(tp3):
                finish_trade(h, "TP3", tp3)
                return h["status"]
            return "PARTIAL_TP2"
        return "PARTIAL_TP1"

    if stage == 1:
        if stopped(entry):
            finish_trade(h, "BE", entry)
            return h["status"]
        if not reached(tp2):
            return None
        h["stage"] = 2
        h["realized_r"] = round(f1 * rr1 + f2 * rr2, 3)
        h["sl"] = rp(tp1)
        if stopped(tp1):
            finish_trade(h, "TRAIL", tp1)
            return h["status"]
        if reached(tp3):
            finish_trade(h, "TP3", tp3)
            return h["status"]
        return "PARTIAL_TP2"

    if stopped(tp1):
        finish_trade(h, "TRAIL", tp1)
        return h["status"]
    if reached(tp3):
        finish_trade(h, "TP3", tp3)
        return h["status"]
    return None


def check_timeout(h, px, now_m):
    tf_key = h.get("tf", "4H")
    exp_candles = expire_candles_for_tf(tf_key)
    exp_ms = exp_candles * TF_SEC.get(tf_key, 14400) * 1000
    if now_m - int(h.get("created_ts_ms", now_m)) >= exp_ms and px is not None:
        finish_trade(h, "TIMEOUT", px)
        return True
    return False


def catchup_resolve(h, candles):
    """Yalnızca bu işlem için daha önce işlenmemiş, sinyal sonrası kapanmış mumları oynatır."""
    tf = h.get("tf", "4H")
    tf_ms = TF_SEC.get(tf, 14400) * 1000
    candle_ts = int(h.get("candle_ts") or 0)
    created = int(h.get("created_ts_ms", 0) or 0)
    if not candle_ts:
        # Eski geçmiş kayıtları için en yakın tamamlanmış TF sınırından önceki mumu baz al.
        candle_ts = max(0, (created // max(tf_ms, 1)) * tf_ms - tf_ms)
    last_done = int(h.get("last_processed_candle_ts") or candle_ts)
    for c in sorted(candles, key=lambda x: int(x.get("ts", 0))):
        ts = int(c.get("ts", 0))
        if ts <= last_done or ts <= candle_ts or not c.get("closed", True):
            continue
        if h.get("status") != "BEKLIYOR":
            break
        advance_trade(h, c["high"], c["low"])
        h["last_processed_candle_ts"] = ts
        last_done = ts
    return h



def catchup_pending_unlocked():
    """Acik islemleri KENDI TF mumlariyla (ag cagrisi KILIT DISINDA) ilerletir. {id: islem_kopyasi} dondurur."""
    with LOCK:
        snaps = [dict(h) for h in STATE["history"] if h.get("status") == "BEKLIYOR"]
    out, cache = {}, {}
    for hc in snaps:
        sym = pair_to_swap(hc.get("symbol", ""))
        k = (sym, hc.get("tf"))
        if k not in cache:
            try:
                cache[k] = [c for c in get_candles_cached(sym, hc.get("tf", "4H")) if c.get("closed")]
            except Exception as e:
                log.debug("Catchup mumu alinamadi (%s %s): %s", sym, hc.get("tf"), e)
                cache[k] = []
        if cache[k]:
            before = int(hc.get("stage", 0))
            before_cursor = int(hc.get("last_processed_candle_ts", hc.get("candle_ts", 0)) or 0)
            catchup_resolve(hc, cache[k])
            if (hc.get("status") != "BEKLIYOR" or int(hc.get("stage", 0)) != before
                    or int(hc.get("last_processed_candle_ts", 0) or 0) != before_cursor):
                out[hc["id"]] = hc
    return out


