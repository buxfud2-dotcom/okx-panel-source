def fetch_and_analyze_one(sym, chart_tf, btc_bias_map, learn_snap, open24h, want_diag=False, market_snapshot=None):
    all_needed_tfs = list(dict.fromkeys([*ALL_SCAN_TFS, chart_tf]))
    closed_map = {}
    all_raw_map = {}
    for tf_x in all_needed_tfs:
        try:
            cs = get_candles_cached(sym, tf_x)
        except Exception as e:
            log.debug("Mum cekilemedi (%s %s): %s", sym, tf_x, e)
            continue
        if cs:
            all_raw_map[tf_x] = cs
            cl = [c for c in cs if c["closed"]]
            if len(cl) >= 60:
                closed_map[tf_x] = cl

    chart_all = all_raw_map.get(chart_tf) or []
    if not chart_all or not closed_map:
        return None

    ref_tf = chart_tf if chart_tf in all_raw_map else next(iter(all_raw_map))
    ref_all = all_raw_map[ref_tf]
    tf_ms = TF_SEC.get(ref_tf, 14400) * 1000
    if (now_ms() - ref_all[-1]["ts"]) > tf_ms * 8:
        return None

    meta = {"id": sym, "pair": swap_to_pair(sym), "provider": "OKX SWAP"}
    with LOCK:
        # Sinyal ve giriş doğrulaması için seçili görüntü fiyatı değil, yürütülebilir LAST fiyatı kullanılır.
        p_info = _crypto_active_price(sym, ref_all[-1]["close"])
        last_info = STATE["last_prices"].get(sym)
        last_age_ms = (max(0, now_ms() - int(last_info.get("ts_ms", 0))) if last_info else None)
        last_fresh = bool(last_info and last_info.get("price") and last_age_ms is not None
                          and last_age_ms <= PRICE_FRESHNESS_SEC * 1000.0)
        live_px = float(last_info["price"]) if last_fresh else None
    if not last_fresh or live_px is None or live_px <= 0:
        return None
    if open24h and open24h > 0:
        chg = (live_px - open24h) / open24h * 100.0
    else:
        prev_c = closed_map[ref_tf][-1]["close"] if ref_tf in closed_map else ref_all[-1]["close"]
        chg = ((live_px - prev_c) / prev_c * 100.0) if prev_c else 0.0

    diag = [] if want_diag else None
    market_snapshot = market_snapshot or {}
    try:
        market_vol = float(market_snapshot.get("vol_24h_usdt") or 0.0)
        market_spread = float(market_snapshot.get("spread_pct")) if market_snapshot.get("spread_pct") is not None else None
        market_age = max(0, now_ms() - int(market_snapshot.get("ts_ms") or 0))
    except (TypeError, ValueError):
        market_vol, market_spread, market_age = 0.0, None, 10**12
    market_eligible = (market_vol >= MIN_VOL_USDT_24H and market_spread is not None
                       and market_spread <= MAX_SPREAD_PCT
                       and market_age <= MAX_TICKER_AGE_SEC * 1000.0)
    if market_eligible:
        sig = evaluate_signal_all_tfs(meta, closed_map, live_px, btc_bias_map, learn_snap, diag=diag)
    else:
        sig = None
        _note(diag, chart_tf, None, "LIKIDITE_VERISI_YOK", int((closed_map.get(chart_tf) or [{}])[-1].get("ts", 0)),
              stage="hard", extra={"volume_24h_usdt": market_vol, "spread_pct": market_spread,
                                    "ticker_age_ms": market_age})
    if sig:
        info = _market_cost_info_cached(sym, live_px, sig.get("side", "LONG"), sig.get("tf", chart_tf))
        book_spread = info.get("spread_pct")
        ticker_spread = market_snapshot.get("spread_pct")
        effective_spread = book_spread if book_spread is not None else ticker_spread
        if effective_spread is not None and float(effective_spread) > MAX_SPREAD_PCT:
            if diag is not None:
                blocked_cand = dict(sig)
                blocked_cand["spread_pct"] = round(float(effective_spread), 5)
                diag.append({"tf": sig.get("tf"), "side": sig.get("side"), "name": "SPREAD",
                             "ts": int((closed_map.get(sig.get("tf")) or [{}])[-1].get("ts", 0)),
                             "stage": "setup", "blocks": ["SPREAD"], "cand": blocked_cand})
            sig = None
        else:
            tf_sig = sig.get("tf", chart_tf)
            hold_h = expire_candles_for_tf(tf_sig) * TF_SEC.get(tf_sig, 14400) / 3600.0 * 0.5
            if info.get("funding_cost_pct") is None:
                total_cost_pct = roundtrip_cost_pct(tf_sig)
                cost_source = "SABİT KOMİSYON/SLİPAJ + TAHMİNİ FUNDING"
            else:
                total_cost_pct = ROUNDTRIP_COST_PCT + float(info["funding_cost_pct"])
                cost_source = "SABİT KOMİSYON/SLİPAJ + COIN-BAZLI OKX FUNDING"
            if effective_spread is not None:
                total_cost_pct += float(effective_spread)
            risk_pct = float(sig.get("risk_pct") or 0.0)
            actual_cost_r = total_cost_pct / max(risk_pct, 1e-9)
            sig.update({
                "cost_r": round(actual_cost_r, 3),
                "cost_pct_est": round(total_cost_pct, 4),
                "cost_source": cost_source,
                "funding_rate": info.get("funding_rate"),
                "funding_interval_hours": info.get("funding_interval_hours"),
                "funding_cost_pct": round(float(info["funding_cost_pct"]), 5) if info.get("funding_cost_pct") is not None else None,
                "funding_source": info.get("funding_source"),
                "spread_pct": round(float(effective_spread), 5) if effective_spread is not None else None,
                "volume_24h_usdt": market_snapshot.get("vol_24h_usdt"),
                "book_depth_usdt": round(float(info["book_depth_usdt"]), 2) if info.get("book_depth_usdt") is not None else None,
                "book_depth_side": info.get("book_depth_side"),
                "book_source": info.get("book_source"),
            })
            if actual_cost_r > MAX_COST_R:
                if diag is not None:
                    blocked_cand = dict(sig)
                    diag.append({"tf": sig.get("tf"), "side": sig.get("side"), "name": "MALİYET_GERÇEK",
                                 "ts": int((closed_map.get(sig.get("tf")) or [{}])[-1].get("ts", 0)),
                                 "stage": "setup", "blocks": ["MALİYET_GERÇEK"], "cand": blocked_cand})
                sig = None
    return {
        "id": sym,
        "pair": meta["pair"],
        "provider": meta["provider"],
        "tf": chart_tf,
        "base_price": chart_all[-1]["close"],
        "open24h": open24h,
        "change_pct": round(chg, 2),
        "candles": chart_all[-160:],
        "signal": sig,
        "diag": diag,
        "price_source": "LAST (OKX SWAP)",
        "price_age_ms": last_age_ms,
        "price_fresh": True,
    }


