def _zones_overlap(a, b):
    return a[0] <= b[1] and b[0] <= a[1]


def detect_concepts(candles, atr):
    n = len(candles)
    highs, lows = find_swings(candles[-85:], left=2, right=2)

    bull_fvgs, bear_fvgs = [], []
    min_gap = atr * 0.10
    for i in range(max(2, n - 42), n):
        c1, c3 = candles[i - 2], candles[i]
        later = candles[i + 1:]
        if c3["low"] > c1["high"] and (c3["low"] - c1["high"]) >= min_gap:
            lo, hi = c1["high"], c3["low"]
            if not any(c["low"] <= lo for c in later):
                bull_fvgs.append((lo, hi, i))
        if c3["high"] < c1["low"] and (c1["low"] - c3["high"]) >= min_gap:
            lo, hi = c3["high"], c1["low"]
            if not any(c["high"] >= hi for c in later):
                bear_fvgs.append((lo, hi, i))

    bull_obs, bear_obs = [], []
    for i in range(max(11, n - 48), n - 2):
        p, n1, n2 = candles[i], candles[i + 1], candles[i + 2]
        later = candles[i + 3:]
        prior = candles[i - 10:i]
        prior_hi = max(c["high"] for c in prior)
        prior_lo = min(c["low"] for c in prior)
        if abs(n1["close"] - n1["open"]) < atr * 0.42:
            continue
        if p["close"] < p["open"] and n1["close"] > n1["open"] and max(n1["close"], n2["close"]) > prior_hi and n2["close"] > n1["open"]:
            lo, hi = p["low"], p["high"]
            if not any(c["close"] < lo for c in later):
                bull_obs.append((lo, hi, i + 2))
        if p["close"] > p["open"] and n1["close"] < n1["open"] and min(n1["close"], n2["close"]) < prior_lo and n2["close"] < n1["open"]:
            lo, hi = p["low"], p["high"]
            if not any(c["close"] > hi for c in later):
                bear_obs.append((lo, hi, i + 2))

    demand_z, supply_z = [], []
    for i in range(max(3, n - 65), n - 1):
        d = candles[i]
        d_body = abs(d["close"] - d["open"])
        if d_body < atr * 1.15:
            continue
        base = []
        j = i - 1
        while j >= 0 and len(base) < 3:
            b = candles[j]
            if (b["high"] - b["low"]) <= atr * 1.0 and abs(b["close"] - b["open"]) <= atr * 0.52:
                base.append(b)
                j -= 1
            else:
                break
        if not base:
            continue
        lo = min(b["low"] for b in base)
        hi = max(b["high"] for b in base)
        later = candles[i + 1:]
        if d["close"] > d["open"] and d["close"] > hi:
            if any(c["close"] < lo for c in later):
                continue
            if any(_zones_overlap((lo, hi), ob) for ob in bull_obs):
                continue
            demand_z.append((lo, hi, i))
        elif d["close"] < d["open"] and d["close"] < lo:
            if any(c["close"] > hi for c in later):
                continue
            if any(_zones_overlap((lo, hi), ob) for ob in bear_obs):
                continue
            supply_z.append((lo, hi, i))

    return {
        "bull_fvgs": bull_fvgs, "bear_fvgs": bear_fvgs,
        "bull_obs": bull_obs, "bear_obs": bear_obs,
        "demand_z": demand_z, "supply_z": supply_z,
        "swing_highs": [p for _, p in highs],
        "swing_lows": [p for _, p in lows],
    }


def detect_triggers(candles, atr, lookback=5):
    out = {k: False for k in ("sweep_low", "sweep_high", "bos_bull", "bos_bear",
                              "choch_bull", "choch_bear", "rej_bull", "rej_bear")}
    n = len(candles)
    if n < 40:
        return out
    hist = candles[:-lookback]
    highs, lows = find_swings(hist[-85:], 2, 2)
    last_sh = highs[-1][1] if highs else None
    prev_sh = highs[-2][1] if len(highs) >= 2 else None
    last_sl = lows[-1][1] if lows else None
    prev_sl = lows[-2][1] if len(lows) >= 2 else None
    struct_bear = bool(last_sh and prev_sh and last_sl and prev_sl and last_sh < prev_sh and last_sl < prev_sl)
    struct_bull = bool(last_sh and prev_sh and last_sl and prev_sl and last_sh > prev_sh and last_sl > prev_sl)

    for k in range(lookback):
        idx = n - lookback + k
        c = candles[idx]
        ref = candles[max(0, idx - 20):idx]
        if len(ref) < 10:
            continue
        lo_ref = min(x["low"] for x in ref)
        hi_ref = max(x["high"] for x in ref)
        if c["low"] < lo_ref and c["close"] > lo_ref and (lo_ref - c["low"]) >= atr * 0.10:
            out["sweep_low"] = True
        if c["high"] > hi_ref and c["close"] < hi_ref and (c["high"] - hi_ref) >= atr * 0.10:
            out["sweep_high"] = True
        if last_sh and c["close"] > last_sh:
            out["choch_bull" if struct_bear else "bos_bull"] = True
        if last_sl and c["close"] < last_sl:
            out["choch_bear" if struct_bull else "bos_bear"] = True

    c, p = candles[-1], candles[-2]
    body = abs(c["close"] - c["open"])
    rng = c["high"] - c["low"]
    lower = min(c["open"], c["close"]) - c["low"]
    upper = c["high"] - max(c["open"], c["close"])
    if rng >= atr * 0.40:
        if c["close"] > c["open"] and (lower >= 0.65 * body or (p["close"] < p["open"] and c["close"] > p["open"])):
            out["rej_bull"] = True
        if c["close"] < c["open"] and (upper >= 0.65 * body or (p["close"] > p["open"] and c["close"] < p["open"])):
            out["rej_bear"] = True
    return out


def _reaction_candle(candles, idx, is_long):
    """Objektif kapanmış mum tepki testi: fitil reddi veya engulfing."""
    if idx <= 0 or idx >= len(candles):
        return False
    c, p = candles[idx], candles[idx - 1]
    rng = max(float(c["high"]) - float(c["low"]), 1e-12)
    body = abs(float(c["close"]) - float(c["open"]))
    lower = min(c["open"], c["close"]) - c["low"]
    upper = c["high"] - max(c["open"], c["close"])
    if is_long:
        wick_reject = (c["close"] > c["open"] and lower >= max(body * 0.60, rng * 0.20)
                       and c["close"] >= c["low"] + rng * 0.65)
        engulf = (c["close"] > c["open"] and p["close"] < p["open"]
                  and c["open"] <= p["close"] and c["close"] >= p["open"])
        return bool(wick_reject or engulf)
    wick_reject = (c["close"] < c["open"] and upper >= max(body * 0.60, rng * 0.20)
                   and c["close"] <= c["low"] + rng * 0.35)
    engulf = (c["close"] < c["open"] and p["close"] > p["open"]
              and c["open"] >= p["close"] and c["close"] <= p["open"])
    return bool(wick_reject or engulf)


def _sweep_reclaim_confirm(candles, atr, is_long, max_confirm=G_A_CONFIRM_WINDOW):
    """A: likidite süpürmesi ardından farklı ve daha sonraki mumun sweep mumunu kırarak kapanması."""
    n = len(candles)
    if n < 25:
        return None
    first = max(20, n - max_confirm - 2)
    for i in range(n - 2, first - 1, -1):
        ref = candles[max(0, i - 20):i]
        if len(ref) < 15:
            continue
        sweep = candles[i]
        level = min(x["low"] for x in ref) if is_long else max(x["high"] for x in ref)
        swept = (sweep["low"] < level - 0.10 * atr and sweep["close"] > level) if is_long else (
            sweep["high"] > level + 0.10 * atr and sweep["close"] < level)
        if not swept:
            continue
        for j in range(i + 1, min(n, i + max_confirm + 1)):
            confirm = candles[j]
            ok = confirm["close"] > sweep["high"] if is_long else confirm["close"] < sweep["low"]
            if ok and j == n - 1:
                return {"sweep_idx": i, "confirm_idx": j, "level": level,
                        "sweep_ts": sweep["ts"], "confirm_ts": confirm["ts"]}
            if j == n - 1:
                break
    return None


def _equal_sweep_event(candles, atr, is_long):
    """E: EQH/EQL yalnızca süpürülüp seviye içine geri kapanır; breakout seçeneği yoktur."""
    n = len(candles)
    if n < 40:
        return None
    start = max(0, n - 90)
    highs, lows = find_swings(candles[start:n - 1], 2, 2)
    swings = lows if is_long else highs
    level_pair = None
    tol = 0.25 * atr
    for a in range(len(swings) - 1, 0, -1):
        for b in range(a - 1, max(-1, a - 6), -1):
            if abs(swings[a][1] - swings[b][1]) <= tol:
                level_pair = ((swings[a][1] + swings[b][1]) / 2.0, start + swings[a][0])
                break
        if level_pair:
            break
    if not level_pair:
        return None
    level, formed_idx = level_pair
    for i in range(n - 1, max(formed_idx + 1, n - 6) - 1, -1):
        c = candles[i]
        swept = (c["low"] < level - 0.05 * atr and c["close"] > level) if is_long else (
            c["high"] > level + 0.05 * atr and c["close"] < level)
        if swept:
            rv = _candle_rvol_at(candles, i, 20)
            if rv is not None and rv >= G_E_MIN_RVOL:
                return {"index": i, "level": level, "rvol": rv,
                        "ts": c["ts"], "label": "EQL süpürme" if is_long else "EQH süpürme"}
    return None


def _candle_rvol_at(candles, idx, lookback=20):
    """Tek mum RVol: ilgili mum hacmi / kendisinden önceki N kapanmış mumun ortalaması."""
    if idx < lookback or idx >= len(candles):
        return None
    vals = [max(0.0, float(c.get("vol", 0.0))) for c in candles[idx - lookback:idx]]
    avg = sum(vals) / len(vals) if vals else 0.0
    cur = max(0.0, float(candles[idx].get("vol", 0.0)))
    if avg <= 0.0:
        return None
    return cur / avg


def _strong_choch_event(candles, is_long, min_atr=G_CHOCH_ATR_MIN):
    """C: CHoCH mumunun gövdesi, CHoCH öncesi ATR14'ün en az min_atr katı olmalı."""
    if len(candles) < 50:
        return None
    idx = len(candles) - 1
    prior = candles[:idx]
    if len(prior) < 40:
        return None
    highs, lows = find_swings(prior[-85:], 2, 2)
    if len(highs) < 2 or len(lows) < 2:
        return None
    prev_sh, last_sh = highs[-2][1], highs[-1][1]
    prev_sl, last_sl = lows[-2][1], lows[-1][1]
    prior_bear = last_sh < prev_sh and last_sl < prev_sl
    prior_bull = last_sh > prev_sh and last_sl > prev_sl
    c = candles[idx]
    pre_atr = calc_atr(prior, 14)
    if pre_atr <= 0:
        return None
    body = abs(float(c["close"]) - float(c["open"]))
    if is_long and prior_bear and c["close"] > c["open"] and c["close"] > last_sh and body >= min_atr * pre_atr:
        return {"index": idx, "level": last_sh, "body_atr": body / pre_atr, "ts": c["ts"]}
    if (not is_long) and prior_bull and c["close"] < c["open"] and c["close"] < last_sl and body >= min_atr * pre_atr:
        return {"index": idx, "level": last_sl, "body_atr": body / pre_atr, "ts": c["ts"]}
    return None


def _bos_retest_reaction(candles, atr, is_long, bos_event):
    """B: BOS'tan sonra seviye/bölge retesti ve sonraki kapanmış mumda tepki."""
    if not bos_event or len(candles) < 3:
        return None
    level, bos_idx = bos_event
    last_idx = len(candles) - 1
    if bos_idx >= last_idx - 1 or not _reaction_candle(candles, last_idx, is_long):
        return None
    tol = 0.40 * atr
    for j in range(last_idx - 1, bos_idx, -1):
        c = candles[j]
        if is_long:
            touched = c["low"] <= level + tol * 0.6 and c["close"] >= level - tol * 0.25
            aligned = candles[-1]["close"] > level
        else:
            touched = c["high"] >= level - tol * 0.6 and c["close"] <= level + tol * 0.25
            aligned = candles[-1]["close"] < level
        if touched and aligned:
            return {"bos_idx": bos_idx, "retest_idx": j, "reaction_idx": last_idx,
                    "bos_ts": candles[bos_idx]["ts"], "retest_ts": c["ts"],
                    "reaction_ts": candles[-1]["ts"]}
    return None


def _impulse_pullback_reaction(candles, is_long, atr):
    """D: 5 mumluk yönlü itki + 3 mumluk daha düşük hacimli geri çekilme + son mum tepki."""
    if len(candles) < 12:
        return None
    reaction_idx = len(candles) - 1
    reaction = candles[reaction_idx]
    if not _reaction_candle(candles, reaction_idx, is_long):
        return None
    impulse = candles[-9:-4]
    pullback = candles[-4:-1]
    if len(impulse) != 5 or len(pullback) != 3:
        return None
    iv = sum(max(0.0, float(c.get("vol", 0.0))) for c in impulse) / len(impulse)
    pv = sum(max(0.0, float(c.get("vol", 0.0))) for c in pullback) / len(pullback)
    if iv <= 0 or pv >= iv:
        return None
    impulse_move = impulse[-1]["close"] - impulse[0]["open"] if is_long else impulse[0]["open"] - impulse[-1]["close"]
    pullback_move = pullback[0]["open"] - pullback[-1]["close"] if is_long else pullback[-1]["close"] - pullback[0]["open"]
    if impulse_move < 1.2 * atr or pullback_move <= 0 or pullback_move > 0.70 * impulse_move:
        return None
    if is_long and not (reaction["close"] > reaction["open"] and reaction["close"] >= pullback[-1]["high"] * 0.995):
        return None
    if (not is_long) and not (reaction["close"] < reaction["open"] and reaction["close"] <= pullback[-1]["low"] * 1.005):
        return None
    return {"impulse_avg_volume": iv, "pullback_avg_volume": pv,
            "impulse_start_ts": impulse[0]["ts"], "pullback_start_ts": pullback[0]["ts"],
            "reaction_ts": reaction["ts"]}


def _ob_fvg_first_test(candles, active_zones, is_long):
    """F: OB/FVG kesişiminde tek ilk ziyaret epizodu ve en geç 3 mum içinde tepki."""
    obs = [z for z in active_zones if z[0] == "Order Block"]
    fvgs = [z for z in active_zones if z[0] == "FVG"]
    n = len(candles)
    if not obs or not fvgs or n < 3 or not _reaction_candle(candles, n - 1, is_long):
        return None
    for ob in obs:
        for fvg in fvgs:
            lo, hi = max(ob[1], fvg[1]), min(ob[2], fvg[2])
            if lo >= hi:
                continue
            formed = max(int(ob[3] or 0), int(fvg[3] or 0))
            visits, inside, first_touch = 0, False, None
            for k in range(max(formed + 1, 1), n):
                c = candles[k]
                now_in = c["low"] <= hi and c["high"] >= lo
                if now_in and not inside:
                    visits += 1
                    if first_touch is None:
                        first_touch = k
                inside = now_in
            if first_touch is not None and visits == 1 and 0 < n - 1 - first_touch <= 3:
                return {"lo": lo, "hi": hi, "touch_idx": first_touch,
                        "touch_ts": candles[first_touch]["ts"],
                        "reaction_ts": candles[-1]["ts"], "visit_count": visits}
    return None


def _collect_zones(c_data, side):
    if side == "LONG":
        src = (("Order Block", c_data["bull_obs"]), ("FVG", c_data["bull_fvgs"]), ("Supply & Demand", c_data["demand_z"]))
    else:
        src = (("Order Block", c_data["bear_obs"]), ("FVG", c_data["bear_fvgs"]), ("Supply & Demand", c_data["supply_z"]))
    return [(g, z[0], z[1], (z[2] if len(z) > 2 else None)) for g, zs in src for z in zs]


def _active_zones(zones, closed, atr, live_price, side):
    last6 = closed[-6:]
    tol = atr * 0.40
    out = []
    for g, lo, hi, zidx in zones:
        if side == "LONG":
            touched = any(c["low"] <= hi + tol * 0.6 for c in last6)
            holds = closed[-1]["close"] >= lo - tol * 0.25 and min(c["close"] for c in last6[-3:]) >= lo - tol * 0.35
            near = (lo - tol * 0.85) <= live_price <= (hi + tol * 1.35)
        else:
            touched = any(c["high"] >= lo - tol * 0.6 for c in last6)
            holds = closed[-1]["close"] <= hi + tol * 0.25 and max(c["close"] for c in last6[-3:]) <= hi + tol * 0.35
            near = (lo - tol * 1.35) <= live_price <= (hi + tol * 0.85)
        if touched and holds and near:
            out.append((g, lo, hi, zidx))
    return out


def _z_overlap(z1, z2, tol):
    return z1[1] - tol <= z2[2] and z2[1] - tol <= z1[2]


def _zone_prior_visits(candles, lo, hi, idx, recent=6):
    """Bölge oluştuktan sonraki bütün ziyaret epizotlarını sayar; ardışık temaslar tek testtir."""
    if idx is None:
        return 0
    visits, inside = 0, False
    for k in range(max(0, int(idx) + 1), len(candles)):
        c = candles[k]
        now_in = c["low"] <= hi and c["high"] >= lo
        if now_in and not inside:
            visits += 1
        inside = now_in
    return visits


def _build_abcd_groups(ict_items, best_grp, adx, rsi, rv3, htf_full, react, room_r, cost_r, is_long):
    """Sadece ETIKET uretir. Mevcut sabitleri kullanir; skor/karar uzerinde etkisi yoktur."""
    out = {}
    a = [n.replace("ICT · ", "") for n, _ in ict_items]
    b = [g for g in ("FVG", "Order Block", "Supply & Demand") if g in best_grp]
    c = []
    if adx is not None and adx >= MIN_ADX:
        c.append(f"ADX {adx:.0f}")
    lo_r, hi_r = RSI_LONG if is_long else RSI_SHORT
    if lo_r <= rsi <= hi_r:
        c.append(f"RSI {rsi:.0f}")
    if (rv3 or 0.0) >= MIN_RVOL:
        c.append(f"RVol {(rv3 or 0.0):.2f}x")
    if htf_full:
        c.append("HTF")
    d = []
    if react:
        d.append("Tepki Mumu")
    if room_r is not None and room_r >= MIN_ROOM_R:
        d.append(f"Alan {room_r:.1f}R")
    elif room_r is None:
        d.append("Alan bilinmiyor")
    if cost_r <= MAX_COST_R:
        d.append("Maliyet OK")
    for code, items in (("A", a), ("B", b), ("C", c), ("D", d)):
        if items:
            out[code] = items
    return out


